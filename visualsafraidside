    local function shaft(x, h, w, col, life, delay, core)
        if not x.three then return end
        later(delay, function()
            local base = np({ Transparency = 1, Size = V3(0.2, 0.2, 0.2), CFrame = CF(x.G), Material = Enum.Material.SmoothPlastic })
            local top = np({ Transparency = 1, Size = V3(0.2, 0.2, 0.2), CFrame = CF(x.G + V3(0, 1, 0)), Material = Enum.Material.SmoothPlastic })
            local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
            a0.Parent, a1.Parent = base, top
            local layers = {}
            local function layer(wm, tr, c)
                local b = Instance.new("Beam")
                b.Name = TAG .. "kf"
                b.Attachment0, b.Attachment1 = a0, a1
                b.FaceCamera = true
                b.LightEmission = 1
                b.LightInfluence = 0
                b.Segments = 1
                b.Texture = TX("shaft")
                b.TextureMode = Enum.TextureMode.Stretch
                b.Color = ColorSequence.new(c)
                b.Transparency = NumberSequence.new(1)
                b.Parent = base
                layers[#layers + 1] = { b = b, wm = wm, tr = tr }
            end
            layer(1, 0.45, col)
            layer(0.45, 0.2, col:Lerp(WHITE, 0.55))
            if core ~= false then layer(0.16, 0.02, WHITE) end
            anim(life, function(u)
                local len = h * eo3(seg(u, 0, 0.2)) + 0.2
                local k = 1 - eio(seg(u, 0.22, 1))
                top.CFrame = CF(x.G + V3(0, len, 0))
                for _, l in ipairs(layers) do
                    l.b.Width0 = w * l.wm * k + 0.05
                    l.b.Width1 = w * l.wm * k * 0.35 + 0.02
                    local tr = mix(l.tr, 1, ei2(seg(u, 0.35, 1)))
                    l.b.Transparency = NumberSequence.new({ K(0, tr), K(0.8, mix(tr, 1, 0.6)), K(1, 1) })
                end
            end, function() kill(base); kill(top) end)
        end)
    end

    local function punch(x, amt, col)
        if cfg.killFlash == false or x.lite then return end
        local c = cam()
        if not c then return end
        local d = (c.CFrame.Position - x.P).Magnitude
        local k = clamp(1.15 - d / 80, 0, 1) * (amt or 1)
        if k < 0.08 then return end
        local bl = Instance.new("BloomEffect")
        bl.Name = TAG .. "kf"
        bl.Intensity, bl.Size, bl.Threshold = 0, 30, 0.8
        bl.Parent = Lighting
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = TAG .. "kf"
        cc.Parent = Lighting
        local tint = WHITE:Lerp(col or x.c, 0.45)
        anim(0.75, function(u)
            local e = (1 - eo3(seg(u, 0.04, 1))) * eo3(seg(u, 0, 0.04))
            bl.Intensity = 1.5 * k * e
            cc.Brightness = 0.12 * k * e
            cc.TintColor = WHITE:Lerp(tint, e * 0.8)
        end, function() kill(bl); kill(cc) end)
    end

    local function chunk(x, p0, col, sz, vel, o)
        local gy = x.G.Y + sz.Y * 0.5 + 0.05
        local piece = np({ Color = col, Transparency = o.tr or 0.04, Size = sz, CFrame = CF(p0), Material = o.mat or Enum.Material.Neon, Reflectance = o.refl or 0 }, o.wedge and "WedgePart" or "Part")
        local pos, v = p0, vel
        local ax, ay, az = rnd(-9, 9), rnd(-9, 9), rnd(-9, 9)
        local rx, ry, rz = rnd(0, 6.28), rnd(0, 6.28), rnd(0, 6.28)
        local g = o.grav or 30
        local life = rnd(o.life[1], o.life[2])
        anim(life, function(u, t, dt)
            v = V3(v.X, v.Y - g * dt, v.Z)
            pos = pos + v * dt
            if pos.Y < gy then
                pos = V3(pos.X, gy, pos.Z)
                v = V3(v.X * 0.55, -v.Y * 0.32, v.Z * 0.55)
                ax, ay, az = ax * 0.5, ay * 0.5, az * 0.5
            end
            rx, ry, rz = rx + ax * dt, ry + ay * dt, rz + az * dt
            piece.CFrame = CF(pos) * ANGc(rx, ry, rz)
            local s = 1 - 0.55 * ei2(seg(u, 0.5, 1))
            piece.Size = sz * s
            piece.Transparency = mix(o.tr or 0.04, 1, ei2(seg(u, 0.55, 1)))
        end, function() kill(piece) end)
    end

    local function chunks(x, n, o)
        if not x.solid then return end
        local S, P = x.S, x.P
        for i = 1, cnt(n) do
            local a = math.random() * 6.283
            local sp, vy = rnd(o.speed[1], o.speed[2]) * S, rnd(o.up[1], o.up[2]) * S
            local s = rnd(o.size[1], o.size[2]) * S
            chunk(x, P + V3(rnd(-1.2, 1.2), rnd(-1.8, 2.2), rnd(-1.2, 1.2)), o.cols[(i % #o.cols) + 1], V3(s, s * rnd(0.6, 1.8), s * rnd(0.6, 1.2)),
                V3(math.cos(a) * sp, vy, math.sin(a) * sp), { tr = o.tr, mat = o.mat, refl = o.refl, life = o.life, grav = o.grav, wedge = o.wedge and (i % 3 ~= 0) })
        end
    end

    local function voxels(x, per, o)
        if not x.solid or not x.char then return end
        local parts = bodyParts(x.char)
        local c0 = x.P
        local made = 0
        for _, d in ipairs(parts) do
            if made >= cnt(o.max or 34) then break end
            for _ = 1, per do
                local sz = d.Size
                local lp = d.CFrame * CF(rnd(-0.45, 0.45) * sz.X, rnd(-0.45, 0.45) * sz.Y, rnd(-0.45, 0.45) * sz.Z)
                local out = (lp.Position - c0)
                out = (out.Magnitude > 0.05) and out.Unit or V3(rnd(-1, 1), 0, rnd(-1, 1))
                local s = rnd(o.size[1], o.size[2]) * x.S
                local sp = rnd(o.speed[1], o.speed[2]) * x.S
                chunk(x, lp.Position, d.Color, V3(s, s, s), out * sp + V3(0, rnd(o.up[1], o.up[2]) * x.S, 0), { tr = 0, mat = o.mat or Enum.Material.SmoothPlastic, life = o.life, grav = o.grav, wedge = false })
                made = made + 1
            end
        end
    end

