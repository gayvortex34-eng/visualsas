local GL = { folder = nil, list = {}, sig = nil, acc = 0, master = 0, bulkParts = {}, bulkCfs = {} }

local function glyphColor()
    local h = cfg.glyphRainbow and rainbowHue() or cfg.glyphH
    return hsv(h, cfg.glyphS, 1)
end

local function glyphOrigin()
    local c = lp.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if r then return r.Position end
    local cm = cam()
    return cm and cm.CFrame.Position or Vector3.new()
