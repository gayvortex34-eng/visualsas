local function NR(a, b) return NumberRange.new(a, b or a) end
local function KE(t, v, e) return NumberSequenceKeypoint.new(t, v, e or 0) end
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local function cseq3(c0, c1, c2) return ColorSequence.new({ CK(0, c0), CK(0.5, c1), CK(1, c2) }) end
local function soft(peak, fin, fout)
    fin = fin or 0.12; fout = fout or 0.18
    return NS(K(0, 1), K(fin, peak), K(1 - fout, math.min(1, peak + 0.08)), K(1, 1))
end
