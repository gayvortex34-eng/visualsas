function OPT.step(dt)
    if dirty.opt then
        dirty.opt = false
        optSync()
        if not cfg.optAuto and Gov.tier ~= 0 then govApply(0) end
    end
    if dt < 0.5 then
        OPT.frames = OPT.frames + 1
        OPT.acc = OPT.acc + dt
    end
    OPT.age = OPT.age + dt
    if OPT.acc >= 0.5 then
        local f = OPT.frames / OPT.acc
        OPT.fps = OPT.fps * 0.55 + f * 0.45
        OPT.frames, OPT.acc = 0, 0
        if cfg.optAuto and OPT.age > 6 then
            local lowThr, okThr = cfg.optTarget * 0.92, cfg.optTarget * 0.99
            if OPT.fps < lowThr then
                OPT.low, OPT.high = OPT.low + 0.5, 0
            elseif OPT.fps >= okThr then
                OPT.high, OPT.low = OPT.high + 0.5, 0
            else
                OPT.low = 0
            end
            local now = os.clock()
            local maxTier = (OPT.fps < cfg.optTarget * 0.55) and 4 or 3
            if OPT.low >= 2.5 and Gov.tier < maxTier then
                OPT.low = 0
                if now - OPT.lastRaise < 20 then OPT.raiseWait = math.min(OPT.raiseWait * 2, 240) end
                govApply(Gov.tier + 1)
                if now - OPT.lastTierNote > 6 then
                    OPT.lastTierNote = now
                    notify(("Auto quality: tier %d (%.0f fps)"):format(Gov.tier, OPT.fps), 3)
                end
            elseif OPT.high >= OPT.raiseWait and Gov.tier > 0 then
                OPT.high = 0
                if now - OPT.lastRaise > 120 then OPT.raiseWait = 20 end
                OPT.lastRaise = now
                govApply(Gov.tier - 1)
            end
        end
    end
    if OPT.on.post and os.clock() > OPT.nextPost then
        OPT.nextPost = os.clock() + 2
        postScan(true)
    end
end

