    K.lathe(o, prof, D(12))
    g:add(o, alongX)
    return g
end

function B.orb(sides)
    local g = K.new()
    local prof = {}
    local n = D(sides or 12)
    for i = 0, n do
        local a = i / n * mpi
        prof[#prof + 1] = { msin(a) * 0.5, -mcos(a) * 0.5 }
    end
    K.lathe(g, prof, D((sides or 12) * 2))
    return g
end

function B.crystal(f, sides, flat)
    local g = K.new()
    sides = sides or 6
    local ring, base = {}, {}
    local x0 = -0.5 + f
    for k = 0, sides - 1 do
        local a = k / sides * TAU + (flat == 1 and 0.0 or 0)
        ring[k + 1] = { x0, mcos(a) * 0.5, msin(a) * 0.5 }
        base[k + 1] = { -0.5, mcos(a) * 0.46, msin(a) * 0.46 }
    end
    local pts = { { -0.5, 0, 0 }, { 0.5, 0, 0 } }
    for k = 1, sides do pts[#pts + 1] = ring[k] end
    local faces = {}
    if flat == 1 then
        for k = 1, sides do pts[#pts + 1] = base[k] end
        local bs = 2 + sides
        for k = 1, sides do
            local a, b = 2 + k, 2 + (k % sides) + 1
            faces[#faces + 1] = { 2, a, b }
            faces[#faces + 1] = { bs + k, bs + (k % sides) + 1, b, a }
        end
        local cap = {}
        for k = 1, sides do cap[k] = bs + k end
        faces[#faces + 1] = cap
    else
        for k = 1, sides do
            local a, b = 2 + k, 2 + (k % sides) + 1
            faces[#faces + 1] = { 1, a, b }
            faces[#faces + 1] = { 2, a, b }
        end
    end
    K.hull(g, pts, faces)
    return g
end

function B.blade(fuller, tipAt)
    local g = K.new()
    tipAt = tipAt or 0.7
    local ns = D(40)
    local function station(i)
        local x = i / ns
        local w, t
        local base = lerpn(1, 0.8, sstep(0.08, tipAt, x))
        if x < tipAt then
            w, t = base, lerpn(1, 0.85, x / tipAt)
        else
            local k = (x - tipAt) / (1 - tipAt)
            w = base * mmax(1 - k, 0) ^ 0.82
            t = lerpn(0.85, 0.08, k ^ 0.7)
        end
        if x < 0.05 then w = w * lerpn(0.84, 1, x / 0.05) end
        return x, w, t
    end
    local function section(i)
        local x, w, t = station(i)
        local d = (fuller or 0) * sstep(0.05, 0.13, x) * (1 - sstep(tipAt - 0.05, tipAt + 0.1, x))
        local gz = 0.5 - 0.15 * d
        local pts = {
            { 0.5, 0 }, { 0.2, 0.5 }, { 0.1, gz }, { -0.1, gz }, { -0.2, 0.5 }, { -0.5, 0 },
            { -0.2, -0.5 }, { -0.1, -gz }, { 0.1, -gz }, { 0.2, -0.5 },
        }
        for k = 1, #pts do pts[k] = { pts[k][1] * w, pts[k][2] * t } end
        return x, pts
    end
    local secs = {}
    for i = 0, ns do
        local x, pts = section(i)
        secs[i] = { x = x, pts = pts }
    end
    local np = #secs[0].pts
    for k = 1, np do
        local k2 = k % np + 1
        g:grid(1, ns, function(u, v)
            local sc = secs[mfloor(v * ns + 0.5)]
            local p = sc.pts[u < 0.5 and k or k2]
            return sc.x, p[1], p[2]
        end)
    end
    return g
end

function B.grip(ridges)
    local g = K.new()
    local prof = {}
    local n = D(40)
    for i = 0, n do
        local t = i / n
        local r = 0.40 + 0.06 * msin(t * (ridges or 7) * TAU) + 0.1 * (1 - sstep(0, 0.12, t)) + 0.1 * sstep(0.88, 1, t)
        prof[#prof + 1] = { r, t - 0.5 }
    end
    local o = K.new()
    K.lathe(o, prof, D(14))
    g:add(o, alongX)
    for _, e in ipairs({ { -0.5, -1 }, { 0.5, 1 } }) do
        local c = g:vtx(e[1], 0, 0)
        local first = g.n + 1
        local sides = D(14)
        for k = 0, sides - 1 do
            local a = k / sides * TAU
            g:vtx(e[1], mcos(a) * 0.5, msin(a) * 0.5)
        end
        for k = 0, sides - 1 do
            local a, b = first + k, first + (k + 1) % sides
            if e[2] > 0 then g:tri(c, a, b) else g:tri(c, b, a) end
        end
    end
    return g
end

function B.guardWing(fans)
    local g = K.new()
    fans = fans or 4
    local boss = B.orb(10)
    g:add(boss, function(x, y, z) return x * 0.2, y * 0.26, z * 0.26 end)
    for side = -1, 1, 2 do
        for i = 1, fans do
            local f = (i - 1) / (fans - 1)
            local len = lerpn(0.5, 0.3, f ^ 0.8)
            local wid = lerpn(0.2, 0.15, f)
            local a = lerpn(4, 66, f) * mpi / 180
            local sa, ca = msin(a), mcos(a)
            local fe = B.feather(0.07, 0.12, 1.05, 0.1, 0.35, 0)
            local zoff = (i - 1) * 0.022 * side
            g:add(fe, function(x, y, z)
                local l = (x + 0.5) * len
                return l * sa + y * wid * (-side * ca), side * l * ca + y * wid * sa, z * 0.07 + zoff
            end)
        end
    end
    return g
end

function B.guardBar()
    local g = K.new()
    local prof = {}
    local n = D(20)
    for i = 0, n do
        local t = i / n
        local r = 0.5 * (1 - (2 * t - 1) ^ 6) ^ 0.5 * (0.7 + 0.3 * (1 - mabs(2 * t - 1)))
        prof[#prof + 1] = { mmax(r, 0.0001), t - 0.5 }
    end
    local o = K.new()
    K.lathe(o, prof, D(10))
    g:add(o, function(x, y, z) return x * 0.3, y, z * 0.5 end)
    return g
end

function B.pathTube(d)
    local g = K.new()
    local path = K.spline(d.pts, d.seg or 6)
    local r0, r1, p, sw = d.r0, d.r1 or d.r0, d.p or 1, d.swell or 0
    K.tube(g, path, function(t) return (r0 + (r1 - r0) * t ^ p) * (1 + sw * msin(t * mpi)) end, D(d.sides or 8), d.caps ~= 0, d.caps ~= 0, d.ey or 1, d.up)
    return g
end

local function putOrb(g, x, y, z, r)
    g:add(B.orb(8), function(a, b, c) return x + a * r * 2, y + b * r * 2, z + c * r * 2 end)
end

local function bez(p, q, c, u)
    local a, b2, cc = (1 - u) * (1 - u), 2 * u * (1 - u), u * u
    return a * p[1] + b2 * c[1] + cc * q[1], a * p[2] + b2 * c[2] + cc * q[2], a * p[3] + b2 * c[3] + cc * q[3]
end
local function along(o, dx, dy, l, r, bendDir)
    local ln = msqrt(dx * dx + dy * dy) + 1e-9
    dx, dy = dx / ln, dy / ln
    local px, py = -dy, dx
    return function(x, y, z)
        local s = x + 0.5
        return o[1] + dx * s * l + px * y * r, o[2] + dy * s * l + py * y * r, o[3] + z * r
    end
end
function B.bat(d)
    local k = d.k or 1
    local function sc(p) return { p[1] * k, p[2] * k, (p[3] or 0) * k } end
    local E, W, Ba = sc(d.E), sc(d.W), sc(d.Ba)
    local tips = {}
    for i, p in ipairs(d.tips) do tips[i] = sc(p) end
    local n = #tips
    local O = { 0, 0, 0 }
    local zs = d.zs or 1
    local inset, sag = (d.inset or 0.5) * k, (d.sag or 0.16) * k * zs
    local bones, memA, memB, rim = K.new(), K.new(), K.new(), K.new()
    local rb = (d.rb or 0.085) * k
    local nu, nv = D(10), D(7)

    local bowv = {}
    for i, tp in ipairs(tips) do
        local dx, dy = tp[1] - W[1], tp[2] - W[2]
        local l = msqrt(dx * dx + dy * dy) + 1e-9
        local f = (d.bow or 0.07) * l
        bowv[i] = { -dy / l * f, dx / l * f, 0 }
    end
    local function fingerPt(i, s)
        local tp, bw = tips[i], bowv[i]
        local c = 4 * s * (1 - s)
        return W[1] + (tp[1] - W[1]) * s + bw[1] * c, W[2] + (tp[2] - W[2]) * s + bw[2] * c, W[3] + (tp[3] - W[3]) * s
    end

    bones:add(B.pathTube({ pts = { O, E, W }, r0 = (d.r0 or 0.15) * k, r1 = (d.r1 or 0.1) * k, p = 1, sides = 10, seg = 6, swell = 0.14, up = { 0, 0, 1 } }))
    putOrb(bones, E[1], E[2], E[3], 0.1 * k)
    putOrb(bones, W[1], W[2], W[3], 0.095 * k)
    putOrb(bones, 0, 0, 0, 0.12 * k)

    for i, tp in ipairs(tips) do
        local pts = {}
        for s = 0, 8 do local x, y, z = fingerPt(i, s / 8); pts[#pts + 1] = { x, y, z } end
        bones:add(B.pathTube({ pts = pts, r0 = rb, r1 = 0.024 * k, p = 0.85, sides = 8, seg = 1, up = { 0, 0, 1 } }))
        putOrb(rim, tp[1], tp[2], tp[3], 0.06 * k)
    end

    local function surface(edge, bwA, bwB, billow)
        return function(u, v)
            local ex, ey, ez = edge(u)
            local x, y, z = W[1] + (ex - W[1]) * v, W[2] + (ey - W[2]) * v, W[3] + (ez - W[3]) * v
            local c = 4 * v * (1 - v)
            x, y = x + (bwA[1] + (bwB[1] - bwA[1]) * u) * c, y + (bwA[2] + (bwB[2] - bwA[2]) * u) * c
            local bz = billow * msin(u * mpi) ^ 0.75 * sstep(0.0, 0.55, v)
            return x, y, z + bz
        end
    end
    local zero = { 0, 0, 0 }
    local function gap(p, q, bwA, bwB, target, rimOn)
        local mx, my, mz = (p[1] + q[1]) / 2, (p[2] + q[2]) / 2, (p[3] + q[3]) / 2
        local dx, dy, dz = W[1] - mx, W[2] - my, W[3] - mz
        local l = msqrt(dx * dx + dy * dy + dz * dz) + 1e-9
        local c = { mx + dx / l * inset * 2, my + dy / l * inset * 2, mz + dz / l * inset * 2 }
        local edge = function(u) return bez(p, q, c, u) end
        local fn = surface(edge, bwA, bwB, sag)
        target:grid(nu, nv, fn)
        if rimOn then
            local path = {}
            for s = 0, 14 do local x, y, z = fn(s / 14, 1); path[#path + 1] = { x, y, z } end
            rim:add(B.pathTube({ pts = path, r0 = 0.024 * k, r1 = 0.024 * k, sides = 6, seg = 1, caps = 0, up = { 0, 0, 1 } }))
        end
        if d.veins ~= false then
            for _, uu in ipairs({ 0.5 }) do
                local path = {}
                for s = 0, 8 do local x, y, z = fn(uu, 0.04 + 0.86 * s / 8); path[#path + 1] = { x, y, z + 0.012 * k * zs } end
                bones:add(B.pathTube({ pts = path, r0 = 0.018 * k, r1 = 0.008 * k, sides = 5, seg = 1, up = { 0, 0, 1 } }))
            end
        end
    end
    for i = 1, n - 1 do gap(tips[i], tips[i + 1], bowv[i], bowv[i + 1], (i % 2 == 1) and memA or memB, true) end
    gap(tips[n], Ba, bowv[n], zero, (n % 2 == 1) and memA or memB, true)
    memB:grid(D(6), nv, surface(function(u) return Ba[1] + (O[1] - Ba[1]) * u, Ba[2] + (O[2] - Ba[2]) * u, 0 end, zero, zero, 0.05 * k * zs))
    memB:grid(D(6), nv, surface(function(u) return O[1] + (E[1] - O[1]) * u, O[2] + (E[2] - O[2]) * u, 0 end, zero, zero, 0.04 * k * zs), false, true)
    return bones, memA, memB, rim
end

local function fanSurface(W, edge, bwA, bwB, billow, rip, lift)
    return function(u, v)
        local ex, ey, ez = edge(u)
        local x, y, z = W[1] + (ex - W[1]) * v, W[2] + (ey - W[2]) * v, W[3] + (ez - W[3]) * v
        local c = 4 * v * (1 - v)
        x, y = x + (bwA[1] + (bwB[1] - bwA[1]) * u) * c, y + (bwA[2] + (bwB[2] - bwA[2]) * u) * c
        local bz = billow * msin(u * mpi) ^ 0.75 * sstep(0.0, 0.55, v)
        local rz = (rip or 0) * msin(u * mpi) * sstep(0.12, 0.5, v) * msin(v * 9.5 + u * 4.2)
        return x, y, z + bz + rz + (lift or 0)
    end
end

function B.fan(d)
    local k = d.k or 1
    local zs = d.zs or 1
    local W = { 0, 0, 0 }
    local T, T2 = d.T, d.T2
    local bw, bw2 = d.bw or W, d.bw2 or W
    local inset, sag = (d.inset or 0.5) * k, (d.sag or 0.16) * k * zs
    local rb, rt = (d.rb or 0.085) * k, (d.rt or 0.024) * k
    local bones, mem = K.new(), K.new()
    local function fp(tp, bv, s)
        local c = 4 * s * (1 - s)
        return tp[1] * s + bv[1] * c, tp[2] * s + bv[2] * c, tp[3] * s
    end
    local pts = {}
    for s = 0, 8 do local x, y, z = fp(T, bw, s / 8); pts[#pts + 1] = { x, y, z } end
    bones:add(B.tubeGeo({ pts = pts, r0 = rb, r1 = rt, p = 0.85, sides = 8, seg = 1, up = { 0, 0, 1 }, swell = 0.08 }))
    putOrb(bones, 0, 0, 0, rb * 1.28)
    putOrb(bones, T[1], T[2], T[3], rt * 1.7)
    local mx, my, mz = (T[1] + T2[1]) / 2, (T[2] + T2[2]) / 2, (T[3] + T2[3]) / 2
    local l = msqrt(mx * mx + my * my + mz * mz) + 1e-9
    local c = { mx - mx / l * inset * 2, my - my / l * inset * 2, mz - mz / l * inset * 2 }
    local edge = function(u) return bez(T, T2, c, u) end
    local fn = fanSurface(W, edge, bw, bw2, sag, (d.rip or 0) * k * zs, (d.lift or 0) * zs)
    mem:grid(D(10), D(8), fn)
    if d.trim ~= false then
        local path = {}
        for s = 0, 16 do local x, y, z = fn(s / 16, 1); path[#path + 1] = { x, y, z } end
        bones:add(B.pathTube({ pts = path, r0 = 0.017 * k, r1 = 0.017 * k, sides = 5, seg = 1, caps = 0, up = { 0, 0, 1 } }))
    end
    if d.veins ~= false then
        for _, rb2 in ipairs({ { 0.5, 0.05, 0.92, 0.017 }, { 0.24, 0.3, 0.88, 0.011 }, { 0.76, 0.3, 0.88, 0.011 } }) do
            local path = {}
            for s = 0, 7 do local x, y, z = fn(rb2[1], rb2[2] + (rb2[3] - rb2[2]) * s / 7); path[#path + 1] = { x, y, z + 0.01 * k * zs } end
            bones:add(B.pathTube({ pts = path, r0 = rb2[4] * k, r1 = rb2[4] * k * 0.4, sides = 5, seg = 1, up = { 0, 0, 1 } }))
        end
    end
    return bones, mem
end

function B.batArm(d)
    local k = d.k or 1
    local zs = d.zs or 1
    local E, W, Ba = d.E, d.W, d.Ba
    local O = { 0, 0, 0 }
    local bones, mem = K.new(), K.new()
    local mid1 = { E[1] * 0.5, E[2] * 0.5, 0.06 * k * zs }
    local ez = { E[1], E[2], 0.12 * k * zs }
    local mid2 = { (E[1] + W[1]) / 2, (E[2] + W[2]) / 2, 0.07 * k * zs }
    bones:add(B.tubeGeo({ pts = { O, mid1, ez, mid2, { W[1], W[2], 0 } }, r0 = (d.r0 or 0.15) * k, r1 = (d.r1 or 0.1) * k, p = 1, sides = 10, seg = 4, swell = d.swell or 0.16,
        rn = d.rn or 0, ra = d.ra or 0, up = { 0, 0, 1 } }))
    putOrb(bones, ez[1], ez[2], ez[3], 0.125 * k)
    putOrb(bones, W[1], W[2], W[3], 0.115 * k)
    putOrb(bones, 0, 0, 0, 0.14 * k)
    local nv = D(7)
    local zero = { 0, 0, 0 }
    local sagb = (d.sagBody or 0.06) * k * zs
    local pa = fanSurface(W, function(u) return Ba[1] + (O[1] - Ba[1]) * u, Ba[2] + (O[2] - Ba[2]) * u, 0 end, zero, zero, sagb, d.rip and d.rip * k * zs, 0)
    mem:grid(D(8), nv, pa)
    local pb = fanSurface(W, function(u) return O[1] + (E[1] - O[1]) * u, O[2] + (E[2] - O[2]) * u, 0 end, zero, zero, 0.04 * k * zs, 0, 0)
    mem:grid(D(8), nv, pb, false, true)
    return bones, mem
end

function B.tubeGeo(d)
    local g = K.new()
    local path = K.spline(d.pts, mmax(2, D(d.seg or 6)))
    local r0, r1, p, sw = d.r0, d.r1 or d.r0, d.p or 1, d.swell or 0
    local rn, ra, tn, ta, tw = d.rn or 0, d.ra or 0, d.tn or 0, d.ta or 0, d.tw or 0
    local rf = function(t, a)
        local r = (r0 + (r1 - r0) * t ^ p) * (1 + sw * msin(t * mpi))
        if rn > 0 then r = r * (1 + ra * msin(t * rn * TAU)) end
        if tn > 0 then r = r * (1 + ta * msin(a * tn + tw * t * TAU)) end
        return r
    end
    K.tube(g, path, rf, D(d.sides or 10), d.caps ~= 0, d.caps ~= 0, d.ey or 1, d.up)
    return g
end

function B.cloth(folds, amp, hem, flare)
    local g = K.new()
    folds = folds or 3
    amp = amp or 0.06
    g:grid(mmax(6, D(folds * 8)), D(4), function(u, v)
        local z = amp * (0.5 - 0.5 * mcos(folds * TAU * u))
        local edge = 1 - (hem or 0) * sstep(0.7, 1, v) * (0.5 + 0.5 * mcos(folds * TAU * u))
        return (u - 0.5) * (1 + ((flare or 1) - 1) * v), -v * edge, z
    end)
    return g
end

function B.dome(h, e)
    local g = K.new()
    local prof = { { 0, 0 }, { 0.25, 0 } }
    local n = D(14)
    e = e or 1
    for i = 0, n do
        local ph = i / n * mpi / 2
        prof[#prof + 1] = { mmax(0.5 * mcos(ph) ^ e, 0.0001), h * msin(ph) }
    end
    K.lathe(g, prof, D(24))
    return g
end

function B.panel(d)
    local R = d.R or { 0, 0 }
    local pts = {}
    for i, q in ipairs(d.poly) do
        local a = q[1] * mpi / 180
        pts[i] = { R[1] + mcos(a) * q[2], R[2] + msin(a) * q[2], 0 }
    end
    local edge = K.spline(pts, mmax(2, D(d.seg or 7)))
    local m = #edge
    local zs = d.zs or 1
    local bulge = (d.bulge or 0.16) * zs
    local zf = d.zf or 1
    local lift = (d.lift or 0) * zs
    local function at(u, v)
        local E = edge[mfloor(u * (m - 1) + 0.5) + 1]
        local z = bulge * msin(v * zf * mpi) * (0.55 + 0.45 * msin(u * mpi)) + lift
        return R[1] + (E[1] - R[1]) * v, R[2] + (E[2] - R[2]) * v, z
    end
    local sheet, trim = K.new(), K.new()
    sheet:grid(m - 1, mmax(3, D(d.nv or 8)), at)
    local vr, rr = (d.vr or 0.03), (d.rr or 0.03)
    local nvn = d.veins or 4
    for k = 1, nvn do
        local u = k / (nvn + 1)
        local path = {}
        for s = 0, 6 do local x, y, z = at(u, 0.03 + 0.95 * s / 6); path[#path + 1] = { x, y, z + 0.012 * zs } end
        trim:add(B.pathTube({ pts = path, r0 = vr, r1 = vr * 0.35, sides = 5, seg = 1, up = { 0, 0, 1 } }))
    end
    if rr > 0 then
        local path = {}
        for i = 1, m do path[i] = { edge[i][1], edge[i][2], 0.004 * zs + lift } end
        trim:add(B.pathTube({ pts = path, r0 = rr, r1 = rr, sides = 5, seg = 1, caps = 0, up = { 0, 0, 1 } }))
    end
    return sheet, trim
end

function B.loop(d)
    local g = K.new()
    local hw, hd, h, t, n, e = d.hw, d.hd, d.h, d.t, d.n or 4, d.e or 0.5
    local pw = 2 / n
    g:grid(D(72), D(14), function(u, v)
        local th, ph = u * TAU, v * TAU
        local c, s = mcos(th), msin(th)
        local x, z = hw * spow(c, pw), hd * spow(s, pw)
        local nx, nz = spow(c, 2 - pw) / hw, spow(s, 2 - pw) / hd
        local l = msqrt(nx * nx + nz * nz) + 1e-9
        nx, nz = nx / l, nz / l
        local off = t / 2 * spow(mcos(ph), e)
        return x + nx * off, h / 2 * spow(msin(ph), e), -(z + nz * off)
    end, true)
    return g
end

local function layerFeather(g, f, zs, lod)
    local ox, oy, oz, ang, len, w = f[1], f[2], f[3], f[4] * mpi / 180, f[5], f[6]
    local bend, cup, pe, qe, skew = f[7] or 0.1, f[8] or 0.3, f[9] or 2.2, f[10] or 0.5, f[11] or 0.08
    local ca, sa = mcos(ang), msin(ang)
    local ns, nt = mmax(5, D(12 * (f[12] or lod or 1))), mmax(2, D(2))
    local function hw(s)
        local root = 0.14 + 0.86 * sstep(0, 0.5, s)
