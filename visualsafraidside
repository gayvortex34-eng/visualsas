local HAS_PACK = type(string.pack) == "function"

function K.pack(o, noPack)
    local n, nf = o.n, o.nf
    local parts = { "version 2.00\n" }
    local buf = {}
    local usePack = HAS_PACK and not noPack
    if usePack then
        local pk = string.pack
        parts[2] = pk("<I2BBI4I4", 12, 40, 12, n, nf / 3)
        local fmt = "<ffffffffbbbbBBBB"
        for i = 1, n do
            buf[i] = pk(fmt, o.x[i], o.y[i], o.z[i], o.nx[i], o.ny[i], o.nz[i], o.u[i], 1 - o.v[i], 127, 0, 0, 127, 255, 255, 255, 255)
        end
        parts[3] = table.concat(buf)
        local fb = {}
        local f = o.f
        for t = 1, nf, 3 do fb[#fb + 1] = pk("<I4I4I4", f[t] - 1, f[t + 1] - 1, f[t + 2] - 1) end
        parts[4] = table.concat(fb)
    else
        parts[2] = string.char(12, 0, 40, 12) .. u32(n) .. u32(nf / 3)
        for i = 1, n do
            buf[i] = f32(o.x[i]) .. f32(o.y[i]) .. f32(o.z[i]) .. f32(o.nx[i]) .. f32(o.ny[i]) .. f32(o.nz[i]) .. f32(o.u[i]) .. f32(1 - o.v[i])
                .. "\127\0\0\127\255\255\255\255"
        end
        parts[3] = table.concat(buf)
        local fb = {}
        local f = o.f
        for t = 1, nf, 3 do fb[#fb + 1] = u32(f[t] - 1) .. u32(f[t + 1] - 1) .. u32(f[t + 2] - 1) end
        parts[4] = table.concat(fb)
    end
    return table.concat(parts)
end
