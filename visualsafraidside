local function bflyWing(b, side, o)
    if not b.mesh then
        return panelWingOld(b, side, o)
    end
    local k = o.k or 1
    local root = H.wingRoot(b, side, 0.4, 0.28, o.sweep or 0.5, 6, H.flapAnim(o.amp or 0.34, o.spd or 2.4))
    for wi, wg in ipairs(o.wings) do
        local R = { wg.R[1] * k, wg.R[2] * k }
        local base = bflyPoly(wg.prof, wg.a0, wg.a1, wg.step or 4, wg.scal)
        local smooth = bflyPoly(wg.prof, wg.a0, wg.a1, 13)
        local function sc(poly, f) local out = {} for i, q in ipairs(poly) do out[i] = { q[1], q[2] * f * k } end return out end
        local zb = 0.05 * wi
        for li, ly in ipairs(o.layers) do
            local poly = (li == 1) and sc(base, 1) or sc(smooth, ly.f)
            H.panel(b, { of = root, cf = CF(0, 0, 0), R = R, side = side, poly = poly, bulge = (wg.bulge or 0.34) * k, zf = (li == 1) and 1 or ly.f, lift = zb + 0.018 * (li - 1),
                seg = (li == 1) and 3 or 6, nv = (li == 1) and 6 or 5,
                veins = (li == 1) and (wg.veins or 6) or 0, vr = (wg.vr or 0.034) * k, rr = (li == 1) and 0.05 * k or 0,
                col = wg.cols and wg.cols[li] or ly.col, mat = ly.mat or "s", tr = ly.tr, trim = o.vein or "k", trimMat = "m" })
        end
        local dots = wg.dots
        if dots then
            for di = 0, dots.n - 1 do
                local a = dots.a0 + (dots.a1 - dots.a0) * di / (dots.n - 1)
                local r = rprof(wg.prof, a) * dots.f * k
                local x, y = R[1] + cos(rad(a)) * r, R[2] + sin(rad(a)) * r
                local z = side * (0.34 * k * sin(PI * dots.f * 0.98) * 0.55 + 0.05 * wi + 0.05)
                H.orb(b, { of = root, cf = CF(x, y, z), d = dots.d * k * (1 - 0.35 * abs(di / (dots.n - 1) * 2 - 1)), dz = dots.d * k * 0.45, col = dots.col or "w", mat = "g" })
            end
        end
        for _, sp in ipairs(wg.eyes or {}) do
            local x, y = R[1] + sp[1] * k, R[2] + sp[2] * k
            local z0 = side * (0.2 * k + 0.05 * wi + 0.05)
            local rr = sp[3] * k
            for ei, c in ipairs(sp[4]) do
                H.orb(b, { of = root, cf = CF(x, y, z0 + side * 0.01 * ei * k), d = rr * (1 - 0.28 * (ei - 1)), dz = rr * 0.12, col = c, mat = (ei == 1) and "s" or "g" })
            end
        end
    end
    return root
end

