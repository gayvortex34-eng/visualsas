    return b.P({ at = o.at, of = o.of, cf = (o.cf or ID) * CF(0, (o.h or 0.3) * 0.25, 0), off = o.off, anim = o.anim, shape = "s", size = V3(o.d, (o.h or 0.3) * 1.2, o.d), col = o.col or "a", mat = o.mat or "m", tr = o.tr })
