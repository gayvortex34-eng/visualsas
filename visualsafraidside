do
    local function sweep(parent)
        if not parent then return end
        for _, o in ipairs(parent:GetChildren()) do
            if string.sub(o.Name, 1, #TAG) == TAG then pcall(function() o:Destroy() end) end
        end
    end
    sweep(Lighting); sweep(Terrain)
end

local function hsvCfg(h, s, v) return hsv(cfg[h], cfg[s], cfg[v]) end
local function parentFor(class)
    if class == "Clouds" then return Terrain or Workspace end
    return Lighting
end

local function claim(class, on)
    if on then
        if W.claimed[class] then return end
        W.claimed[class] = true
        W.stash[class] = {}
        for _, o in ipairs(parentFor(class):GetChildren()) do
            if o:IsA(class) and string.sub(o.Name, 1, #TAG) ~= TAG then
                W.stash[class][#W.stash[class] + 1] = { o, o.Parent }
                pcall(function() o.Parent = nil end)
            end
        end
    else
        if not W.claimed[class] then return end
        W.claimed[class] = nil
        for _, e in ipairs(W.stash[class] or {}) do pcall(function() e[1].Parent = e[2] end) end
        W.stash[class] = nil
    end
end

local function approachNum(cur, t, k)
    local d = t - cur
    if math.abs(d) <= math.max(0.0006, math.abs(t) * 0.0008) then return t, true end
    return cur + d * k, false
end
local function approachCol(cur, t, k)
    if math.abs(t.R - cur.R) + math.abs(t.G - cur.G) + math.abs(t.B - cur.B) < 0.004 then return t, true end
    return cur:Lerp(t, k), false
end
local function approachAny(cur, t, k)
    local ty = typeof(t)
    if ty == "number" then return approachNum(cur, t, k) end
    if ty == "Color3" then return approachCol(cur, t, k) end
    return t, true
end

local function rate()
    local s = cfg.smooth or 0.45
    return 3 / math.max(0.06, s)
end

