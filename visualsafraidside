        spire(1, q[1], q[2], w, w * 0.78, 0.35, 0, 0.84)
        core(q[1], q[2] * 0.72, w * 0.16, 0.5, 0)
    end
    local B2 = { { 75, 1.8 }, { 57, 2.8 }, { 40, 3.5 }, { 23, 3.8 }, { 6, 3.5 }, { -11, 2.9 }, { -28, 2.2 }, { -44, 1.5 } }
