AURAS["Winds"] = function(e, rec)
    local hrp = rec.hrp
    local n = 3
    local rs = {}
    for k = 1, n do
        local a0 = e.att(hrp, Vector3.new())
        local a1 = e.att(hrp, Vector3.new())
        e.tr(hrp, a0, a1, function()
            local g = A.g()
            local c1, c2 = auraPal("Winds")
            return {
                Texture = TX("ribbon"), TextureMode = Enum.TextureMode.Stretch, TextureLength = 1, Lifetime = 0.85,
                LightEmission = 1, LightInfluence = 0, FaceCamera = true, MinLength = 0.04,
                Transparency = NS(K(0, 1 - 0.9 * g), K(1, 1)), WidthScale = NS(K(0, 1), K(1, 0)),
                Color = seq2(c1, c2),
            }
        end)
        rs[k] = { a0 = a0, a1 = a1 }
    end
    e.upd[#e.upd + 1] = function(t)
        local s, sp = A.s(), A.sp()
        for k, r in ipairs(rs) do
            local ang = t * (2.2 + k * 0.5) * sp + k * 2.09
            local rad = 1.8 + s * 1.5
            local y = math.sin(t * 1.4 * sp + k * 1.7) * 1.7
            local p = Vector3.new(math.cos(ang) * rad, y, math.sin(ang) * rad)
            r.a0.Position = p
            r.a1.Position = p + Vector3.new(0, 0.55 + 0.25 * s, 0)
        end
    end
end

local AX = { ORI = { par = Enum.ParticleOrientation.VelocityParallel, up = Enum.ParticleOrientation.FacingCameraWorldUp } }

function AX.hs(key)
    local h, s
    if cfg.auraCustom then
        h, s = cfg.auraH, cfg.auraS
    else
        local d = AURA_PAL[key] or { 215, 0.5 }
        h, s = d[1], d[2]
    end
    if cfg.auraRainbow then h = rainbowHue() end
    return h, s
end

function AX.cs(key, pts)
    local h, s = AX.hs(key)
    if type(pts[1]) == "number" then return ColorSequence.new(hsv(h + pts[1], s * pts[2], pts[3])) end
    local n, list = #pts, {}
    for i, p in ipairs(pts) do
        if #p == 4 then
            list[i] = CK(p[1], hsv(h + p[2], s * p[3], p[4]))
        else
            list[i] = CK((i - 1) / (n - 1), hsv(h + p[1], s * p[2], p[3]))
        end
    end
    return ColorSequence.new(list)
end

function AX.nsq(list, m)
    if type(list) == "number" then return NumberSequence.new(list * m) end
    local k = {}
    for i = 1, #list, 2 do k[#k + 1] = K(list[i], list[i + 1] * m) end
    return NumberSequence.new(k)
end

function AX.tr(g, a, fi, fo)
    local T = 1 - clamp(g * a, 0, 0.98)
    fi = clamp(fi or 0.15, 0.02, 0.45)
    fo = clamp(fo or 0.7, fi + 0.05, 0.97)
    return NS(K(0, 1), K(fi, T), K(fo, T), K(1, 1))
end

function AX.spec(key, o)
    local s, g, rm, sp = A.s(), A.g(), A.rm(), A.sp()
    local l = o.l or 1.5
    local ls = type(l) == "table" and l or { l, l }
    local p = {
        Texture = TX(o.t), Lifetime = NumberRange.new(ls[1], ls[2]),
        Size = AX.nsq(o.z, (s ^ (o.se or 1)) * (o.zm or 1)),
        Transparency = AX.tr(g, o.a or 0.8, o.fi or (o.disc and 0.08 or nil), o.fo or (o.disc and 0.9 or nil)),
        Color = AX.cs(key, o.c), LightEmission = o.em or 1, LightInfluence = 0,
        SpreadAngle = Vector2.new(o.sa or 0, o.sa or 0), Drag = o.dr or 0, ZOffset = o.zo or 0,
        Acceleration = o.ac and Vector3.new(o.ac[1], o.ac[2], o.ac[3]) or Vector3.new(0, 0, 0),
    }
    p.Rate = o.disc and (1 / math.max(ls[2] - 0.8, 0.5)) or ((o.r or 1) * rm)
    if o.v == nil then
        p.Speed = o.flat and NumberRange.new(0.05, 0.05) or NumberRange.new(0, 0)
    else
        local va = type(o.v) == "table" and o.v or { o.v, o.v }
        p.Speed = NumberRange.new(va[1] * sp, va[2] * sp)
    end
    local rot = o.rot or ((o.flat or o.disc) and { 0, 0 } or { 0, 360 })
    p.Rotation = NumberRange.new(rot[1], rot[2])
    if o.rs then
        local ra = type(o.rs) == "table" and o.rs or { o.rs, o.rs }
        local lo, hi = ra[1] * sp, ra[2] * sp
        p.RotSpeed = NumberRange.new(math.min(lo, hi), math.max(lo, hi))
    end
    if o.ori then p.Orientation = AX.ORI[o.ori] end
    if o.lk then p.LockedToPart = true end
    if o.flat then flat(p) end
    return p
end

function AX.pe(e, att, key, o)
    local pe = e.pe(att, function() return AX.spec(key, o) end)
    if o.disc then pcall(function() pe:Emit(1) end) end
    return pe
end

function AX.at(e, rec, y, yf)
    local at = e.att(rec.hrp, Vector3.new(0, rec.feetY + y, 0))
    if yf then
        local function place()
            local yy = rec.feetY + yf(A.s())
            if at.Parent ~= rec.hrp then yy = yy - rec.feetY end
            at.Position = Vector3.new(0, yy, 0)
        end
        place()
        e.rf[#e.rf + 1] = place
    end
    return at
end

function AX.ring(e, rec, key, n, rad, y, tilt, o)
    local fy = rec.feetY
    local list = ringAtts(e, rec.hrp, n, function() return rad * A.s() end, function() return fy + y end, tilt)
    for _, it in ipairs(list) do AX.pe(e, it.at, key, o) end
    return list
end

function AX.orbit(e, rec, o)
    local fy = rec.feetY
    local a0 = e.att(rec.hrp, Vector3.new())
    local a1 = o.h and e.att(rec.hrp, Vector3.new()) or nil
    local function put(t)
        local s, sp = A.s(), A.sp()
        local ang = (o.ph or 0) + t * (o.w or 2) * sp
        local r = (o.r or 2) * s * (1 + (o.rb or 0) * math.sin(t * 1.3 * sp + (o.ph or 0) * 2))
        local y = fy + (o.y or 1) + (o.ya or 0) * math.sin(t * (o.yw or 1) * sp + (o.yp or 0))
        local pos = Vector3.new(math.cos(ang) * r, y, math.sin(ang) * r)
        a0.CFrame = CFrame.new(pos) * CFrame.Angles(0, -ang, 0) * CFrame.Angles(o.tg or 0, 0, -(o.out or 0))
        if a1 then a1.Position = pos + Vector3.new(0, o.h * (s ^ 0.5), 0) end
    end
    put(os.clock())
    e.upd[#e.upd + 1] = put
    return a0, a1
end

function AX.trail(e, rec, key, a0, a1, o)
    return e.tr(rec.hrp, a0, a1, function()
        local g = A.g()
        local ta, k = o.ta or { 0, 0.9, 1, 0 }, {}
        for i = 1, #ta, 2 do k[#k + 1] = K(ta[i], 1 - clamp(g * ta[i + 1], 0, 0.98)) end
        return {
            Texture = TX(o.t or "ribbon"), TextureMode = Enum.TextureMode.Stretch, TextureLength = 1, Lifetime = o.l or 1,
            LightEmission = o.em or 1, LightInfluence = 0, FaceCamera = true, MinLength = 0.04,
            Transparency = NumberSequence.new(k), WidthScale = AX.nsq(o.ws or { 0, 1, 1, 0 }, 1), Color = AX.cs(key, o.c),
        }
    end)
end

function AX.ctx(e, rec, key)
    local c = { n = 0 }
    c.gnd = AX.at(e, rec, 0.12)
    function c.P(at, o) return AX.pe(e, at, key, o) end
    function c.A(y, yf) return AX.at(e, rec, y, yf) end
    function c.R(n, rad, y, tilt, o) return AX.ring(e, rec, key, n, rad, y, tilt, o) end
    function c.O(oo, o)
        local a0, a1 = AX.orbit(e, rec, oo)
        if o then AX.pe(e, a0, key, o) end
        return a0, a1
    end
    function c.T(a0, a1, o) return AX.trail(e, rec, key, a0, a1, o) end
    function c.D(t, zm, a, col, rs, x, at)
        c.n = c.n + 1
        local o = { disc = true, flat = true, t = t, l = 6, z = 1, zm = zm, a = a, c = col, rs = rs, zo = 0.01 * c.n }
        if x then for k, v in pairs(x) do o[k] = v end end
        return AX.pe(e, at or c.gnd, key, o)
    end
    function c.W(t, z0, z1, r, l, a, col, x)
        local o = { flat = true, t = t, r = r, l = l, z = { 0, z0, 1, z1 }, a = a, c = col, fi = 0.06, fo = 0.3, zo = 0.2 }
        if x then for k, v in pairs(x) do o[k] = v end end
        return AX.pe(e, c.gnd, key, o)
    end
    return c
end

