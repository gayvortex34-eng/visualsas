    local function spire(g, ang, len, w, th, off, z, f)
        local a = rad(ang)
        local c = off + len / 2
        ops[#ops + 1] = { k = "crystal", g = g, f = f or 0.82, sides = 6, flat = 1, p = { cos(a) * c, sin(a) * c, z }, r = { 0, 0, ang }, s = { len, w, th } }
    end
    local function core(ang, len, w, off, z)
        local a = rad(ang)
        local c = off + len / 2
        ops[#ops + 1] = { k = "spindle", g = 2, pp = 1, q = 1, p = { cos(a) * c, sin(a) * c, z }, r = { 0, 0, ang }, s = { len, w, w } }
    end
