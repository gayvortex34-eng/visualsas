local BOLT_LAYER = {
    haze = { w = 3.4, col = 1 },
    glow = { w = 1.5, col = 2 },
    core = { w = 0.5, col = 3 },
}
local BOLT_STAGE = {
    [0] = { haze = 0.72, glow = 0.30, core = 0.00 },
    [1] = { haze = 0.86, glow = 0.52, core = 0.02 },
    [2] = { haze = 0.93, glow = 0.72, core = 0.25 },
    [3] = { haze = 0.98, glow = 0.88, core = 0.60 },
}

local function fractal(a, b, iters, amp)
    local pts = { a, b }
    for _ = 1, iters do
        local np = {}
        for i = 1, #pts - 1 do
            local p0, p1 = pts[i], pts[i + 1]
            local d = p1 - p0
            local mid = (p0 + p1) * 0.5
            if d.Magnitude > 0.01 then
                local f = d.Unit
                local ref = (math.abs(f.Y) > 0.95) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
                local r = f:Cross(ref).Unit
                local u = f:Cross(r)
                local ang = rnd(0, 6.2832)
                mid = mid + (r * math.cos(ang) + u * math.sin(ang)) * (amp * rnd(0.35, 1))
            end
            np[#np + 1] = p0
            np[#np + 1] = mid
        end
        np[#np + 1] = pts[#pts]
        pts = np
        amp = amp * 0.52
    end
    return pts
end

local function chainNew(e, par, nSeg, layers)
    local ch = { n = nSeg, layers = layers, atts = {}, beams = {}, stage = -1, shown = false, W = 0.3 }
    for k = 1, nSeg + 1 do ch.atts[k] = e.att(par, Vector3.new()) end
    for li = 1, #layers do
        ch.beams[li] = {}
        for k = 1, nSeg do
            local b = Instance.new("Beam")
            b.Name = TAG .. "bm"
            b.Attachment0, b.Attachment1 = ch.atts[k], ch.atts[k + 1]
            b.FaceCamera = true
            b.Segments = 1
            b.LightEmission = 1
            b.LightInfluence = 0
            b.Enabled = false
            b.Parent = par
            e.items[#e.items + 1] = b
            ch.beams[li][k] = b
        end
    end
    function ch.set(pts)
        for k = 1, nSeg + 1 do ch.atts[k].Position = pts[k] or pts[#pts] end
    end
    function ch.show(v)
        if ch.shown == v then return end
        ch.shown = v
        for li = 1, #layers do
            for k = 1, nSeg do ch.beams[li][k].Enabled = v end
        end
    end
    function ch.setStage(s)
        if ch.stage == s then return end
        ch.stage = s
        local S = BOLT_STAGE[s]
        for li, name in ipairs(layers) do
            local ns = NumberSequence.new(S[name])
            for k = 1, nSeg do ch.beams[li][k].Transparency = ns end
        end
    end
    function ch.paint(cols, W)
        ch.W = W
        for li, name in ipairs(layers) do
            local L = BOLT_LAYER[name]
            local cs = ColorSequence.new(cols[L.col])
            for k = 1, nSeg do
                local b = ch.beams[li][k]
                b.Color = cs
                b.Width0 = W * L.w * (1 - 0.65 * (k - 1) / nSeg)
                b.Width1 = W * L.w * (1 - 0.65 * k / nSeg)
            end
        end
    end
    return ch
end

