function FX.othersStatus()
    local s = { total = 0, inRange = 0, capped = 0, active = 0, acc = 0, aura = 0, tier = Gov.tier or 0, cap = Gov.othersMax or 40 }
    for _, rec in pairs(recs) do
        if not rec.isSelf then
            s.total = s.total + 1
            if rec.culled then
                if rec.cullWhy == "cap" then s.capped = s.capped + 1; s.inRange = s.inRange + 1 end
            else
                s.inRange = s.inRange + 1; s.active = s.active + 1
            end
            if rec.accSet then s.acc = s.acc + 1 end
            if rec.aura then s.aura = s.aura + 1 end
            if rec.accWhy == "part cap" and not rec.accSet and not rec.culled then s.partCap = (s.partCap or 0) + 1 end
        end
    end
    local rng = math.floor((tonumber(cfg.auraRange) or 300) + 0.5)
    if s.total == 0 then
        s.text = "Others: nobody else in this server"
    elseif s.inRange == 0 then
        s.text = ("Others: %d in the server, none within %d st - raise Range in the Aura tab"):format(s.total, rng)
    elseif s.capped > 0 then
        s.text = ("Others: %d in range, effects on the nearest %d (auto quality tier %d, turn it off in Optimize to lift the limit)"):format(s.inRange, s.active, s.tier)
    else
        s.text = ("Others: %d in range (%d st), effects on %d  |  accessories %d, auras %d"):format(s.inRange, rng, s.active, s.acc, s.aura)
    end
    if s.partCap then s.text = s.text .. ("  |  %d without accessories: part limit reached"):format(s.partCap) end
    return s
end

