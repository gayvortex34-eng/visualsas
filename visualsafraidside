local function rprof(tbl, a)
    local n = #tbl
    if a <= tbl[1][1] then return tbl[1][2] end
    for i = 1, n - 1 do
        local p, q = tbl[i], tbl[i + 1]
        if a <= q[1] then
            local t = (a - p[1]) / (q[1] - p[1])
            t = t * t * (3 - 2 * t)
            return p[2] + (q[2] - p[2]) * t
        end
    end
    return tbl[n][2]
end
local function bflyPoly(tbl, a0, a1, step, scal)
    local o = {}
    local n = math.max(2, math.floor((a1 - a0) / step + 0.5))
    for i = 0, n do
        local a = a0 + (a1 - a0) * i / n
        local r = rprof(tbl, a)
        if scal then
            local lobe = abs(sin(PI * (a - a0) / scal.period))
            r = r * (1 - scal.depth * (1 - lobe ^ 0.45))
        end
        o[#o + 1] = { a, r }
    end
    return o
end
local function panelWingOld(b, side, o)
    local k = o.k or 1
    local root = H.wingRoot(b, side, 0.4, 0.28, o.sweep or 0.5, 6, H.flapAnim(o.amp or 0.4, o.spd or 2.6))
    for i, pn in ipairs(o.panels) do
        local a = rad(pn.ang)
        local dir = V3(cos(a), sin(a), 0)
        local len, w = pn.len * k, pn.w * k
        local cfp = CF(dir * pn.off * k)
        H.feather(b, { of = root, cf = cfp, ang = a, len = len, w = w, t = 0.05, dz = side * 0.02 * i, col = pn.col, mat = pn.mat or "s", tr = pn.tr })
        if pn.inner then
            H.feather(b, { of = root, cf = cfp * CF(dir * len * 0.1), ang = a, len = len * 0.78, w = w * 0.68, t = 0.05, dz = side * (0.02 * i + 0.012), col = pn.inner, mat = pn.imat or "g", tr = pn.itr or 0.35 })
        end
        if o.veins then
            local tip = dir * (pn.off + len * 0.94) * k
            H.bone(b, { of = root, p0 = dir * pn.off * k, p1 = tip, th = 0.06 * k, col = o.vein or "d", mat = "m" })
            for _, vv in ipairs({ -0.28, 0.28 }) do
                H.bone(b, { of = root, p0 = dir * (pn.off + len * 0.25) * k, p1 = tip + V3(-dir.Y, dir.X, 0) * (vv * w), th = 0.035 * k, col = o.vein or "d", mat = "m" })
            end
        end
        for j, sp in ipairs(pn.spots or {}) do
            local pos = dir * (pn.off + len * sp[1]) * k + V3(-dir.Y, dir.X, 0) * sp[2] * w
            H.orb(b, { of = root, cf = CF(pos.X, pos.Y, side * (0.02 * i + 0.03)), d = sp[3] * k, dz = 0.06, col = sp[4] or "w", mat = "g" })
        end
    end
end

