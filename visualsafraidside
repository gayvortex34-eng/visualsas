local function horizSpeed(hrp)
    local v = hrp.AssemblyLinearVelocity
    return math.sqrt(v.X * v.X + v.Z * v.Z)
end

local FXn = { updAcc = 0, cullList = {} }

local function stepRec(rec, t, dt)
    local tr, au = rec.trail, rec.aura
    if tr and not tr.dead then
        local target
        if cfg.trailAlways or (rec.isSelf and t < testUntil) then
            target = 1
        else
            target = clamp(horizSpeed(rec.hrp) / 14, 0, 1.6)
        end
        rec.f = rec.f + (target - rec.f) * damp(9, dt)
        if math.abs(rec.f - rec.lastF) > 0.03 or (rec.f < 0.02 and rec.lastF ~= 0) then
            rec.lastF = rec.f < 0.02 and 0 or rec.f
            tr.setFactor(rec.lastF)
        end
    end
    if au and not au.dead then
        for _, f in ipairs(au.upd) do f(t, dt) end
    end
end

function FX.step(dt)
    local t = os.clock()
    if FX.animStep and #FX.anims > 0 then FX.animStep(dt) end
    if dirty.fx and t >= nextSync then
        dirty.fx = false
        nextSync = t + 0.1
        syncAll()
    end
    if testUntil > 0 and t > testUntil then
        testUntil = 0
        syncAll()
    end
    if t >= nextCull then
        nextCull = t + 0.5
        local c = cam()
        if c then
            local cp = c.CFrame.Position
            local range = tonumber(cfg.auraRange) or 300
            local list = FXn.cullList
            for i = #list, 1, -1 do list[i] = nil end
            for _, rec in pairs(recs) do
                if not rec.isSelf and rec.hrp and rec.hrp.Parent then
                    rec.dist = (rec.hrp.Position - cp).Magnitude
                    rec.rank = rec.dist - (rec.culled and 0 or 6)
                    list[#list + 1] = rec
                end
            end
            table.sort(list, function(a, b) return a.rank < b.rank end)
            local cap, n = math.max(1, Gov.othersMax or 40), 0
            for _, rec in ipairs(list) do
                local was = rec.culled
                local lim = was and (range - 10) or range
                if rec.dist > lim then
                    rec.culled, rec.cullWhy = true, "range"
                else
                    n = n + 1
                    if n > cap then rec.culled, rec.cullWhy = true, "cap" else rec.culled, rec.cullWhy = false, nil end
                end
                if was ~= rec.culled then pcall(syncRec, rec) end
            end
        end
    end
    if (cfg.auraRainbow or cfg.trailRainbow) and t >= nextColor then
        nextColor = t + 0.12
        for _, rec in pairs(recs) do
            if rec.aura and cfg.auraRainbow then rec.aura.refresh() end
            if rec.trail and cfg.trailRainbow then rec.trail.refresh() end
        end
    end
    FXn.updAcc = FXn.updAcc + dt
    local others = FXn.updAcc >= 0.066
    for _, rec in pairs(recs) do
        if rec.isSelf then
            stepRec(rec, t, dt)
        elseif others then
            stepRec(rec, t, FXn.updAcc)
        end
    end
    if others then FXn.updAcc = 0 end
end

