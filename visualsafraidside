local function setp(o, k, v) pcall(function() o[k] = v end) end
local function applyProps(o, p)
    for k, v in pairs(p) do
        local ok = pcall(function() o[k] = v end)
        if not ok then pcall(function() o[k] = o[k] end) end
    end
