    for _, p in ipairs(O) do cx, cy = cx + p[1], cy + p[2] end
    cx, cy = cx / n, cy / n
    local h = d.th / 2
    local b = d.bev or d.th * 0.35
    local bz = mmin(d.bevz or b * 0.8, h * 0.95)
    local dome = d.dome or 0
    local inner = {}
    for i, p in ipairs(O) do
        local dx, dy = p[1] - cx, p[2] - cy
        local l = msqrt(dx * dx + dy * dy) + 1e-9
        local k = mmax(l - b, 0.0) / l
        inner[i] = { cx + dx * k, cy + dy * k }
    end
    for _, side in ipairs({ 1, -1 }) do
        local c = g:vtx(cx, cy, side * (h + dome))
        local r1, r2 = {}, {}
        for i = 1, n do r1[i] = g:vtx(inner[i][1], inner[i][2], side * h) end
        for i = 1, n do r2[i] = g:vtx(O[i][1], O[i][2], side * (h - bz)) end
        for i = 1, n do
            local j = i % n + 1
