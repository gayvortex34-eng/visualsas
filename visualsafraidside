local function applyScene(sc)
    for i = 1, 4 do
        local e = sc[2][i]
        local pre = (i == 1) and "wx" or ("wx" .. i)
        W.setKey(pre .. "On", e ~= nil)
        if e then
            W.setKey(pre .. "Type", e[1]); W.setKey(pre .. "Rate", e[2]); W.setKey(pre .. "Size", e[3])
        end
    end
    mark("weather")
    notify("Particles: " .. sc[1], 2)
end
