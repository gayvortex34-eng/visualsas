local function glClear()
    if GL.folder then pcall(function() GL.folder:Destroy() end) end
    GL.folder, GL.list, GL.sig = nil, {}, nil
    GL.bulkParts, GL.bulkCfs = {}, {}
end

local function glRespawn(g, origin)
    local R = cfg.glyphRadius
    g.center = origin + Vector3.new(rnd(-R, R), rnd(12, R * 0.55 + 12), rnd(-R, R))
    local v = Vector3.new(rnd(-1, 1), rnd(-0.3, 0.3), rnd(-1, 1))
    if v.Magnitude < 0.2 then v = Vector3.new(1, 0, 0) end
    g.vel = v.Unit * rnd(0.4, 1)
    g.a = 0
    g.state = "in"
end

local function glEffCount()
    return math.max(0, math.floor(cfg.glyphCount * (Gov.glyphMul or 1) + 0.5))
end

local function glSig()
    return table.concat({ glEffCount(), tostring(cfg.glyphNodes) }, "|")
end

local function glBuild()
    glClear()
    local n = glEffCount()
    if n <= 0 then return end
    local folder = Instance.new("Folder")
    folder.Name = TAG .. "glyphs"
    folder.Parent = cam() or Workspace
    GL.folder = folder
    local origin = glyphOrigin()
    local col = glyphColor()
    for _ = 1, n do
        local g = { nodes = {}, beams = {}, ph = rnd(0, 6.28), lastA = -1 }
        glRespawn(g, origin)
        g.center = g.center
        local cnt = math.random(3, 6)
        local pos, prev = Vector3.new(), nil
        for _k = 1, cnt do
            pos = pos + Vector3.new(rnd(-9, 9), rnd(-6, 6), rnd(-9, 9))
            local p = Instance.new("Part")
            p.Name = TAG .. "n"
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(0.42, 0.42, 0.42)
            p.Material = Enum.Material.Neon
            p.Color = col
            p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
            p.Transparency = 1
            p.Parent = folder
            local at = Instance.new("Attachment")
            at.Parent = p
            local node = { part = p, off = pos, at = at }
            g.nodes[#g.nodes + 1] = node
            if prev then
                local bm = Instance.new("Beam")
                bm.Name = TAG .. "b"
                bm.Attachment0, bm.Attachment1 = prev.at, at
                bm.Width0, bm.Width1 = cfg.glyphThick, cfg.glyphThick
                bm.Segments = 1
                bm.FaceCamera = true
                bm.LightEmission = 1
                bm.LightInfluence = 0
                bm.Color = ColorSequence.new(col)
                bm.Transparency = NumberSequence.new(1)
                bm.Parent = folder
                g.beams[#g.beams + 1] = bm
            end
            prev = node
        end
        GL.list[#GL.list + 1] = g
    end
    GL.sig = glSig()
    GL.nodeCount = 0
    for _, g in ipairs(GL.list) do GL.nodeCount = GL.nodeCount + #g.nodes end
end

function GL.step(t, dt)
    local want = (cfg.glyphOn and (Gov.glyphMul or 1) > 0) and 1 or 0
    GL.master = GL.master + clamp(want - GL.master, -dt * 1.2, dt * 1.2)
    if want == 0 and GL.master <= 0 then
        if GL.folder then glClear() end
        return
    end
    if not GL.folder or GL.sig ~= glSig() then glBuild() end
    if not GL.folder then return end
    GL.acc = GL.acc + dt
    if GL.acc < 0.033 then return end
    local d = GL.acc
    GL.acc = 0
    local origin = glyphOrigin()
    local R = cfg.glyphRadius
    local spd = cfg.glyphSpeed / 50
    local rb = cfg.glyphRainbow
    local col = glyphColor()
    local thick = cfg.glyphThick
    local nodesOn = cfg.glyphNodes
    local parts, cfs, n = GL.bulkParts, GL.bulkCfs, 0
    for _, g in ipairs(GL.list) do
        g.center = g.center + g.vel * d * spd * 3
        if g.state == "in" then
            g.a = g.a + d * 0.6
            if g.a >= 1 then g.a = 1; g.state = "live" end
        elseif g.state == "out" then
            g.a = g.a - d * 0.9
            if g.a <= 0 then glRespawn(g, origin) end
        elseif (g.center - origin).Magnitude > R * 1.5 then
            g.state = "out"
        end
        for idx, nd in ipairs(g.nodes) do
            n = n + 1
            parts[n] = nd.part
            cfs[n] = CFrame.new(g.center + nd.off + Vector3.new(math.sin(t * 0.6 + idx + g.ph) * 0.8, math.cos(t * 0.5 + idx) * 0.6, 0))
        end
        local a = g.a * GL.master
        if math.abs(a - g.lastA) > 0.015 or rb then
            g.lastA = a
            local bt = NumberSequence.new(1 - 0.9 * a)
            local seq = ColorSequence.new(col)
            for _, bm in ipairs(g.beams) do
                bm.Transparency = bt
                bm.Width0, bm.Width1 = thick, thick
                bm.Color = seq
            end
            for _, nd in ipairs(g.nodes) do
                nd.part.Transparency = nodesOn and (1 - a) or 1
                nd.part.Color = col
            end
        end
    end
    for k = n + 1, #parts do parts[k] = nil; cfs[k] = nil end
    local ok = pcall(function() Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged) end)
    if not ok then
        for k = 1, n do pcall(function() parts[k].CFrame = cfs[k] end) end
    end
end

