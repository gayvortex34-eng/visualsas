                pcall(function() b.bm.Transparency = NumberSequence.new(b.base + (1 - b.base) * (step / 4)) end)
            end
            task.wait(math.max(0.03, life * 0.15))
            if dead then liveBolts[h] = nil return end
        end
        kill()
        liveBolts[h] = nil
    end)
    return h
end

