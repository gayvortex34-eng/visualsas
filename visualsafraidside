local function keyDown(name)
    if type(name) ~= "string" or name == "" then return false end
    if UIS:GetFocusedTextBox() then return false end
    local ok, kc = pcall(function() return Enum.KeyCode[name] end)
    if not ok or not kc then return false end
    local ok2, d = pcall(UIS.IsKeyDown, UIS, kc)
    return ok2 and d == true
end

local function flat(v)
    local f = V3(v.X, 0, v.Z)
    if f.Magnitude < 1e-3 then return nil end
    return f.Unit
end

local function grounded()
    local h = S.hum
    return h ~= nil and h.FloorMaterial ~= Enum.Material.Air
end

local function jumpHeld()
    return keyDown("Space") or (S.hum ~= nil and S.hum.Jump == true)
end

local function cast(origin, dir)
    local filt = { S.char }
    if S.plat.part then filt[#filt + 1] = S.plat.part end
    rp.FilterDescendantsInstances = filt
    local res = Workspace:Raycast(origin, dir, rp)
    if res and res.Instance and res.Instance.CanCollide == false then return nil end
    return res
end

local function cfgNum(k, d)
    local v = tonumber(cfg[k])
    if v == nil then return d end
