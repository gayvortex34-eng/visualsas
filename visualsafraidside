MISC.DH = (function()
local M = {}
local RepStorage = svc("ReplicatedStorage")
local V2 = Vector2.new

local DH = {
    placeId = 2788229376,
    gunModule = { "Modules", "GunHandler" },
    shootField = "shoot",
    chars = "Players",
    ignore = { "Bush", "Ignored", "Vehicles" },
    koFolder = "BodyEffects", koValue = "K.O",
}
M.DH = DH

local alive = true
local S = { hook = false, why = "off", G = nil, tried = -100, shots = 0, hits = 0, lastHit = -10, part = nil, char = nil, nextPick = 0, rising = false, errT = {} }
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true
local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled and not UIS.MouseEnabled

local function warnOnce(tag, e)
    local now = os.clock()
    if not S.errT[tag] or now - S.errT[tag] > 10 then S.errT[tag] = now; report("dahood " .. tag, e) end
end

local function isVisible(part, origin)
    local char = lp.Character
    if not (char and part and part.Parent) then return false, nil end
    local filt = { char }
    for _, n in ipairs(DH.ignore) do
        local f = Workspace:FindFirstChild(n)
        if f then filt[#filt + 1] = f end
    end
    rp.FilterDescendantsInstances = filt
    local res = Workspace:Raycast(origin, part.Position - origin, rp)
    if not res then return true, nil end
    if res.Instance:IsDescendantOf(part.Parent) then return true, res.Instance end
    return false, res.Instance
end

local R15_PARTS = { "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg" }
local R6_PARTS = { "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

local function rootOf(char) return char.PrimaryPart or char:FindFirstChild("HumanoidRootPart") end

local function basePart(char)
    local mode = cfg.dhPart
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if mode == "Torso" then return torso or head or char.PrimaryPart end
    return head or char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")
end

local function aimPoint()
    local c = cam()
    local mode = cfg.dhFollow
    if c and (mode == "Center" or (mode ~= "Mouse" and isMobile)) then return V2(c.ViewportSize.X / 2, c.ViewportSize.Y / 2) end
    return UIS:GetMouseLocation()
end

local function skipChar(char)
    if char == lp.Character or not char:IsA("Model") then return true end
    if cfg.dhKo ~= false then
        local be = char:FindFirstChild(DH.koFolder)
        local ko = be and be:FindFirstChild(DH.koValue)
        if ko and ko.Value == true then return true end
    end
    if cfg.dhFf ~= false and char:FindFirstChildOfClass("ForceField") then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    return false
end

local function getTarget(origin)
    local c = cam()
    local folder = Workspace:FindFirstChild(DH.chars)
    if not (c and folder) then return nil end
    local ap = aimPoint()
    local best, bestD, bestChar, bestPos = nil, clamp(tonumber(cfg.dhFov) or 300, 10, 1500), nil, nil
    local wall = cfg.dhWall ~= false
    for _, char in ipairs(folder:GetChildren()) do
        if not skipChar(char) then
            local tPart = basePart(char)
            if tPart then
                local pos, on = c:WorldToViewportPoint(tPart.Position)
                if on then
                    local d = (V2(pos.X, pos.Y) - ap).Magnitude
                    local part
                    if cfg.dhPart == "Nearest" then
                        local list = {}
                        local names = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS
                        local cand = { tPart }
                        for _, n in ipairs(names) do local p = char:FindFirstChild(n); if p then cand[#cand + 1] = p end end
                        local head = char:FindFirstChild("Head")
                        if head and head ~= tPart then cand[#cand + 1] = head end
                        for _, p in ipairs(cand) do
                            local pp, pon = c:WorldToViewportPoint(p.Position)
                            if pon then list[#list + 1] = { p = p, d = (V2(pp.X, pp.Y) - ap).Magnitude } end
                        end
                        table.sort(list, function(a, b) return a.d < b.d end)
                        for i = 1, math.min(#list, 3) do
                            if list[i].d < bestD then
                                local v, hit = true, nil
                                if wall then v, hit = isVisible(list[i].p, origin) end
                                if v then part, d = hit or list[i].p, list[i].d; break end
                            end
                        end
                    elseif d < bestD then
                        local v, hit = true, nil
                        if wall then
                            v, hit = isVisible(tPart, origin)
                            if not v then
                                local r = rootOf(char)
                                if r then v, hit = isVisible(r, origin) end
                            end
                        end
                        if v then part = hit or tPart end
                    end
                    if part and d < bestD then best, bestD, bestChar, bestPos = part, d, char, pos end
                end
            end
        end
    end
    if best then bestPos = c:WorldToViewportPoint(best.Position) end
    return best, bestChar, bestD, bestPos
end
M.getTarget = getTarget

local function onShoot(old, args)
    if not (alive and cfg.dhOn) or type(args) ~= "table" then return old(args) end
    local ok, did, pos, part = pcall(function()
        if rawget(args, "Shooter") ~= lp.Character then return false end
        local muzzle = rawget(args, "Muzzle")
        local origin = rawget(args, "ForcedOrigin") or (muzzle and muzzle.WorldPosition)
        if typeof(origin) ~= "Vector3" then return false end
        S.shots = S.shots + 1
        local chance = clamp(tonumber(cfg.dhChance) or 100, 1, 100)
        if chance < 100 and math.random() * 100 >= chance then return false end
        local tp, tc = getTarget(origin)
        if not tp then return false end
        args["AimPosition"] = tp.Position
        args["Hit"] = tp
        S.hits = S.hits + 1
        S.lastHit = os.clock()
        S.hitPart, S.hitChar = tp, tc
        task.spawn(old, args)
        return true, tp.Position, tp
    end)
    if ok and did then return pos, part, Vector3.new(0, 1, 0) end
    if not ok then warnOnce("shoot", did) end
    return old(args)
end

local function install()
    if S.hook then return true end
    local now = os.clock()
    if now - S.tried < 3 then return false end
    S.tried = now
    if not (hookfunction and require) then S.why = "executor has no hookfunction / require"; return false end
    local node = RepStorage
    for _, n in ipairs(DH.gunModule) do node = node and node:FindFirstChild(n) end
    if not node then S.why = "ReplicatedStorage.Modules.GunHandler not found (this is not Da Hood, or the game changed)"; return false end
    local okr, GH = pcall(require, node)
    if not okr or type(GH) ~= "table" then S.why = "could not require GunHandler: " .. tostring(GH); return false end
    local fn = rawget(GH, DH.shootField)
    if type(fn) ~= "function" then S.why = "GunHandler." .. DH.shootField .. " is not a function"; return false end
    local G = genv.AS_DHHK
    if not (G and G.fn == fn) then
        G = { fn = fn }
        local cc = newcclosure or function(f) return f end
        local cf = clonefunction or function(f) return f end
        local okh, oldf = pcall(hookfunction, fn, cc(function(args)
            local h = G.handler
            if h then return h(G.old, args) end
            return G.old(args)
        end))
        if not okh or type(oldf) ~= "function" then S.why = "hookfunction failed: " .. tostring(oldf); return false end
        G.old = cf(oldf)
        genv.AS_DHHK = G
    end
    G.handler = onShoot
    S.G, S.hook, S.why = G, true, "hooked"
    return true
end

function M.status()
    if not cfg.dhOn then return "Silent aim is off." end
    if not S.hook then return "Not active: " .. S.why end
    local tgt = S.char and S.char.Parent and S.char.Name or "-"
    return ("Hooked. Target: %s. Shots redirected: %d / %d"):format(tgt, S.hits, S.shots)
end

local V = { gui = nil, a = 0, size = 0, lock = 0 }

local function mkF(class, props, parent)
