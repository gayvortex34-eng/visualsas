local run
function UIX.inkSpread(pal, onCovered, drop)
    if run then run.blob.destroy(); run = nil end
    local sc = UIX.curScale()
    local W_, H_ = shell.Size.X.Offset, shell.Size.Y.Offset
    local ox, oy = W_ / 2, H_ / 2
    local o = UIX.inkOrigin
    if o and os.clock() - o.t < 2.5 then
        local a = shell.AbsolutePosition
        local lx, ly = (o.x - a.X) / sc, (o.y - a.Y) / sc
        if lx == lx and ly == ly then ox, oy = clamp(lx, 0, W_), clamp(ly, 0, H_) end
    end
    UIX.inkOrigin = nil
    local blob = UIX.inkNew({ W = W_, H = H_, ox = ox, oy = oy, pal = pal, fall = clamp(oy + 70, 110, 240), drop = drop })
    run = { blob = blob, t = 0, dur = 1.25 * (1 - blob.u0) / math.max(UIX.speed or 1, 0.4), swap = onCovered, swapped = false, at = blob.at(0.7) }
end
function UIX.inkStep(dt)
    local r = run
    if not r then return end
    r.t = r.t + dt
    local u = clamp(r.t / r.dur, 0, 1)
    r.blob.eval(u)
    if not r.swapped and u >= r.at then
        r.swapped = true
        local ok, e = pcall(r.swap)
        if not ok then report("ink-swap", e) end
    end
    if u >= 1 then
        r.blob.destroy()
        run = nil
    end
end
function UIX.inkBusy() return run ~= nil end
