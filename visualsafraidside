local function newE(sig)
    local e = { sig = sig, items = {}, pes = {}, trs = {}, upd = {}, rf = {}, factor = 1, dead = false }
    function e.add(i) e.items[#e.items + 1] = i; return i end
    function e.att(parent, pos, cf)
        local a = Instance.new("Attachment")
        a.Name = TAG .. "at"
        if cf then a.CFrame = cf else a.Position = pos or Vector3.new() end
        a.Parent = parent
        e.items[#e.items + 1] = a
        return a
    end
    local function applyEmitter(r)
        local p = r.spec()
        r.base = p.Rate or 0
        if r.base <= 0.25 then r.fixed = true end
        p.Rate = r.fixed and r.base or (r.base * e.factor * gmul())
        applyProps(r.inst, p)
    end
    function e.pe(parent, spec, noCullRate)
        local pe = Instance.new("ParticleEmitter")
        pe.Name = TAG .. "pe"
        local r = { inst = pe, spec = spec, fixed = noCullRate }
        e.pes[#e.pes + 1] = r
        e.items[#e.items + 1] = pe
        pe.Parent = parent
        applyEmitter(r)
        return pe, r
    end
    function e.tr(parent, a0, a1, spec)
        local tr = Instance.new("Trail")
        tr.Name = TAG .. "tr"
        tr.Attachment0, tr.Attachment1 = a0, a1
        local r = { inst = tr, spec = spec }
        e.trs[#e.trs + 1] = r
        e.items[#e.items + 1] = tr
        applyProps(tr, spec())
        tr.Parent = parent
        return tr, r
    end
    function e.refresh()
        for _, r in ipairs(e.pes) do applyEmitter(r) end
        for _, r in ipairs(e.trs) do applyProps(r.inst, r.spec()) end
        for _, f in ipairs(e.rf) do pcall(f) end
    end
    function e.setFactor(f)
        e.factor = f
        local m = gmul()
        for _, r in ipairs(e.pes) do
            if not r.fixed then setp(r.inst, "Rate", r.base * f * m) end
        end
    end
    function e.setEnabled(b)
        for _, r in ipairs(e.pes) do setp(r.inst, "Enabled", b) end
        for _, r in ipairs(e.trs) do setp(r.inst, "Enabled", b) end
    end
    function e.destroy()
        e.dead = true
        for _, i in ipairs(e.items) do pcall(function() i:Destroy() end) end
        e.items, e.pes, e.trs, e.upd, e.rf = {}, {}, {}, {}, {}
    end
    return e
end

