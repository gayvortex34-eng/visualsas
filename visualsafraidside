                local sp = min(st.speed or 0, 26)
                return ANG(-(0.03 + sp * 0.014) - 0.05 * sin(t * 2.3 - i * 0.6 + k), 0.06 * sin(t * 1.7 - i * 0.7 + k * 2) * (1 + sp / 20), 0)
            end })
            local zp = 0.02 * i
            local h = segH * 1.02
            local ops2 = { { k = "cloth", g = 1, folds = 2, amp = 0.04, s = { 0.5, h, 1 }, p = { 0, 0, zp } } }
            if i % 2 == 0 then
                ops2[#ops2 + 1] = { k = "cloth", g = 2, folds = 2, amp = 0.04, s = { 0.5, h * 0.3, 1 }, p = { 0, -h * 0.22, zp + 0.012 } }
            end
            if i == segs then
