    for i = 1, o.n do
        local x, y, z = o.x[i], o.y[i], o.z[i]
        if fn then x, y, z = fn(x, y, z) end
        self:vtx(x, y, z, o.u[i], o.v[i])
    end
    local f, nf = self.f, self.nf
    if mirror then
        for t = 1, o.nf, 3 do f[nf + t], f[nf + t + 1], f[nf + t + 2] = o.f[t] + base, o.f[t + 2] + base, o.f[t + 1] + base end
    else
        for i = 1, o.nf do f[nf + i] = o.f[i] + base end
    end
    self.nf = nf + o.nf
end

function G:finish(sheet)
    local n, f = self.n, self.f
    local X, Y, Z = self.x, self.y, self.z
    local nx, ny, nz = {}, {}, {}
    for i = 1, n do nx[i], ny[i], nz[i] = 0, 0, 0 end
    for t = 1, self.nf, 3 do
        local a, b, c = f[t], f[t + 1], f[t + 2]
        local ux, uy, uz = X[b] - X[a], Y[b] - Y[a], Z[b] - Z[a]
        local vx, vy, vz = X[c] - X[a], Y[c] - Y[a], Z[c] - Z[a]
        local cx, cy, cz = uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx
        nx[a], ny[a], nz[a] = nx[a] + cx, ny[a] + cy, nz[a] + cz
        nx[b], ny[b], nz[b] = nx[b] + cx, ny[b] + cy, nz[b] + cz
        nx[c], ny[c], nz[c] = nx[c] + cx, ny[c] + cy, nz[c] + cz
    end
    for i = 1, n do
        local l = msqrt(nx[i] * nx[i] + ny[i] * ny[i] + nz[i] * nz[i])
        if l < 1e-12 then nx[i], ny[i], nz[i] = 0, 1, 0 else nx[i], ny[i], nz[i] = nx[i] / l, ny[i] / l, nz[i] / l end
    end
    local out = { x = {}, y = {}, z = {}, nx = {}, ny = {}, nz = {}, u = {}, v = {}, f = {}, n = n * 2, nf = self.nf * 2 }
    local s = sheet and -1 or 1
    for i = 1, n do
        out.x[i], out.y[i], out.z[i], out.nx[i], out.ny[i], out.nz[i], out.u[i], out.v[i] = X[i], Y[i], Z[i], nx[i], ny[i], nz[i], self.u[i], self.v[i]
        local j = i + n
        out.x[j], out.y[j], out.z[j], out.nx[j], out.ny[j], out.nz[j], out.u[j], out.v[j] = X[i], Y[i], Z[i], nx[i] * s, ny[i] * s, nz[i] * s, self.u[i], self.v[i]
    end
    local nf = self.nf
    for t = 1, nf, 3 do
        out.f[t], out.f[t + 1], out.f[t + 2] = f[t], f[t + 1], f[t + 2]
        out.f[nf + t], out.f[nf + t + 1], out.f[nf + t + 2] = f[t] + n, f[t + 2] + n, f[t + 1] + n
    end
    local x0, y0, z0, x1, y1, z1 = 1e9, 1e9, 1e9, -1e9, -1e9, -1e9
    for i = 1, n do
        if X[i] < x0 then x0 = X[i] end; if X[i] > x1 then x1 = X[i] end
        if Y[i] < y0 then y0 = Y[i] end; if Y[i] > y1 then y1 = Y[i] end
        if Z[i] < z0 then z0 = Z[i] end; if Z[i] > z1 then z1 = Z[i] end
    end
    out.bb = { x0, y0, z0, x1, y1, z1 }
    return out
end

function K.volume(o)
    local v = 0
    local half = o.nf / 2
    for t = 1, half, 3 do
        local a, b, c = o.f[t], o.f[t + 1], o.f[t + 2]
        local ax, ay, az, bx, by, bz, cx, cy, cz = o.x[a], o.y[a], o.z[a], o.x[b], o.y[b], o.z[b], o.x[c], o.y[c], o.z[c]
        v = v + (ax * (by * cz - bz * cy) - ay * (bx * cz - bz * cx) + az * (bx * cy - by * cx)) / 6
    end
    return v
end

local function f32(x)
    if x ~= x or x == 0 then return "\0\0\0\0" end
    local sign = 0
    if x < 0 then sign = 128; x = -x end
    if x >= 3.4e38 then x = 3.4e38 end
    local m, e = math.frexp(x)
    e = e + 126
    if e <= 0 then return "\0\0\0" .. string.char(sign) end
    local man = mfloor((m * 2 - 1) * 8388608 + 0.5)
    if man >= 8388608 then man = 0; e = e + 1 end
    local b1 = man % 256
    local b2 = mfloor(man / 256) % 256
    local b3 = (mfloor(man / 65536) % 128) + (e % 2) * 128
    local b4 = sign + mfloor(e / 2)
    return string.char(b1, b2, b3, b4)
end
