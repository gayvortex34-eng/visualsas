local function orbitOffset(path, i, n, t, R, spd)
    local a = t * spd + (i / n) * math.pi * 2
    if path == "Gyro" then
        local x, y = math.cos(a) * R, math.sin(a) * R
        local plane = (i - 1) % 3
        if plane == 0 then return Vector3.new(x, y * 0.5, y * 0.87), a end
        if plane == 1 then return Vector3.new(x * 0.87, y * 0.5, -x * 0.5 + y * 0.0), a end
        return Vector3.new(0, x, y), a
    elseif path == "Helix" then
        local f = (i / n)
        return Vector3.new(math.cos(a) * R, (f * 2 - 1) * 2.4 + math.sin(t * 0.8) * 0.3, math.sin(a) * R), a
    elseif path == "Chaos" then
        return Vector3.new(math.sin(a * 1.0 + i) * R, math.sin(a * 1.7 + i * 2) * R * 0.55, math.cos(a * 1.3 + i * 3) * R), a
    end
    return Vector3.new(math.cos(a) * R, math.sin(t * 1.3 + i) * 0.25, math.sin(a) * R), a
end

local function modelPart(key, sc, col, mat, tr, shape)
    local url = key and MESH.on() and MESH.ensure(key) or nil
    local p = Instance.new("Part")
    p.Name = TAG .. "op"
    p.Anchored = true
    p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
    p.Material = mat or Enum.Material.SmoothPlastic
    p.Color = col
    p.Transparency = tr or 0
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    if url then
        p.Size = sc
        local sm = Instance.new("SpecialMesh")
        sm.MeshType = Enum.MeshType.FileMesh
        sm.MeshId = url
        sm.Scale = sc
        sm.Parent = p
    else
        p.Shape = shape or Enum.PartType.Block
        p.Size = sc
    end
    p.Parent = fxFolder()
    return p, url ~= nil
end

local function newObj(e)
    local o = { ex = {}, shift = CFrame.new(), roles = {} }
    function o.main(part, role) o.part = part; e.add(part); o.roles[#o.roles + 1] = { part, role } end
    function o.add(part, role, rel)
        e.add(part)
        local w = Instance.new("Weld")
        w.Name = TAG .. "ow"
        w.Part0 = o.part
        w.Part1 = part
        w.C0 = rel
        part.Anchored = false
        part.Massless = true
        w.Parent = part
        o.ex[#o.ex + 1] = part
        o.roles[#o.roles + 1] = { part, role }
    end
    return o
end

