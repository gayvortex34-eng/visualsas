local function wristPivot(b, parent, pos, o)
    return b.pivot({ of = parent, cf = CF(pos.X, pos.Y, 0), anim = function(t, st)
        local w = wingState(st, t)
        local c = 1 - w.sp
        local lag = 0.7 * (w.A / 0.46) * (Fl(w.ph - 0.65) - Fl(w.ph))
        return ANG(0, 0, -c * (o.wristFold or 0.5) + lag + 0.025 * sin(t * 1.3 + (o.ph or 0)))
    end })
end

local function featherList(pts, r, side, k)
    local list = {}
    for i = 1, r.n do
        local f = (r.n == 1) and 0.5 or (i - 1) / (r.n - 1)
        local u = r.u0 + (r.u1 - r.u0) * f
