local function fltStep(dt)
    local P = FILTERS[cfg.fltName]
    local amt = (P and cfg.fltOn) and cfg.fltAmt or 0
    local cur = H.cur
    local tb, tc, ts, tint, tblur = 0, 0, 0, Color3.new(1, 1, 1), 0
    if P and amt > 0 then
        tb, tc, ts = P.b * amt, P.c * amt, P.s * amt
        tint = Color3.new(1, 1, 1):Lerp(P.tint, amt)
        tblur = (Gov.cut and Gov.cut.blur) and 0 or P.blur * amt
    end
    local k = damp(6, dt)
    cur.b = cur.b + (tb - cur.b) * k
    cur.c = cur.c + (tc - cur.c) * k
    cur.s = cur.s + (ts - cur.s) * k
    cur.tint = cur.tint:Lerp(tint, k)
    cur.blur = cur.blur + (tblur - cur.blur) * k
    local tintOff = (1 - cur.tint.R) + (1 - cur.tint.G) + (1 - cur.tint.B)
    local active = math.abs(cur.b) + math.abs(cur.c) + math.abs(cur.s) + tintOff > 0.008
    if active or amt > 0 then
        if not H.flt or not H.flt.Parent then
            if H.flt then pcall(function() H.flt:Destroy() end) end
            H.flt = mkF("ColorCorrectionEffect", { Name = TAG .. "flt" })
            pcall(function() H.flt.Parent = Lighting end)
        end
        H.flt.Brightness, H.flt.Contrast, H.flt.Saturation, H.flt.TintColor = cur.b, cur.c, cur.s, cur.tint
    elseif H.flt then
        pcall(function() H.flt:Destroy() end)
        H.flt = nil
    end
    if cur.blur > 0.15 then
        if not H.fltB or not H.fltB.Parent then
            if H.fltB then pcall(function() H.fltB:Destroy() end) end
            H.fltB = mkF("BlurEffect", { Name = TAG .. "fltb", Size = 0 })
            pcall(function() H.fltB.Parent = Lighting end)
        end
        H.fltB.Size = cur.blur
    elseif H.fltB then
        pcall(function() H.fltB:Destroy() end)
        H.fltB = nil
    end
    return P, amt
end

local function overlayStep(dt, t, P, amt)
    local grain = cfg.grainOn and cfg.grainAmt or 0
    local scan = cfg.scanOn and cfg.scanAmt or 0
    if P and amt > 0 then
        grain = math.max(grain, (P.grain or 0) * amt)
        scan = math.max(scan, (P.scan or 0) * amt)
    end
    if (Gov.tier or 0) >= 3 then grain, scan = grain * 0.5, scan * 0.5 end
    if grain <= 0.01 and scan <= 0.01 then
        if H.grain then H.grain.Visible = false end
        if H.scan then H.scan.Visible = false end
        return
    end
    local g = guiUnder()
    if grain > 0.01 then
        if not H.grain then
            H.grain = mkF("ImageLabel", { Name = TAG .. "gr", BackgroundTransparency = 1, Image = TX("noise"), ScaleType = Enum.ScaleType.Tile,
                TileSize = UDim2.fromOffset(128, 128), Size = UDim2.new(1, 256, 1, 256), Position = UDim2.fromOffset(0, 0), ImageColor3 = Color3.new(1, 1, 1) }, g)
        end
        H.grain.Visible = true
        H.grain.ImageTransparency = 1 - clamp(grain, 0, 1) * 0.55
        if H.grain.Image ~= TX("noise") then H.grain.Image = TX("noise") end
        if t >= H.grainT then
            H.grainT = t + (((Gov.tier or 0) >= 2) and 0.14 or 0.066)
            H.grain.Position = UDim2.fromOffset(-math.random(0, 128), -math.random(0, 128))
        end
    elseif H.grain then
        H.grain.Visible = false
    end
    if scan > 0.01 then
        if not H.scan then
            H.scan = mkF("ImageLabel", { Name = TAG .. "sc", BackgroundTransparency = 1, Image = TX("scan"), ScaleType = Enum.ScaleType.Tile,
                TileSize = UDim2.fromOffset(4, 8), Size = UDim2.fromScale(1, 1), ImageColor3 = Color3.new(0, 0, 0) }, g)
        end
        H.scan.Visible = true
        H.scan.ImageTransparency = 1 - clamp(scan, 0, 1) * 0.9
        if H.scan.Image ~= TX("scan") then H.scan.Image = TX("scan") end
    elseif H.scan then
        H.scan.Visible = false
    end
end

local NLINES = 22
local function linesStep(dt, t)
    if not cfg.spdOn then
        if H.lines and H.lines.root.Visible then H.lines.root.Visible = false end
        H.lineA = 0
        return
    end
    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local sp = 0
    if hrp then local v = hrp.AssemblyLinearVelocity; sp = math.sqrt(v.X * v.X + v.Z * v.Z + v.Y * v.Y) end
    local target = clamp((sp - cfg.spdMin) / math.max(cfg.spdMin * 0.8, 1), 0, 1) * cfg.spdAmt
    H.lineA = H.lineA + (target - H.lineA) * damp(5, dt)
    if H.lineA < 0.02 then
        if H.lines and H.lines.root.Visible then H.lines.root.Visible = false end
        return
    end
    if not H.lines or not H.lines.root.Parent then
        local g = guiUnder()
        local L = { items = {} }
        L.root = mkF("Frame", { Name = TAG .. "sl", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, g)
        for i = 1, NLINES do
            local f = mkF("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(300, 2), Rotation = (i / NLINES) * 360 }, L.root)
            mkF("UIGradient", { Transparency = NS(K(0, 1), K(0.55, 1), K(0.85, 0.5), K(1, 0)) }, f)
            L.items[i] = f
        end
        H.lines = L
        H.lineT = 0
    end
    H.lines.root.Visible = true
    if t >= H.lineT then
        H.lineT = t + 0.07
        local cm = cam()
        local vp = cm and cm.ViewportSize or Vector2.new(1280, 720)
        local diag = math.sqrt(vp.X * vp.X + vp.Y * vp.Y) * 0.5
        local col = hsv(cfg.spdH, cfg.spdS, 1)
        for i, f in ipairs(H.lines.items) do
            f.Rotation = (i / NLINES) * 360 + rnd(-6, 6)
            f.Size = UDim2.fromOffset(diag * rnd(0.85, 1.05), rnd(1, 3) * (0.6 + H.lineA))
            f.BackgroundColor3 = col
            f.BackgroundTransparency = 1 - H.lineA * rnd(0.3, 0.8)
        end
    end
end

local CURS_TEX = { Ring = "ring", Star = "sparkle4", Heart = "heart", Sakura = "flower", Rune = "rune" }
