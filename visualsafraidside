local function pieceList(names, rig)
    local key = table.concat(names, ",") .. "|" .. rig.sig
    local c = ACC.cache[key]
    if c then return c end
    local all = {}
    for _, name in ipairs(names) do
        local d = DEFS[name]
        local pcs = M.build(name, rig.ctx)
        local off = #all
        for _, p in ipairs(pcs) do
            if p.of then p.of = p.of + off end
            p.def = d
            all[#all + 1] = p
        end
    end
    if ACC.cacheN > 24 then ACC.cache, ACC.cacheN = {}, 0 end
    ACC.cache[key] = all
    ACC.cacheN = ACC.cacheN + 1
    return all
end

local function colorOf(pals, p)
