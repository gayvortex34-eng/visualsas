local function shown(o)
    local n = 0
    while o and n < 16 do
        if o:IsA("ScreenGui") then return o.Enabled ~= false end
        if o:IsA("GuiObject") and not o.Visible then return false end
        o = o.Parent
        n = n + 1
    end
    return false
end

local function mannequin()
    local m = Instance.new("Model")
    m.Name = "dummy"
    local skin, shirt, pants = Color3.fromRGB(245, 205, 48), Color3.fromRGB(13, 105, 172), Color3.fromRGB(40, 127, 71)
    local function P(name, size, pos, col)
