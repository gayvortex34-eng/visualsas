local function layerRows(arm, o, side, k)
    local layers = {}
    for ri, row in ipairs(o.rows) do
        local list = {}
        local z0 = side * (ri - 1) * 0.16 * k
        for i = 1, row.n do
            local f = (row.n == 1) and 0.5 or (i - 1) / (row.n - 1)
            local u = row.u0 + (row.u1 - row.u0) * f
            local pt = H.polyAt(arm, u)
            local ang = lerp(row.a0, row.a1, f ^ (row.pw or 1))
            local len = row.len * k * (row.k0 + (1 - row.k0) * sin(PI * (0.08 + 0.84 * f) ^ (row.lp or 1)))
            list[i] = { pt.X, pt.Y, z0 + side * (i - 1) * 0.011 * k, ang, len, row.w * k, row.bend or 0.07, row.cup or 0.35, row.p or 2.3, row.q or 0.5, row.skew or 0.08, row.lod }
        end
        layers[ri] = { list = list, col = row.col or "a", mat = row.mat or "s" }
    end
    return layers
end
local function layerWing(b, side, o)
    local k = o.k or 1
    if not b.mesh then
        return featherWing(b, side, { arm = o.arm, rows = o.oldRows or ANGEL_ROWS, k = k })
    end
    local root = H.wingRoot(b, side, o.hx or 0.45, o.hy or 0.25, o.sweep or 0.55, o.roll or 4, o.anim or H.flapAnim(0.26, 1.9))
    local arm = {}
    for i, p in ipairs(o.arm) do arm[i] = p * k end
    local layers = layerRows(arm, o, side, k)
    local pal = o.pal or {}
    if o.glow ~= false then
        H.featherLayer(b, { of = root, cf = CF(0, 0, -side * 0.1 * k), feathers = layers[1].list, side = side, sx = 1.06, sy = 1.06, sz = 1, col = pal.glow or "b", mat = "g", tr = 0.62 })
    end
    for ri, ly in ipairs(layers) do
        H.featherLayer(b, { of = root, feathers = ly.list, side = side, col = pal[ri] or ly.col, mat = ly.mat })
    end
    H.chain(b, { of = root, cf = CF(0, 0, side * (#layers + 0.4) * 0.16 * k), pts = arm, r0 = (o.r0 or 0.1) * k, r1 = (o.r1 or 0.06) * k, col = pal.bone or "k", mat = "m" })
    for i = 2, #arm do
        H.orb(b, { of = root, cf = CF(arm[i].X, arm[i].Y, side * (#layers + 0.4) * 0.16 * k), d = (o.bead or 0.17) * k, col = pal.bead or "b", mat = "g" })
    end
    return root
