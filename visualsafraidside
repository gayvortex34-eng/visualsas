local function wantFor(rec, def)
    if not cfg.cosOn or not cfg[def.key] then return false end
    if not match(cfg.cosTarget, rec.plr) then return false end
    if not rec.hum or rec.hum.Health <= 0 then return false end
    if def.selfOnly and not rec.isSelf then return false end
    if not rec.isSelf and rec.culled then return false end
    return true
end

local function maskOf(rec)
    local t = {}
    for i, name in ipairs(COSORDER) do t[i] = wantFor(rec, COSFX[name]) and "1" or "0" end
    return table.concat(t)
end

local function syncCos(rec)
    if not rec.hrp or not rec.hrp.Parent then return end
    rec.cosE = rec.cosE or {}
    for _, name in ipairs(COSORDER) do
        local def = COSFX[name]
        local cur = rec.cosE[name]
        if wantFor(rec, def) then
            local sg = def.sig(rec)
            if cur and cur.sig == sg and not cur.dead then
                cur.refresh()
            else
                if cur then cur.destroy() end
