local function rotMat(rx, ry, rz)
    rx, ry, rz = rx * mpi / 180, ry * mpi / 180, rz * mpi / 180
    local cx, sx, cy, sy, cz, sz = mcos(rx), msin(rx), mcos(ry), msin(ry), mcos(rz), msin(rz)
    local a = { cz, -sz, 0, sz, cz, 0, 0, 0, 1 }
    local x = { 1, 0, 0, 0, cx, -sx, 0, sx, cx }
    local y = { cy, 0, sy, 0, 1, 0, -sy, 0, cy }
    local function mul(p, q)
        local r = {}
        for i = 0, 2 do for j = 0, 2 do
            r[i * 3 + j + 1] = p[i * 3 + 1] * q[j + 1] + p[i * 3 + 2] * q[j + 4] + p[i * 3 + 3] * q[j + 7]
        end end
        return r
    end
    return mul(y, mul(x, a))
end
function B.assembly(d)
    local gs = {}
    for i = 1, (d.ng or 1) do gs[i] = K.new() end
    for _, op in ipairs(d.ops) do
        local fn = ASM[op.k]
        if not fn then error("unknown assembly kind " .. tostring(op.k)) end
        local base = fn(op)
        local s = op.s
        local sx, sy, sz = 1, 1, 1
        if type(s) == "number" then sx, sy, sz = s, s, s elseif type(s) == "table" then sx, sy, sz = s[1], s[2], s[3] end
        local r = op.r or { 0, 0, 0 }
        local p = op.p or { 0, 0, 0 }
        local rep = op.rep or 1
        local cyc = op.cyc
        for ri = 0, rep - 1 do
            local cm = cyc and cyc[ri % #cyc + 1] or 1
            local ang = (op.ra or 0) + (rep > 1 and ri * 360 / rep or 0)
            local M = rotMat(0, ang, 0)
            local L
            if op.fr then
                local X, Y, Z = op.fr[1], op.fr[2], op.fr[3]
                L = { X[1], Y[1], Z[1], X[2], Y[2], Z[2], X[3], Y[3], Z[3] }
            else
                L = rotMat(r[1], r[2], r[3])
            end
            local T = {}
            for i = 0, 2 do for j = 0, 2 do
                T[i * 3 + j + 1] = M[i * 3 + 1] * L[j + 1] + M[i * 3 + 2] * L[j + 4] + M[i * 3 + 3] * L[j + 7]
            end end
            local px, py, pz = p[1], p[2], p[3]
            local qx, qy, qz = M[1] * px + M[2] * py + M[3] * pz, M[4] * px + M[5] * py + M[6] * pz, M[7] * px + M[8] * py + M[9] * pz
            local ax, ay, az = sx * cm, sy * cm, sz * cm
            local sg = (ax * ay * az) < 0
            local gi = gs[op.g or 1]
            gi:add(base, function(x, y, z)
                x, y, z = x * ax, y * ay, z * az
                return T[1] * x + T[2] * y + T[3] * z + qx, T[4] * x + T[5] * y + T[6] * z + qy, T[7] * x + T[8] * y + T[9] * z + qz
