        local id = H.mesh(b, { at = o.at, of = o.of, cf = o.cf, off = o.off, anim = o.anim, mesh = key, sx = o.d, sy = o.d, sz = o.d, col = o.col or "a", mat = o.mat or "m", tr = o.tr })
