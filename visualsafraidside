do
function H.spring(st, key, target, w, z)
    local mem = st.mem
    if not mem then return target end
    local s = mem[key]
    if not s then s = { x = target, v = 0 }; mem[key] = s end
    local dt = min(st.dt or 0, 0.05)
    if dt <= 0 then return s.x end
    local h = dt / 2
    for _ = 1, 2 do
        local a = w * w * (target - s.x) - 2 * z * w * s.v
        s.v = s.v + a * h
        s.x = s.x + s.v * h
    end
    return s.x
end

local function sat(v, a) return max(-a, min(a, v)) end
H.sat = sat

function H.drive(st)
    local sx, sy, sz, yaw = st.sx or 0, st.sy or 0, st.sz or 0, st.yaw or 0
    return {
        side = sat(-sx / 18 + yaw * 0.16, 1),
        lift = sat(-min(max(sz, 0), 26) / 26 * 0.9 - sy / 40, 1),
        run = min(st.speed or 0, 26) / 26,
    }
end

local function cross3(a, c) return { a[2] * c[3] - a[3] * c[2], a[3] * c[1] - a[1] * c[3], a[1] * c[2] - a[2] * c[1] } end
local function unit3(a)
    local l = sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3]) + 1e-9
    return { a[1] / l, a[2] / l, a[3] / l }
end

H.unit3, H.cross3 = unit3, cross3

local function fcone(g, base, dir, len, rad, ref, taper, bend, sides, rings)
    local X = unit3(dir)
    local Z = unit3(cross3(X, ref))
    local Y = cross3(Z, X)
    return { k = "cone", g = g, taper = taper or 0.05, bend = bend, sides = sides or 5, rings = rings or 2, fr = { X, Y, Z }, s = { len, rad, rad },
        p = { base[1] + X[1] * len / 2, base[2] + X[2] * len / 2, base[3] + X[3] * len / 2 } }
end
H.fcone = fcone

local function fur(ops, g, z0, r, n, len, rad, splay, ph, bend)
    for k = 0, n - 1 do
        local a = (k + (ph or 0)) / n * TAU
        local ca, sa = cos(a), sin(a)
        local l = len * ((k % 2 == 0) and 1 or 0.72)
        ops[#ops + 1] = fcone(g, { ca * r, sa * r, z0 }, { ca * splay, sa * splay, 1 }, l, rad * ((k % 2 == 0) and 1 or 0.85), { -sa, ca, 0 }, 0.05, bend)
    end
end
H.fur = fur

local function furF(ops, g, z0, r, n, len, w, splay, ph, o)
    o = o or {}
    for k = 0, n - 1 do
        local a = (k + (ph or 0)) / n * TAU
        local ca, sa = cos(a), sin(a)
        local X = unit3({ ca * splay, sa * splay, 1 })
        local d = ca * X[1] + sa * X[2]
        local Zv = unit3({ ca - X[1] * d, sa - X[2] * d, -X[3] * d })
        local Y = cross3(Zv, X)
        local l = len * (1 - (o.var or 0.16) * (k % 2))
        local lift = (o.th or w * 0.4) * 0.3
        ops[#ops + 1] = { k = "feather", g = g, bend = o.bend or 0.1, cup = o.cup or 0.5, sharp = o.sharp or 0.7, skew = o.skew or 0, lod = o.lod or 0.4, barbs = 0, fr = { X, Y, Zv },
            s = { l, w, o.th or w * 0.4 },
            p = { ca * r + X[1] * l / 2 + Zv[1] * lift, sa * r + X[2] * l / 2 + Zv[2] * lift, z0 + X[3] * l / 2 + Zv[3] * lift } }
    end
end
H.furF = furF

local function hash(a, b) local v = sin(a * 12.9898 + b * 78.233) * 43758.5453; return v % 1 end
H.hash = hash
local function tufts(ops, gl, i, z0, r, nn, len, dia, seed, sp, pp, q, flat)
    for k = 0, nn - 1 do
        local h1, h2, h3 = hash(k + seed, i), hash(k * 3.1 + seed, i + 5), hash(k + seed * 2, i * 1.7)
        local a = (k + (h1 - 0.5) * 0.6) / nn * TAU
        local ca, sa = cos(a), sin(a)
        local l = len * (0.7 + 0.5 * h2)
        local sw = (h3 - 0.5) * 0.2
        local X = unit3({ ca * (sp + 0.05) - sa * sw, sa * (sp + 0.05) + ca * sw, 1 })
        local d = ca * X[1] + sa * X[2]
        local Zv = unit3({ ca - X[1] * d, sa - X[2] * d, -X[3] * d })
        local Y = cross3(Zv, X)
        local dd = dia * (0.8 + 0.4 * h1)
        ops[#ops + 1] = { k = "spindle", g = gl, pp = pp, q = q, fr = { X, Y, Zv }, s = { l, dd, dd * (flat or 0.7) },
            p = { ca * r + X[1] * l / 2, sa * r + X[2] * l / 2, z0 + X[3] * l / 2 } }
    end
end
H.tufts = tufts

local function ftube(g, L, R0, R1, sw, closed, sides)
    return { k = "tube", g = g, pts = { { 0, 0, 0 }, { 0, 0, L * 0.5 }, { 0, 0, L } }, r0 = R0, r1 = R1, sides = sides or 14, seg = 3, swell = sw or 0, caps = closed and 1 or 0 }
end
H.ftube = ftube

function H.hinges(b, o)
    local prev = b.pivot({ at = o.at or "torso", cf = o.root })
    for i = 1, o.n do
        local piv = b.pivot({ of = prev, cf = CF(0, 0, (i == 1) and 0 or o.len), anim = o.anim(i) })
        local ops, groups = o.sec(i)
        local ok = H.asm(b, { of = piv, name = o.name .. i, ops = ops, groups = groups, bound = V3(1, 1, 1) * o.len * 3.2 })
        if not ok and i == 1 then return false end
        prev = piv
    end
    return true
end

function H.tailJoint(key, i, n, o)
    local f = i / n
    return function(t, st)
        local d = H.drive(st)
        local ph = o.ph or 0
        local pitchRest = o.curve and o.curve[i] or ((i == 1) and o.up or o.curl)
        local wag = (o.wag or 0.1) * (0.3 + f) * sin(t * (1.5 + d.run * 1.6) - i * 0.62 + ph)
        local yT = d.side * (o.swing or 0.5) * (0.35 + f) + wag
        local pT = pitchRest + d.lift * (o.lift or 0.5) * (0.4 + f) + (o.bob or 0.04) * sin(t * 1.1 - i * 0.4 + ph)
        local w = (o.w or 15) / (1 + (o.slack or 0.16) * i)
        local y = H.spring(st, key .. "y" .. i, yT, w, o.z or 0.5)
        local p = H.spring(st, key .. "p" .. i, pT, w, (o.z or 0.5) + 0.05)
        return ANG(p, y, 0)
    end
end
end
do
local S = {}
H.seal = S
local FLAT = { { 1, 0, 0 }, { 0, 0, 1 }, { 0, -1, 0 } }

function S.ring(ops, g, R, w, h, y, e)
    ops[#ops + 1] = { k = "torus", g = g, a = w / 2 / R, b = h / 2, e = e or 0.7, s = { R, 1, R }, p = { 0, y or 0, 0 } }
end

function S.seg(ops, g, x0, y0, x1, y1, w, th, y, ra, rep)
    local dx, dy = x1 - x0, y1 - y0
    local l = sqrt(dx * dx + dy * dy) + 1e-9
    local nx, ny = -dy / l * w / 2, dx / l * w / 2
    local ex, ey = dx / l * w * 0.35, dy / l * w * 0.35
    ops[#ops + 1] = { k = "plate", g = g, pts = { { x0 - ex + nx, y0 - ey + ny, 1 }, { x1 + ex + nx, y1 + ey + ny, 1 }, { x1 + ex - nx, y1 + ey - ny, 1 }, { x0 - ex - nx, y0 - ey - ny, 1 } },
        th = th, bev = min(th * 0.3, w * 0.3), seg = 3, fr = FLAT, p = { 0, y or 0, 0 }, ra = ra, rep = rep }
end

function S.poly(ops, g, pts, th, y, ra, rep, o)
    o = o or {}
    ops[#ops + 1] = { k = "plate", g = g, pts = pts, th = th, bev = o.bev or th * 0.3, seg = o.seg or 4, dome = o.dome, fr = FLAT, p = { 0, y or 0, 0 }, ra = ra, rep = rep }
end

function S.disc(ops, g, R, th, y, n, o)
    local pts = {}
    n = n or 32
    for i = 0, n - 1 do local a = i / n * TAU; pts[#pts + 1] = { cos(a) * R, sin(a) * R } end
    S.poly(ops, g, pts, th, y, 0, 1, { seg = 1, bev = (o and o.bev) or 0, dome = o and o.dome })
end

function S.star(ops, g, R, n, k, w, th, y, a0)
    for i = 0, n - 1 do
        local a, c = (i / n) * TAU + (a0 or 0), ((i + k) % n) / n * TAU + (a0 or 0)
        S.seg(ops, g, cos(a) * R, sin(a) * R, cos(c) * R, sin(c) * R, w, th, y)
    end
end

function S.ticks(ops, g, r0, r1, n, w, th, y, major, r2)
    for i = 0, n - 1 do
        local long = major and (i % major == 0)
        local e = long and (r2 or r1 + (r1 - r0) * 0.7) or r1
        S.seg(ops, g, r0, 0, e, 0, w * (long and 1.5 or 1), th, y, i / n * 360)
    end
end

function S.beads(ops, g, R, n, d, y, ra)
