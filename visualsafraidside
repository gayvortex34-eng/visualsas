function B.spindle(p, q)
    local g = K.new()
    local prof = {}
    local n = D(16)
    for i = 0, n do
        local t = i / n
        local r = mmax(1 - mabs(2 * t - 1) ^ p, 0) ^ q
        prof[#prof + 1] = { r * 0.5, t - 0.5 }
