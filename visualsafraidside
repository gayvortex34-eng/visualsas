                g:quad(r1[i], r2[i], r2[j], r1[j])
            else
                g:tri(c, r1[j], r1[i])
                g:quad(r1[i], r1[j], r2[j], r2[i])
            end
        end
    end
    local top, bot = {}, {}
    for i = 1, n do top[i] = g:vtx(O[i][1], O[i][2], h - bz) end
    for i = 1, n do bot[i] = g:vtx(O[i][1], O[i][2], -(h - bz)) end
    for i = 1, n do
