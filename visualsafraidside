local CIRCLE_STYLES = { "Magic", "Rune", "Ring", "Frost", "Afraid", "Vortex", "Bloom" }
local CIRCLE_TEX = {
    Magic = { "circle", "ring" }, Rune = { "circle", "star" }, Ring = { "ring", "glow" }, Frost = { "flower", "flake" },
    Afraid = { "logo", "glow" }, Vortex = { "vortex", "glow" }, Bloom = { "flower", "glow" },
