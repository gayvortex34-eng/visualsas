function H.loop(b, o)
    if b.mesh then
        local d = { hw = o.hw, hd = o.hd or o.hw, h = o.h, t = o.t, n = o.n or 4, e = o.e or 0.5 }
        local key = MESH.loop(d)
        if MESH.ensure(key) then
            local R = math.max(d.hw, d.hd) + d.t
            return H.mesh(b, { at = o.at, of = o.of, cf = o.cf, off = o.off, anim = o.anim, mesh = key, sx = 1, bound = V3(R * 2, d.h + d.t, R * 2), col = o.col or "a", mat = o.mat or "m", tr = o.tr })
        end
    end
    return b.P({ at = o.at, of = o.of, cf = o.cf, off = o.off, anim = o.anim, shape = "b", size = V3(o.hw * 2 + o.t, o.h, (o.hd or o.hw) * 2 + o.t), col = o.col or "a", mat = o.mat or "m", tr = o.tr })
end

function H.disc(b, o)
