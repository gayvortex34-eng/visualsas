        local wj = 1 + 0.07 * sin(i * 4.37 + r.z * 23)
        list[i] = { pt.X * k, pt.Y * k, side * (r.z + (i - 1) * 0.007) * k, ang + (r.aj or 2.2) * sin(i * 5.11 + r.z * 17), len * k, r.w * wj * k, r.bend or 0.06, r.cup or 0.12, r.p or 2.2, r.q or 0.55,
