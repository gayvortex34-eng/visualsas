local function batWing(b, side, o)
    local k = o.k or 1
    local root = H.wingRoot(b, side, o.hx or 0.4, o.hy or 0.3, o.sweep or 0.7, o.roll or 8, o.anim or H.flapAnim(0.24, 1.6))
    if H.bat(b, root, { elbow = o.elbow, wrist = o.wrist, body = o.body, tips = o.tips, k = k, inset = o.inset, sag = o.sag, bow = o.bow, r0 = o.r0, r1 = o.r1, rb = o.rb,
        bone = o.bone, cA = o.cA, cD = o.cD, tr = o.tr, memMat = o.memMat, side = side }) then
        return root
    end
    local E, W, Ba = o.elbow * k, o.wrist * k, o.body * k
    local bone, cA, cD = o.bone or "k", o.cA or "a", o.cD or "d"
    H.chain(b, { of = root, pts = { V3(0, 0, 0), E, W }, r0 = (o.r0 or 0.14) * k, r1 = (o.r1 or 0.1) * k, col = bone, mat = "m", jcol = "b", jmat = "g" })
    local ins = (o.inset or 0.5) * k
