function K.spline(pts, seg)
    local n = #pts
    if n < 3 then
        local out = {}
        local a, b = pts[1], pts[n]
        for i = 0, seg do
            local t = i / seg
            out[#out + 1] = { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
        end
        return out
    end
    local out = {}
    for i = 1, n - 1 do
        local p0, p1, p2, p3 = pts[mmax(i - 1, 1)], pts[i], pts[i + 1], pts[mmin(i + 2, n)]
        for s = 0, seg - 1 do
            local t = s / seg
            local t2, t3 = t * t, t * t * t
            local q = {}
            for k = 1, 3 do
                q[k] = 0.5 * ((2 * p1[k]) + (-p0[k] + p2[k]) * t + (2 * p0[k] - 5 * p1[k] + 4 * p2[k] - p3[k]) * t2 + (-p0[k] + 3 * p1[k] - 3 * p2[k] + p3[k]) * t3)
            end
            out[#out + 1] = q
        end
    end
    out[#out + 1] = { pts[n][1], pts[n][2], pts[n][3] }
    return out
end

local function norm3(x, y, z)
    local l = msqrt(x * x + y * y + z * z)
    if l < 1e-12 then return 0, 1, 0 end
    return x / l, y / l, z / l
end

function K.tube(g, path, r, sides, capA, capB, ey, up)
    local n = #path
    local rf = type(r) == "function" and r or function() return r end
    ey = ey or 1
    local T = {}
    for i = 1, n do
        local a, b = path[mmax(i - 1, 1)], path[mmin(i + 1, n)]
        T[i] = { norm3(b[1] - a[1], b[2] - a[2], b[3] - a[3]) }
    end
    local ux, uy, uz = 0, 1, 0
    if up then ux, uy, uz = up[1], up[2], up[3] end
    local t0 = T[1]
    if mabs(t0[1] * ux + t0[2] * uy + t0[3] * uz) > 0.95 then ux, uy, uz = 1, 0, 0 end
    local d = ux * t0[1] + uy * t0[2] + uz * t0[3]
    local Nx, Ny, Nz = norm3(ux - d * t0[1], uy - d * t0[2], uz - d * t0[3])
    local rings = {}
    local base = g.n
    for i = 1, n do
        local t = T[i]
        local dd = Nx * t[1] + Ny * t[2] + Nz * t[3]
        Nx, Ny, Nz = norm3(Nx - dd * t[1], Ny - dd * t[2], Nz - dd * t[3])
        local Bx, By, Bz = t[2] * Nz - t[3] * Ny, t[3] * Nx - t[1] * Nz, t[1] * Ny - t[2] * Nx
        local tt = (i - 1) / (n - 1)
        local p = path[i]
        rings[i] = { Nx, Ny, Nz, Bx, By, Bz }
        for k = 0, sides - 1 do
            local a = k / sides * TAU
            local rad = rf(tt, a)
            local c, s = mcos(a) * rad, msin(a) * rad * ey
            g:vtx(p[1] + c * Nx + s * Bx, p[2] + c * Ny + s * By, p[3] + c * Nz + s * Bz, k / sides, (i - 1) / (n - 1))
        end
    end
    for i = 1, n - 1 do
        for k = 0, sides - 1 do
            local a = base + (i - 1) * sides + k + 1
            local b = base + (i - 1) * sides + (k + 1) % sides + 1
            local c = base + i * sides + (k + 1) % sides + 1
            local dd2 = base + i * sides + k + 1
            g:quad(a, b, c, dd2)
        end
    end
    local function cap(i, atEnd)
        local rg = rings[i]
        local tt = (i - 1) / (n - 1)
        local p = path[i]
        local center = g:vtx(p[1], p[2], p[3])
        local first = g.n + 1
        for k = 0, sides - 1 do
            local a = k / sides * TAU
            local rad = rf(tt, a)
            local c, s = mcos(a) * rad, msin(a) * rad * ey
            g:vtx(p[1] + c * rg[1] + s * rg[4], p[2] + c * rg[2] + s * rg[5], p[3] + c * rg[3] + s * rg[6])
        end
        for k = 0, sides - 1 do
            local a, b = first + k, first + (k + 1) % sides
            if atEnd then g:tri(center, a, b) else g:tri(center, b, a) end
        end
    end
    if capA and rf(0, 0) > 1e-4 then cap(1, false) end
    if capB and rf(1, 0) > 1e-4 then cap(n, true) end
end

function K.lathe(g, profile, n, hard)
    local m = #profile
    if hard then
        for j = 1, m - 1 do
            local a, b = profile[j], profile[j + 1]
            g:grid(n, 1, function(u, v)
                local r, y = a[1] + (b[1] - a[1]) * v, a[2] + (b[2] - a[2]) * v
                return r * mcos(u * TAU), y, -r * msin(u * TAU)
            end, true)
        end
    else
        g:grid(n, m - 1, function(u, v)
            local f = v * (m - 1)
            local j = mmin(mfloor(f + 1e-9), m - 2)
            local t = f - j
            local a, b = profile[j + 1], profile[j + 2]
            local r, y = a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
            return r * mcos(u * TAU), y, -r * msin(u * TAU)
        end, true)
    end
end

function K.hull(g, pts, faces, flatShade)
    local cx, cy, cz = 0, 0, 0
    for _, p in ipairs(pts) do cx, cy, cz = cx + p[1], cy + p[2], cz + p[3] end
    cx, cy, cz = cx / #pts, cy / #pts, cz / #pts
    for _, fc in ipairs(faces) do
        for i = 2, #fc - 1 do g:flat(pts[fc[1]], pts[fc[i]], pts[fc[i + 1]], cx, cy, cz) end
    end
end

