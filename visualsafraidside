do
local function cross3(a, c) return { a[2] * c[3] - a[3] * c[2], a[3] * c[1] - a[1] * c[3], a[1] * c[2] - a[2] * c[1] } end
local function unit3(a)
    local l = sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3]) + 1e-9
    return { a[1] / l, a[2] / l, a[3] / l }
end

local function coneOp(g, base, dir, len, rad, ref, taper)
    local X = unit3(dir)
    local Z = unit3(cross3(X, ref))
    local Y = cross3(Z, X)
    return { k = "cone", g = g, taper = taper or 0.05, fr = { X, Y, Z }, s = { len, rad, rad },
        p = { base[1] + X[1] * len / 2, base[2] + X[2] * len / 2, base[3] + X[3] * len / 2 } }
end

local function tongues(ops, g, z0, R, n, len, rad, slope, ph)
    for k = 0, n - 1 do
        local a = (k + (ph or 0)) / n * TAU
        local ca, sa = cos(a), sin(a)
        ops[#ops + 1] = coneOp(g, { ca * R, sa * R, z0 }, { ca * slope, sa * slope, 1 }, len * ((k % 2 == 0) and 1 or 0.72), rad, { -sa, ca, 0 }, 0.05)
    end
end

local function tubeOp(g, L, R0, R1, sw, closed)
    return { k = "tube", g = g, pts = { { 0, 0, 0 }, { 0, 0, L * 0.5 }, { 0, 0, L } }, r0 = R0, r1 = R1, sides = 18, seg = 3, swell = sw or 0, caps = closed and 1 or 0 }
end

local function tailAnim(i, o)
    return function(t, st)
        local sp = min(st.speed or 0, 22)
        return ANG(-(o.curl or 0.1) * (1 + sp / 30), 0, 0) * ANG(0, (o.wag or 0.2) * sin(t * (1.6 + sp / 14) - i * 0.5 + (o.ph or 0)), 0)
    end
end

local function hingeChain(b, o)
    local prev = b.pivot({ at = "torso", cf = o.root })
    for i = 1, o.n do
        local piv = b.pivot({ of = prev, cf = CF(0, 0, (i == 1) and 0 or o.len), anim = o.anim(i) })
        local ops, groups = o.sec(i)
        local ok = H.asm(b, { of = piv, name = o.name .. i, ops = ops, groups = groups, bound = V3(1, 1, 1) * o.len * 3 })
        if not ok and i == 1 then return false end
        prev = piv
    end
    return true
end

