local function heights(hrp, hum)
    local fy
    if hum and hum.RigType == Enum.HumanoidRigType.R6 then
        fy = -3
    else
        fy = -(((hum and hum.HipHeight) or 2) + hrp.Size.Y / 2)
    end
    if fy > -2 or fy < -8 then fy = -3 end
    return fy, -fy * 0.8
end

local function wantAura(rec)
    if not (cfg.auraOn and match(cfg.auraTarget, rec.plr)) then return false end
    if not rec.hum or rec.hum.Health <= 0 then return false end
    if not rec.isSelf and rec.culled then return false end
    return true
end

local function wantTrail(rec)
    if rec.isSelf and os.clock() < testUntil then return true end
    if not (cfg.trailOn and match(cfg.trailTarget, rec.plr)) then return false end
    if not rec.isSelf and rec.culled then return false end
    return true
end

local function dropAura(rec) if rec.aura then rec.aura.destroy(); rec.aura = nil end end
local function dropTrail(rec) if rec.trail then rec.trail.destroy(); rec.trail = nil end end

local function syncRec(rec)
    if not rec.hrp or not rec.hrp.Parent then return end
    if wantAura(rec) then
        local sg = auraSig()
        if rec.aura and rec.aura.sig == sg and not rec.aura.dead then
            rec.aura.refresh()
        else
            dropAura(rec)
            rec.aura = buildAura(rec)
        end
    else
        dropAura(rec)
    end
    if wantTrail(rec) then
        local sg = trailSig()
        if rec.trail and rec.trail.sig == sg and not rec.trail.dead then
            rec.trail.refresh()
        else
            dropTrail(rec)
            rec.trail = buildTrail(rec)
            rec.trail.setFactor(0)
            rec.lastF = -1
        end
    else
        dropTrail(rec)
    end
end

local function syncAll()
    for _, rec in pairs(recs) do
        local ok, err = pcall(syncRec, rec)
        if not ok then report("fx", err) end
    end
end

local function dropRec(char)
    local rec = recs[char]
    if rec then
        dropAura(rec); dropTrail(rec)
        for _, f in ipairs(FX.dropHooks) do pcall(f, rec) end
        recs[char] = nil
    end
end

local function hookChar(plr, char)
