function H.panel(b, o)
    if not b.mesh then return false end
    local d = { R = o.R or { 0, 0 }, poly = o.poly, bulge = o.bulge or 0.16, veins = o.veins or 4, vr = o.vr or 0.03, rr = o.rr or 0.03, zs = o.side or 1, seg = o.seg, nv = o.nv, zf = o.zf, lift = o.lift }
    local ka, kb = MESH.panel(d)
    if not (MESH.ensure(ka) and MESH.ensure(kb)) then return false end
    local R = 1
    for _, q in ipairs(o.poly) do R = math.max(R, q[2] + math.abs(d.R[1]) + math.abs(d.R[2])) end
    local bound = V3(R * 2, R * 2, 1)
    H.mesh(b, { of = o.of, at = o.at, cf = o.cf, anim = o.anim, mesh = ka, sx = 1, bound = bound, col = o.col or "a", mat = o.mat or "s", tr = o.tr })
    if (o.veins or 4) > 0 or (o.rr or 0.03) > 0 then
        H.mesh(b, { of = o.of, at = o.at, cf = o.cf, anim = o.anim, mesh = kb, sx = 1, bound = bound, col = o.trim or "d", mat = o.trimMat or "m", tr = o.trimTr })
    end
    return true
end

function H.featherLayer(b, o)
    if not b.mesh then return false end
    local d = { f = o.feathers, zs = o.side or 1, lod = o.lod or 1 }
    local key = MESH.layer(d)
    if not MESH.ensure(key) then return false end
    local R = 1
    for _, f in ipairs(o.feathers) do R = math.max(R, math.sqrt(f[1] * f[1] + f[2] * f[2]) + f[5] + f[6]) end
    return H.mesh(b, { of = o.of, at = o.at, cf = o.cf, off = o.off, anim = o.anim, mesh = key, sx = o.sx or 1, sy = o.sy, sz = o.sz, bound = V3(R * 2, R * 2, 1),
        col = o.col or "a", mat = o.mat or "s", tr = o.tr })
end

function H.asm(b, o)
    if not b.mesh then return false end
    local sheets, used = {}, {}
    for i, gr in ipairs(o.groups) do sheets[i] = gr.sheet and true or false end
    for _, op in ipairs(o.ops) do used[op.g or 1] = true end
    local keys = { MESH.asm(o.name, { ops = o.ops, ng = #o.groups }, sheets) }
    for i, k in ipairs(keys) do
        if used[i] and not MESH.ensure(k) then return false end
    end
    local ids = {}
    for i, gr in ipairs(o.groups) do
        if used[i] then
            ids[#ids + 1] = H.mesh(b, { at = o.at, of = o.of, cf = o.cf, off = o.off, anim = o.anim, mesh = keys[i], sx = o.sx or 1, sy = o.sy, sz = o.sz, bound = o.bound or V3(4, 4, 4),
                col = gr.col or "a", mat = gr.mat or "m", tr = gr.tr, glow = gr.glow })
        end
    end
    return #ids > 0
end

function H.bat(b, root, o)
    if not b.mesh then return false end
    local function arr(v) return { v.X, v.Y, v.Z } end
    local tips = {}
    for i, t in ipairs(o.tips) do tips[i] = arr(t) end
    local d = { E = arr(o.elbow), W = arr(o.wrist), Ba = arr(o.body), tips = tips, k = o.k or 1, inset = o.inset or 0.5, sag = o.sag or 0.16, bow = o.bow or 0.07,
        r0 = o.r0 or 0.15, r1 = o.r1 or 0.1, rb = o.rb or 0.085, veins = (o.veins == false) and 0 or 1, zs = o.side or 1 }
    local kb, ma, mb, kr = MESH.bat(d)
    for _, key in ipairs({ kb, ma, mb, kr }) do
        if not MESH.ensure(key) then return false end
    end
    local R = 0
    for _, t in ipairs(tips) do R = math.max(R, math.abs(t[1]), math.abs(t[2])) end
    R = (R + 1) * d.k
    local bound = V3(R * 2, R * 2, 1)
    local one = V3(1, 1, 1)
    H.mesh(b, { of = root, mesh = ma, sx = 1, bound = bound, col = o.cA or "a", mat = o.memMat or "s", tr = o.tr })
    H.mesh(b, { of = root, mesh = mb, sx = 1, bound = bound, col = o.cD or "d", mat = o.memMat or "s", tr = o.tr })
    H.mesh(b, { of = root, mesh = kb, sx = 1, bound = bound, col = o.bone or "k", mat = "m" })
    H.mesh(b, { of = root, mesh = kr, sx = 1, bound = bound, col = "b", mat = "g" })
    return true
end

local function def(name, cat, palette, build)
    ORDER[#ORDER + 1] = name
    DEFS[name] = { name = name, cat = cat, pal = palette, build = build }
    BY_CAT[cat][#BY_CAT[cat] + 1] = name
end
M.def = def
local function redef(name, cat, palette, build)
    local d = DEFS[name]
    if not d then return def(name, cat, palette, build) end
    d.pal, d.build = palette or d.pal, build
end
M.redef = redef
M.pal, M.C3 = pal, C3

local function wave(t, spd, ph) return sin(t * spd + (ph or 0)) end
local function lerp(a, bb, f) return a + (bb - a) * f end

local function polyAt(pts, u)
    local n = #pts
    local f = max(0, min(1, u)) * (n - 1)
    local i = min(math.floor(f), n - 2)
    local k = f - i
    return pts[i + 1]:Lerp(pts[i + 2], k)
end
H.polyAt = polyAt

local function flapAnim(amp, spd, ph)
    return function(t, st)
        local air = st.air
        local a = amp * (air and 1.7 or (0.45 + min(st.speed or 0, 24) / 36))
        return ANG(0, 0, a * sin(t * spd * (air and 1.9 or 1) + (ph or 0)))
    end
end
H.flapAnim = flapAnim

function H.lerpn(a, c, f) return a + (c - a) * f end
local lerpn = H.lerpn
local function Fl(ph) return (sin(ph) + 0.25 * sin(2 * ph + 0.8)) / 1.2 end
H.flapF = Fl

local function wingState(st, t)
    local m = st.mem or st
    local w = m.wing
    if not w then
        w = { t = t, sp = 0.25, A = 0.04, w = 1.3, ph = 0 }
        m.wing = w
    end
    if w.t ~= t then
        local dt = math.max(0, math.min(0.12, t - w.t))
        w.t = t
        local spd = math.min((st.speed or 0) / 18, 1)
        local air = st.air
        local tsp = air and 1 or (0.2 + 0.42 * spd)
        local tA = air and 0.46 or (0.03 + 0.1 * spd)
        local tw = air and 6.2 or (1.2 + 3.4 * spd)
        local k = 1 - math.exp(-dt * 4.2)
        w.sp = w.sp + (tsp - w.sp) * k
        w.A = w.A + (tA - w.A) * k
        w.w = w.w + (tw - w.w) * k
        w.ph = w.ph + w.w * dt
    end
    return w
end

local function rig(b, side, o)
    local flip = side < 0 and PI or 0
    local A = b.pivot({ at = "torso", cf = CF(side * (o.hx or 0.42), o.hy or 0.3, b.td + (o.hz or 0.16)) * ANG(0, flip, 0), anim = function(t, st)
        local w = wingState(st, t)
        return ANG(0, 0, w.A * Fl(w.ph + (side < 0 and 0.07 or 0)) + (o.lift or 0))
    end })
    local B = b.pivot({ of = A, anim = function(t, st)
        local w = wingState(st, t)
        local sp = w.sp
        local fa = Fl(w.ph - 0.5) * w.A / 0.5
        local yaw = lerpn(o.yawR, o.yawO, sp) + 0.09 * fa
        local tilt = lerpn(o.tiltR, o.tiltO, sp) + 0.08 * fa
        local roll = lerpn(o.rollR, o.rollO, sp)
        return ANG(0, -side * yaw, 0) * ANG(side * tilt, 0, 0) * ANG(0, 0, roll)
    end })
    return A, B
end

H.wingState, H.wingRig = wingState, rig

local function wingRoot(b, side, hx, hy, sweep, roll, anim)
    local A, B = rig(b, side, { hx = hx, hy = hy, yawR = sweep, yawO = sweep * 0.5, tiltR = 0.16, tiltO = 0.06, rollR = rad(roll) + 0.08, rollO = rad(roll) * 0.4 })
    return B
end
H.wingRoot = wingRoot

local function featherWing(b, side, o)
    local root = wingRoot(b, side, o.hx or 0.45, o.hy or 0.25, o.sweep or 0.55, o.roll or 4, o.anim or flapAnim(0.26, 1.9))
    local arm = o.arm
    H.chain(b, { of = root, pts = arm, r0 = o.r0 or 0.11, r1 = o.r1 or 0.07, col = "b", mat = "m" })
    for ri, row in ipairs(o.rows) do
        local sub = b.pivot({ of = root, anim = function(t, st) return ANG(0, 0, 0.05 * wave(t, 2.1, -0.6 * ri) * (0.4 + min(st.speed or 0, 20) / 20)) end })
        for i = 1, row.n do
            local u = row.u0 + (row.u1 - row.u0) * ((row.n == 1) and 0.5 or (i - 1) / (row.n - 1))
            local pt = polyAt(arm, u)
            local f = (i - 1) / max(1, row.n - 1)
            local ang = rad(lerp(row.a0, row.a1, f ^ (row.pw or 1)))
            local len = row.len * (row.k0 + (1 - row.k0) * sin(PI * (0.08 + 0.84 * f) ^ (row.lp or 1)))
            H.feather(b, { of = sub, cf = CF(pt), ang = ang, len = len, w = row.w, t = o.t or 0.07, dz = side * (ri * 0.03 + i * 0.002),
                col = row.col, mat = row.mat or "s", tr = row.tr })
        end
    end
    return root
end

local function batWing(b, side, o)
    local root = wingRoot(b, side, o.hx or 0.4, o.hy or 0.3, o.sweep or 0.7, o.roll or 8, o.anim or flapAnim(0.24, 1.6))
    local E, W, Ba = o.elbow, o.wrist, o.body
    local tips = o.tips
    H.chain(b, { of = root, pts = { V3(0, 0, 0), E, W }, r0 = o.r0 or 0.14, r1 = o.r1 or 0.1, col = o.bone or "d", mat = "m", jcol = "b", jmat = "g" })
    local ins = o.inset or 0.5
    local rim = {}
    for i, tp in ipairs(tips) do
        H.chain(b, { of = root, pts = { W, W:Lerp(tp, 0.5) + V3(0, o.bow or 0, 0) * (o.bowDir or 1), tp }, r0 = 0.085, r1 = 0.03, col = o.bone or "d", mat = "m", joints = false })
        b.P({ of = root, cf = CF(tp), shape = "s", size = V3(0.12, 0.12, 0.12), col = "b", mat = "g" })
        rim[#rim + 1] = tp
        local nx = tips[i + 1]
        if nx then rim[#rim + 1] = (tp + nx) / 2 + (W - (tp + nx) / 2).Unit * ins end
    end
    local last = tips[#tips]
    rim[#rim + 1] = (last + Ba) / 2 + (W - (last + Ba) / 2).Unit * ins
    rim[#rim + 1] = Ba
    local ci = 0
    for i = 1, #rim - 1 do
        ci = ci + 1
        H.tri(b, { of = root, cf = CF(0, 0, -0.01 * (i % 2)), a = W, b = rim[i], c = rim[i + 1], th = o.th or 0.05, col = (ci % 2 == 0) and "a" or "d", mat = "p", tr = o.tr or 0.04 })
    end
    H.tri(b, { of = root, a = W, b = Ba, c = V3(0, 0, 0), th = o.th or 0.05, col = "a", mat = "p", tr = o.tr or 0.04 })
    H.tri(b, { of = root, a = W, b = V3(0, 0, 0), c = E, th = o.th or 0.05, col = "d", mat = "p", tr = o.tr or 0.04 })
    return root
end

