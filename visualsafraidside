M.build = build

local LAYERS = {}
for i = 1, 4 do LAYERS[i] = { i = i, part = nil, pes = {}, type = nil, f = 0, h = 20, nextProps = 0, spec = nil } end
local ST = { indoor = false, nextRay = 0, params = nil, nextBolt = 0 }

local function layerDrop(L)
    if L.part then pcall(function() L.part:Destroy() end) end
    L.part, L.pes, L.type, L.spec, L.last = nil, {}, nil, nil, nil
end

local function stormBolt()
    local cm = cam()
    if not cm then return end
    local look = cm.CFrame.LookVector
    local ang = math.atan2(look.Z, look.X) + rnd(-1.1, 1.1)
    local d = rnd(170, 380)
    local base = cm.CFrame.Position + V3(math.cos(ang) * d, -14, math.sin(ang) * d)
    if FX.bolt then
        pcall(FX.bolt, base + V3(0, 270, 0), base, { color = rgb(190, 205, 255), width = 1.8, segs = 11, jit = 24, life = 0.55, branches = 3 })
    end
    if cfg.wxFlash ~= false then
        SC.flashV = math.max(SC.flashV, rnd(0.35, 0.7))
        task.delay(0.13, function() SC.flashV = math.max(SC.flashV, 0.3) end)
    end
end

local function tintOf(L)
    if cfg[lk(L.i, "Tint")] then
        local h = cfg[lk(L.i, "Hue")] or 270
        return seq2(hsv(h, 0.55, 1), hsv(h + 28, 0.32, 1))
    end
end

local function layerApply(L, tp, rebuild)
    local r, s = cfg[lk(L.i, "Rate")] or 60, cfg[lk(L.i, "Size")] or 1
    local w, V, G = cfg.wxWind or 0.3, cfg.wxSpeed or 1, cfg.wxGlow or 1
    local sp = build(tp, r, s, w)
    local tint = tintOf(L)
    if rebuild or not L.part or not L.part.Parent then
        layerDrop(L)
        L.part = mk("Part", {
            Name = TAG .. "wx" .. L.i, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1, Size = sp.area,
        })
        L.part.Parent = FX.folder()
    end
    L.type, L.spec, L.last = tp, sp, nil
    L.h = sp.h
    local rm = cfg.wxRange or 1
    L.part.Size = V3(sp.area.X * rm, sp.area.Y, sp.area.Z * rm)
    for k, p in ipairs(sp.em) do
        local pe = L.pes[k]
        if not pe or not pe.Parent then
            pe = Instance.new("ParticleEmitter")
            pe.Name = TAG .. "pe"
            pe.Parent = L.part
            L.pes[k] = pe
        end
        L.base = L.base or {}
        L.base[k] = p.Rate
        p.Rate = 0
        p.LightInfluence = 0
        p.LockedToPart = false
        if p.Speed and V ~= 1 then p.Speed = NumberRange.new(p.Speed.Min * V, p.Speed.Max * V) end
        if p.Acceleration and V ~= 1 then p.Acceleration = p.Acceleration * V end
        if p.LightEmission then p.LightEmission = clamp(p.LightEmission * G, 0, 1) end
        if tint and p.Color and p.LightEmission and p.LightEmission > 0.2 then p.Color = tint end
        applyProps(pe, p)
        pcall(function() pe.EmissionDirection = sp.dir end)
    end
    for k = #sp.em + 1, #L.pes do
        pcall(function() L.pes[k]:Destroy() end)
        L.pes[k] = nil
    end
end

local function layerWant(L)
    return cfg[lk(L.i, "On")] and (Gov.wxMul or 1) > 0
end

function M.step(t, dt)
    local anyWant = false
    for _, L in ipairs(LAYERS) do if layerWant(L) then anyWant = true; break end end
    local needRay = false
    if anyWant and cfg.wxIndoor ~= false then
        for _, L in ipairs(LAYERS) do
            if layerWant(L) and FALLING[cfg[lk(L.i, "Type")]] then needRay = true; break end
        end
    end
    if needRay and t >= ST.nextRay then
        ST.nextRay = t + 0.33
        local cm = cam()
        if cm then
            if not ST.params then
                ST.params = RaycastParams.new()
                ST.params.FilterType = Enum.RaycastFilterType.Exclude
            end
            local ign = { FX.folder() }
            if lp.Character then ign[#ign + 1] = lp.Character end
            ST.params.FilterDescendantsInstances = ign
            local ok, hit = pcall(function() return Workspace:Raycast(cm.CFrame.Position, V3(0, 90, 0), ST.params) end)
            ST.indoor = ok and hit ~= nil and hit.Instance ~= nil and hit.Instance.CanCollide and hit.Instance.Transparency < 0.8
        end
    elseif not needRay then
        ST.indoor = false
    end
    local cm = cam()
    local wxm = Gov.wxMul or 1
    local stormOn = false
    for _, L in ipairs(LAYERS) do
        local tp = cfg[lk(L.i, "Type")]
        local want = layerWant(L)
        local hide = FALLING[tp] and ST.indoor
        local tgt = (want and not hide) and 1 or 0
        L.f = L.f + clamp(tgt - L.f, -dt * 1.4, dt * 1.4)
        if L.f <= 0.001 and tgt == 0 then
