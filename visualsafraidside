        P(s[1] .. "Hand", V3(1, 0.3, 1), V3(s[2] * 1.5, -1.65, 0), skin)
        P(s[1] .. "UpperLeg", V3(1, 1.2, 1), V3(s[2] * 0.5, -1.8, 0), pants)
        P(s[1] .. "LowerLeg", V3(1, 1.1, 1), V3(s[2] * 0.5, -2.95, 0), pants)
        P(s[1] .. "Foot", V3(1, 0.3, 1), V3(s[2] * 0.5, -3.65, 0), shirt)
    end
    return m, -2.8
end

local function acquireRig(parent)
    local char = lp.Character
    local clone
    if char and char.Parent then
        pcall(function()
            local old = char.Archivable
            char.Archivable = true
            clone = char:Clone()
            char.Archivable = old
        end)
    end
    local feetY = -3
    if clone and clone:FindFirstChild("HumanoidRootPart") and clone:FindFirstChild("Head") then
        local hum = char:FindFirstChildOfClass("Humanoid")
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
                or d:IsA("ForceField") or d:IsA("Highlight") or d:IsA("Tool") or d:IsA("Humanoid") or d:IsA("PointLight") then
                pcall(function() d:Destroy() end)
            elseif d:IsA("BasePart") then
                d.Anchored = true
            end
        end
        local hrp = clone:FindFirstChild("HumanoidRootPart")
        local hy = hum and (hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + hrp.Size.Y / 2)) or 3
        feetY = -hy
        clone.Parent = parent
        pcall(function() clone:PivotTo(CF(0, 0, 0)) end)
    else
        clone = nil
        local m, fy = mannequin()
        clone, feetY = m, fy
        clone.Parent = parent
    end
    local hrp = clone:FindFirstChild("HumanoidRootPart")
    return clone, { char = clone, hrp = hrp, feetY = feetY }
end

local function proj(camCF, fov, W, H, p)
    local rel = camCF:PointToObjectSpace(p)
    local z = -rel.Z
    if z < 0.1 then return nil end
    local f = (H / 2) / math.tan(math.rad(fov) / 2)
    return W / 2 + rel.X / z * f, H / 2 - rel.Y / z * f
end

local VIEWS = {}
local dragging, dragFrom, dragView = false, 0, nil

local function stage(frame)
    local bg = mk("Frame", { Name = "bg", BackgroundColor3 = Color3.fromRGB(26, 20, 44), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, frame)
    mk("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(46, 34, 78), Color3.fromRGB(12, 9, 22)), Rotation = 90 }, bg)
    local vf = mk("ViewportFrame", { Name = "vp", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Ambient = Color3.fromRGB(150, 146, 172),
        LightColor = Color3.fromRGB(255, 246, 236), LightDirection = V3(-0.5, -1, -0.6) }, frame)
    local cam = mk("Camera", { FieldOfView = 36 }, vf)
    vf.CurrentCamera = cam
    return vf, cam
end

local function hint(frame, text)
    return mk("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = text, TextSize = 11, TextColor3 = Color3.fromRGB(190, 184, 215),
        TextTransparency = 0.25, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(0, 10, 1, -20), Size = UDim2.new(1, -20, 0, 14), ZIndex = 5 }, frame)
end

function M.mountPreview(frame)
    local V = { kind = "acc", frame = frame, yaw = 0.5, dist = 11, nextRig = 0, nextPaint = 0, nextFrame = 0, vis = false, nextVis = 0 }
    V.vf, V.cam = stage(frame)
    V.note = hint(frame, "Drag to rotate")
    V.empty = mk("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = "Pick models in the Accessories tab", TextSize = 13, TextColor3 = Color3.fromRGB(200, 194, 225),
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.new(1, -24, 0, 18), Visible = false, ZIndex = 5 }, frame)

    local function clearRig()
        if V.model then pcall(function() V.model:Destroy() end); V.model = nil end
        if V.accFolder then pcall(function() V.accFolder:Destroy() end); V.accFolder = nil end
        V.set, V.rig, V.accSig = nil, nil, nil
    end

    local function buildRig()
        clearRig()
        V.model, V.rec = acquireRig(V.vf)
        V.rig = ACC.rigOf(V.rec)
        V.char = lp.Character
        local g = V.rec.feetY or -3
        local disc = mk("Part", { Name = "stage", Shape = Enum.PartType.Cylinder, Size = V3(0.12, 5.2, 5.2), Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
            Color = T.acc or Color3.fromRGB(150, 98, 255), Material = Enum.Material.Neon, Transparency = 0.7, CFrame = CF(0, g - 0.02, 0) * ANGc(0, 0, math.pi / 2) }, V.model)
        V.disc = disc
        V.center = V3(0, g * 0.5 + 1.3, 0)
        V.baseDist = 10.5
        V.accSig = nil
        V.nextRig = os.clock() + 3
    end

    local function names()
        local show = cfg.charShow
        if show and show ~= "My selection" and ACC.DEFS[show] then return { show } end
        return ACC.selected()
    end

    local function buildAcc()
        local nm = names()
        local sig = table.concat(nm, ",") .. "|" .. (V.rig and V.rig.sig or "")
        if V.accSig == sig then return end
        V.accSig = sig
        if V.accFolder then pcall(function() V.accFolder:Destroy() end); V.accFolder = nil end
        V.set = nil
        V.empty.Visible = (#nm == 0)
        if #nm == 0 or not V.rig then V.dist = 10.5; return end
        local pcs = ACC.pieceList(nm, V.rig)
        local fold = mk("Folder", { Name = "acc" }, V.vf)
        local set = { names = nm, pcs = pcs, parts = {} }
        for i, p in ipairs(pcs) do
            local part = ACC.newPart(p)
            part.Anchored = true
            part.Parent = fold
            set.parts[i] = part
        end
        ACC.paintSet(set, true)
        V.accFolder, V.set = fold, set
        local att = {}
        for k, a in pairs(V.rig.att) do att[k] = a.p.CFrame * a.o end
        local lay = ACC.layout(pcs, att, 0, { speed = 0, air = false })
        local ext = 3.4
        for i, c in ipairs(lay) do
            if not pcs[i].ghost then
                local d = c.Position - V.center
                ext = math.max(ext, math.abs(d.Y) + 0.2, math.sqrt(d.X * d.X + d.Z * d.Z) * 0.92)
            end
        end
        V.dist = math.clamp(ext * 3.05, 10.5, 48)
    end

    function V.update(t, dt)
        if t >= V.nextVis then V.nextVis = t + 0.2; V.vis = shown(frame) end
        if not V.vis then V.wasVis = false; return end
        if not V.model or lp.Character ~= V.char then
            if t >= V.nextRig or not V.model then buildRig() end
        end
        if not V.model then return end
        buildAcc()
        local view = cfg.charView
        if view == "Spin" then
            if not dragging or dragView ~= V then V.yaw = V.yaw + dt * 0.55 end
        else
            local target = (view == "Back") and math.pi or ((view == "Side") and math.pi / 2 or 0)
            if not dragging then
                local d = (target - V.yaw + math.pi) % (math.pi * 2) - math.pi
                V.yaw = V.yaw + d * damp(8, dt)
            end
        end
        local dist = V.dist * (cfg.charZoom or 1)
        V.curDist = V.curDist and (V.curDist + (dist - V.curDist) * damp(6, dt)) or dist
        local pitch = 0.12
        local eye = V.center + V3(math.sin(V.yaw) * math.cos(pitch), math.sin(pitch), -math.cos(V.yaw) * math.cos(pitch)) * V.curDist
        V.cam.CFrame = CFrame.lookAt(eye, V.center)
        if V.set and t >= V.nextFrame then
            V.nextFrame = t + 1 / 30
            local att = {}
            for k, a in pairs(V.rig.att) do att[k] = a.p.CFrame * a.o end
            local st = { speed = cfg.charRun and 17 or 0, air = false }
            local lay = ACC.layout(V.set.pcs, att, t, st)
            for i, part in ipairs(V.set.parts) do part.CFrame = lay[i] end
            if t >= V.nextPaint then
                V.nextPaint = t + 0.3
                ACC.paintSet(V.set, false)
            end
        end
    end

    function V.invalidate() V.model = nil; V.accSig = nil end
    function V.destroy() clearRig(); pcall(function() frame:ClearAllChildren() end) end

    V.vf.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragView, dragFrom = true, V, i.Position.X
        end
    end)
    VIEWS[#VIEWS + 1] = V
    return V
end

function M.mountEsp(frame)
    local V = { kind = "esp", frame = frame, nextRig = 0, vis = false, nextVis = 0, sway = 0 }
    V.vf, V.cam = stage(frame)
    V.over = mk("Frame", { Name = "over", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 3 }, frame)
    V.note = hint(frame, "Live preview of the box / label style")
    V.pv = ESP.newPreview(V.over)

    local function buildRig()
        if V.model then pcall(function() V.model:Destroy() end) end
        V.model, V.rec = acquireRig(V.vf)
        V.char = lp.Character
        local g = V.rec.feetY or -3
        V.feet = g
        V.center = V3(0, g * 0.5 + 1.3, 0)
        V.nextRig = os.clock() + 3
    end

    function V.update(t, dt)
        if t >= V.nextVis then V.nextVis = t + 0.2; V.vis = shown(frame) end
        if not V.vis then
            if V.wasVis then V.pv.hide(); V.wasVis = false end
            return
        end
        V.wasVis = true
        if not V.model or (lp.Character ~= V.char and t >= V.nextRig) then buildRig() end
        local W, H = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
        if W < 10 or H < 10 then return end
        local fov = 36
        local yaw = math.sin(t * 0.7) * 0.28
        local d = 12.5
        local eye = V.center + V3(math.sin(yaw), 0.05, -math.cos(yaw)) * d
        local camCF = CFrame.lookAt(eye, V.center)
        V.cam.CFrame = camCF
        local topY, botY = V.center.Y + 3.0, V.feet
        local x1, y1 = proj(camCF, fov, W, H, V3(0, topY, 0))
        local x2, y2 = proj(camCF, fov, W, H, V3(0, botY, 0))
        if not (x1 and x2) then return end
        local h = (y2 - y1) * (cfg.espHeight or 1)
        local w = (y2 - y1) * 0.5 * (cfg.espWidth or 1)
        local cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
        local hp = cfg.espPvHp or 0.72
        local nm = (cfg.espNameMode == "Username") and lp.Name or ((cfg.espNameMode == "Both") and (lp.DisplayName .. " (@" .. lp.Name .. ")") or lp.DisplayName)
        local parts = {}
        if cfg.espDist then parts[#parts + 1] = "48 st" end
        if cfg.espHpText then parts[#parts + 1] = ("%d hp"):format(math.floor(hp * 100 + 0.5)) end
        if cfg.espTool then parts[#parts + 1] = "Katana" end
        V.pv.draw(cx, cy, w, h, hp, nm, table.concat(parts, "  |  "), ESP.previewColor(1), t)
    end

    function V.invalidate() V.model = nil end
    function V.destroy()
        pcall(V.pv.destroy)
        if V.model then pcall(function() V.model:Destroy() end) end
        pcall(function() frame:ClearAllChildren() end)
    end
    VIEWS[#VIEWS + 1] = V
    return V
end

function M.invalidate()
    for _, v in ipairs(VIEWS) do pcall(v.invalidate) end
end

local accum = 0
function M.step(dt)
    if #VIEWS == 0 then return end
    accum = accum + dt
    if accum < 1 / 40 then return end
    local d = accum
    accum = 0
    local t = os.clock()
    if dragging then
        local pos = UIS:GetMouseLocation()
        if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and not (UIS.TouchEnabled and dragView and dragView.touch) then
            dragging = false
        elseif dragView then
            if M.lastX then dragView.yaw = dragView.yaw - (pos.X - M.lastX) * 0.012 end
            M.lastX = pos.X
        end
    else
        M.lastX = nil
    end
    for _, v in ipairs(VIEWS) do
        local ok, err = pcall(v.update, t, d)
        if not ok then report("character preview", err); v.vis = false; v.nextVis = t + 2 end
    end
end

function M.cleanup()
    for _, v in ipairs(VIEWS) do pcall(v.destroy) end
    VIEWS = {}
end

bind(lp.CharacterAdded, function() task.delay(1.2, M.invalidate) end)

return M
end)()
MISC.AVA = (function()

local M = {}
local ACC = FX.ACC
local V3, CF, ANGc = Vector3.new, CFrame.new, CFrame.Angles
local HALF_PI = math.pi / 2

local KOR = {
    upper = "rbxassetid://902942096", tex = "rbxassetid://902843398",
    lower = "rbxassetid://902942093", foot = "rbxassetid://902942089",
    r6mesh = 902942096, r6tex = 902843398,
}
local HEAD_ATT = { HatAttachment = true, HairAttachment = true, FaceFrontAttachment = true, FaceCenterAttachment = true }

M.status, M.kstatus = "Your own look", ""
local function setStatus(t, quiet)
    M.status = t
    if M.onStatus then pcall(M.onStatus, t) end
    if not quiet then notify(t, 3) end
end
local function setKStatus(t)
    M.kstatus = t
    if M.onKStatus then pcall(M.onKStatus, t) end
end
local function refreshPreview()
    local ch = MISC.CHAR
    if ch and ch.invalidate then pcall(ch.invalidate) end
end

local ST = setmetatable({}, { __mode = "k" })
local function stOf(rec)
    local s = ST[rec]
    if not s then s = {}; ST[rec] = s end
    return s
end

local function stash(map, o, prop, v)
    local m = map[o]
    if not m then m = {}; map[o] = m end
    if m[prop] == nil then m[prop] = o[prop] end
    if o[prop] ~= v then o[prop] = v end
end
local function unstash(map)
    for o, props in pairs(map) do
        if o.Parent ~= nil then
            for k, v in pairs(props) do pcall(function() o[k] = v end) end
        end
    end
    for k in pairs(map) do map[k] = nil end
end

local function isR15(rec)
    local c = rec.char
    if rec.hum and rec.hum.Parent then return rec.hum.RigType == Enum.HumanoidRigType.R15 end
    return c ~= nil and c:FindFirstChild("UpperTorso") ~= nil
end

local function isHeadItem(handle)
    for _, c in ipairs(handle:GetChildren()) do
        if c:IsA("Attachment") and HEAD_ATT[c.Name] then return true end
    end
    return false
end

local function headOn(rec)
    local char = rec.char
    local head = char and char:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end
    local s = stOf(rec)
    local h = s.h
    if not h then
        h = { map = {}, accs = {} }; s.h = h
        if rec.isSelf then task.delay(0.15, refreshPreview) end
    end
    stash(h.map, head, "Transparency", 1)
    for _, d in ipairs(head:GetChildren()) do
        if d:IsA("Decal") then stash(h.map, d, "Transparency", 1) end
    end
    if cfg.avaHeadAcc then
        for _, a in ipairs(char:GetChildren()) do
            if a:IsA("Accessory") then
                local hd = a:FindFirstChild("Handle")
                if hd and hd:IsA("BasePart") and isHeadItem(hd) then stash(h.accs, hd, "Transparency", 1) end
            end
        end
    else
        unstash(h.accs)
    end
end

local function headOff(rec)
    local s = ST[rec]
    if s and s.h then
        unstash(s.h.map); unstash(s.h.accs)
        s.h = nil
        if rec.isSelf then task.delay(0.15, refreshPreview) end
    end
end

local function legParts(rec)
    local c = rec.char
    if isR15(rec) then
        local u, l, f = c:FindFirstChild("RightUpperLeg"), c:FindFirstChild("RightLowerLeg"), c:FindFirstChild("RightFoot")
        if u and l and f and u:IsA("BasePart") and l:IsA("BasePart") and f:IsA("BasePart") then return { u, l, f }, true end
        return nil
    end
    local leg = c:FindFirstChild("Right Leg")
    if leg and leg:IsA("BasePart") then return { leg }, false end
    return nil
end

local function meshApply(k, parts)
    local u, l, f = parts[1], parts[2], parts[3]
    if not (u:IsA("MeshPart") and l:IsA("MeshPart") and f:IsA("MeshPart")) then return false end
    local ok = pcall(function()
        for _, ch in ipairs(u:GetChildren()) do
            if ch:IsA("SurfaceAppearance") then
                k.sa = k.sa or {}
                k.sa[#k.sa + 1] = ch
                ch.Parent = nil
            end
        end
        stash(k.map, u, "MeshId", KOR.upper)
        stash(k.map, u, "TextureID", KOR.tex)
        stash(k.map, l, "MeshId", KOR.lower)
        stash(k.map, l, "Transparency", 1)
        stash(k.map, f, "MeshId", KOR.foot)
        stash(k.map, f, "Transparency", 1)
    end)
    if not ok then return false end
    return tostring(u.MeshId):find("902942096", 1, true) ~= nil
end

local function charMesh(rec, k)
    local char = rec.char
    if k.cm and k.cm.Parent == char then return true end
    local ok = pcall(function()
        local cm = Instance.new("CharacterMesh")
        cm.Name = TAG .. "korblox"
        cm.BodyPart = Enum.BodyPart.RightLeg
        cm.MeshId = KOR.r6mesh
        cm.OverlayTextureId = KOR.r6tex
        cm.Parent = char
        k.cm = cm
    end)
    return ok and k.cm ~= nil
end

local function bonePieces(r15, segs, hue)
    local bone, armor, glow = Color3.fromRGB(224, 216, 198), Color3.fromRGB(34, 30, 46), hsv(hue, 0.7, 1)
    local out = {}
    local function add(seg, shape, size, cf, col, mat, role)
        out[#out + 1] = { seg = seg, shape = shape, size = size, cf = cf, col = col, mat = mat, role = role }
    end
    local ROT = ANGc(0, 0, HALF_PI)
    local U, L, Ft
    if r15 then
        U = { 1, 0, segs[1].Size.Y }
        L = { 2, 0, segs[2].Size.Y }
        Ft = { 3, 0, segs[3].Size.Y }
    else
        U = { 1, 0.55, 0.9 }; L = { 1, -0.45, 0.9 }; Ft = { 1, -0.93, 0.14 }
    end
    local sU, yU, hU = U[1], U[2], U[3]
    local sL, yL, hL = L[1], L[2], L[3]
    local sF, yF, hF = Ft[1], Ft[2], Ft[3]
    add(sU, "c", V3(hU * 0.96, 0.3, 0.3), CF(0, yU, 0) * ROT, bone, Enum.Material.SmoothPlastic, "bone")
    add(sU, "s", V3(0.58, 0.58, 0.58), CF(0, yU + hU / 2 - 0.03, 0), armor, Enum.Material.Metal, "armor")
    add(sU, "b", V3(0.64, hU * 0.46, 0.16), CF(0, yU + hU * 0.08, -0.3), armor, Enum.Material.Metal, "armor")
    add(sU, "c", V3(0.07, 0.66, 0.66), CF(0, yU - hU * 0.2, 0) * ROT, glow, Enum.Material.Neon, "glow")
    add(sU, "s", V3(0.5, 0.5, 0.5), CF(0, yU - hU / 2 + 0.02, 0), armor, Enum.Material.Metal, "armor")
    add(sU, "w", V3(0.16, 0.34, 0.3), CF(0, yU - hU / 2 + 0.02, -0.28), bone, Enum.Material.SmoothPlastic, "bone")
    add(sL, "c", V3(hL * 0.96, 0.26, 0.26), CF(0, yL, 0) * ROT, bone, Enum.Material.SmoothPlastic, "bone")
    add(sL, "c", V3(hL * 0.8, 0.12, 0.12), CF(0.17, yL - 0.02, 0.1) * ROT, bone, Enum.Material.SmoothPlastic, "bone")
    add(sL, "b", V3(0.46, hL * 0.6, 0.1), CF(0, yL + hL * 0.04, -0.22), armor, Enum.Material.Metal, "armor")
    add(sL, "c", V3(0.06, 0.58, 0.58), CF(0, yL - hL * 0.3, 0) * ROT, glow, Enum.Material.Neon, "glow")
    add(sF, "s", V3(0.34, 0.34, 0.34), CF(0, yF + hF / 2 + 0.05, 0), armor, Enum.Material.Metal, "armor")
    add(sF, "b", V3(0.46, 0.18, 0.5), CF(0, yF - 0.02, 0.12), armor, Enum.Material.Metal, "armor")
    for i = -1, 1 do
        add(sF, "w", V3(0.12, 0.16, 0.44), CF(i * 0.17, yF - 0.03, -0.42), bone, Enum.Material.SmoothPlastic, "bone")
    end
    return out
end

local function boneBuild(rec, k, parts)
    local r15 = #parts == 3
    local list = bonePieces(r15, parts, cfg.avaKorH or 275)
    local model = Instance.new("Model")
    model.Name = TAG .. "bone"
    for _, p in ipairs(list) do
        local seg = parts[p.seg]
        local part = ACC.newPart({ shape = p.shape, size = p.size, tr = 0 })
        part.Color = p.col
        part.Material = p.mat
        part.CFrame = seg.CFrame * p.cf
        part.Parent = model
        local w = Instance.new("Weld")
        w.Name = TAG .. "w"
        w.Part0 = seg
        w.Part1 = part
        w.C0 = p.cf
        w.C1 = CFrame.new()
        w.Parent = part
    end
    for _, seg in ipairs(parts) do stash(k.map, seg, "Transparency", 1) end
    model.Parent = FX.folder()
    k.model, k.segs, k.kind = model, parts, "bone"
end

local function korSig() return tostring(cfg.avaKorMode) .. "|" .. tostring(math.floor((cfg.avaKorH or 275) + 0.5)) end

local function korOff(rec)
    local s = ST[rec]
    local k = s and s.k
    if not k then return end
    if k.model then pcall(function() k.model:Destroy() end) end
    if k.cm then pcall(function() k.cm:Destroy() end) end
    unstash(k.map)
    if k.sa then
        for _, sa in ipairs(k.sa) do
            if rec.char and rec.char.Parent then
                local u = rec.char:FindFirstChild("RightUpperLeg")
                if u then pcall(function() sa.Parent = u end) end
            end
        end
    end
    s.k = nil
    if rec.isSelf then setKStatus("") end
end

local function korOn(rec)
    local s = stOf(rec)
    local sig = korSig()
    if s.k and s.k.sig ~= sig then korOff(rec) end
    local parts, r15 = legParts(rec)
    if not parts then return end
    local k = s.k
    if not k then
        k = { sig = sig, map = {} }
        s.k = k
        local mode = cfg.avaKorMode
        if mode == "Bone leg" then
            boneBuild(rec, k, parts)
        elseif r15 then
            if meshApply(k, parts) then
                k.kind = "mesh"
            else
                unstash(k.map)
                if mode == "Auto" then boneBuild(rec, k, parts) else k.kind = "fail" end
            end
        else
            if charMesh(rec, k) then k.kind = "cmesh" else boneBuild(rec, k, parts) end
        end
        if rec.isSelf then
            local txt = ({ mesh = "Korblox: real mesh applied (community ids)", cmesh = "Korblox: R6 CharacterMesh added (community ids)",
                bone = "Korblox: bone leg (built from parts)", fail = "Korblox: MeshId write blocked here - use Bone leg" })[k.kind] or ""
            setKStatus(txt)
            if k.kind == "fail" then notify(txt, 4) end
        end
        refreshPreview()
        return
    end
    if k.kind == "mesh" then
        meshApply(k, parts)
    elseif k.kind == "bone" then
        local changed = (not k.model) or (not k.model.Parent) or (#k.segs ~= #parts)
        if not changed then for i, seg in ipairs(parts) do if k.segs[i] ~= seg then changed = true; break end end end
        if changed then
            if k.model then pcall(function() k.model:Destroy() end) end
            boneBuild(rec, k, parts)
        else
            for _, seg in ipairs(parts) do stash(k.map, seg, "Transparency", 1) end
        end
    elseif k.kind == "cmesh" then
        charMesh(rec, k)
    end
end

local COPY = { busy = false, last = nil, mode = nil, S = nil, orig = nil, char = nil }
local CLASSES = { "Accessory", "Shirt", "Pants", "ShirtGraphic", "BodyColors", "CharacterMesh" }
local function isLook(o)
    for _, c in ipairs(CLASSES) do if o:IsA(c) then return true end end
    return false
end

local function restoreClone(S)
    if not S then return end
    for _, o in ipairs(S.added) do pcall(function() o:Destroy() end) end
    local me = lp.Character
    if me and me == S.char then
        for _, o in ipairs(S.stash) do pcall(function() o.Parent = me end) end
    else
        for _, o in ipairs(S.stash) do pcall(function() o:Destroy() end) end
    end
    if S.face and S.face[1].Parent then pcall(function() S.face[1].Texture = S.face[2] end) end
    if S.hm and S.hm[1].Parent then
        pcall(function() local m = S.hm[1]; m.MeshId, m.TextureId, m.Scale, m.Offset = S.hm[2], S.hm[3], S.hm[4], S.hm[5] end)
    end
    for _, p in ipairs(S.props) do
        if p[1].Parent ~= nil then pcall(function() p[1][p[2]] = p[3] end) end
    end
end

function M.restore(quiet)
    if COPY.mode == "clone" then
        restoreClone(COPY.S)
    elseif COPY.mode == "desc" then
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            local d = COPY.orig
            if not d then
                local ok, r = pcall(function() return Players:GetHumanoidDescriptionFromUserId(lp.UserId) end)
                d = ok and r or nil
            end
            if d then pcall(function() hum:ApplyDescriptionReset(d) end) end
        end
    end
    COPY.mode, COPY.S, COPY.orig, COPY.last, COPY.char = nil, nil, nil, nil, nil
    setStatus("Your own look", quiet)
    refreshPreview()
end

local function copyClone(target)
    local me = lp.Character
    local hum = me and me:FindFirstChildOfClass("Humanoid")
    local tc = target.Character
    if not (me and hum and tc and tc.Parent) then return false, "character not loaded" end
    if COPY.mode then M.restore(true) end
    local S = { stash = {}, added = {}, props = {}, char = me }
    for _, ch in ipairs(me:GetChildren()) do
        if isLook(ch) and ch.Name:sub(1, #TAG) ~= TAG then
            S.stash[#S.stash + 1] = ch
            ch.Parent = nil
        end
    end
    for _, ch in ipairs(tc:GetChildren()) do
        if isLook(ch) then
            local ok, cl = pcall(function()
                local old = ch.Archivable
                ch.Archivable = true
                local c = ch:Clone()
                ch.Archivable = old
                return c
            end)
            if ok and cl then
                if cl:IsA("Accessory") then
                    local ok2 = pcall(function() hum:AddAccessory(cl) end)
                    if not ok2 then cl.Parent = me end
                else
                    cl.Parent = me
                end
                S.added[#S.added + 1] = cl
            end
        end
    end
    local th, mh = tc:FindFirstChild("Head"), me:FindFirstChild("Head")
    if th and mh then
        local tf, mf = th:FindFirstChildOfClass("Decal"), mh:FindFirstChildOfClass("Decal")
        if tf and mf then S.face = { mf, mf.Texture }; mf.Texture = tf.Texture end
        local tm, mm = th:FindFirstChildOfClass("SpecialMesh"), mh:FindFirstChildOfClass("SpecialMesh")
        if tm and mm then
            S.hm = { mm, mm.MeshId, mm.TextureId, mm.Scale, mm.Offset }
            pcall(function() mm.MeshId = tm.MeshId; mm.TextureId = tm.TextureId; mm.Scale = tm.Scale; mm.Offset = tm.Offset end)
        end
    end
    for _, mp in ipairs(me:GetChildren()) do
        if mp:IsA("BasePart") and mp.Name ~= "HumanoidRootPart" then
            local tp = tc:FindFirstChild(mp.Name)
            if tp and tp:IsA("BasePart") then
                S.props[#S.props + 1] = { mp, "Color", mp.Color }
                pcall(function() mp.Color = tp.Color end)
                if cfg.avaCopyBody and mp:IsA("MeshPart") and tp:IsA("MeshPart") then
                    S.props[#S.props + 1] = { mp, "MeshId", mp.MeshId }
                    S.props[#S.props + 1] = { mp, "TextureID", mp.TextureID }
                    pcall(function() mp.MeshId = tp.MeshId; mp.TextureID = tp.TextureID end)
                end
            end
        end
    end
    COPY.mode, COPY.S, COPY.char = "clone", S, me
    return true
end

local function copyDesc(userId)
    local me = lp.Character
    local hum = me and me:FindFirstChildOfClass("Humanoid")
    if not hum then return false, "character not loaded" end
    local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
    if not ok or not desc then return false, "could not load that avatar" end
    local keepOrig = COPY.orig
    if COPY.mode == "clone" then M.restore(true) end
    if not keepOrig then
        local ok2, o = pcall(function() return hum:GetAppliedDescription() end)
        keepOrig = ok2 and o or nil
    end
    local ok3 = pcall(function() hum:ApplyDescriptionReset(desc) end)
    if not ok3 then return false, "ApplyDescription is blocked here - try the Clone method" end
    COPY.mode, COPY.orig, COPY.char = "desc", keepOrig, me
    return true
end

local function doCopy(who, method, label)
    if COPY.busy then return end
    COPY.busy = true
    task.spawn(function()
        local ok, res, err = pcall(function()
            local plr = (typeof(who) == "Instance") and who or nil
            local uid = plr and plr.UserId or tonumber(who)
            if not plr and uid then
                for _, p in ipairs(Players:GetPlayers()) do if p.UserId == uid then plr = p; break end end
            end
            local m = method
            if m == "Auto" then m = (plr and plr.Character) and "Clone" or "Description" end
            if m == "Clone" then
                if not plr then return false, "Clone needs a player that is in this server" end
                return copyClone(plr)
            end
            if not uid then return false, "unknown user" end
            return copyDesc(uid)
        end)
        COPY.busy = false
        if ok and res then
            COPY.last = { who = who, method = method, label = label }
            setStatus("Wearing: " .. tostring(label) .. " (" .. (COPY.mode == "clone" and "clone" or "description") .. ")")
        else
            setStatus("Copy failed: " .. tostring(ok and err or res), false)
        end
        refreshPreview()
    end)
end

local function labelOf(p)
    return (p.DisplayName ~= "" and p.DisplayName ~= p.Name) and (p.DisplayName .. " (@" .. p.Name .. ")") or p.Name
end

function M.playerLabels()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then out[#out + 1] = labelOf(p) end
    end
    table.sort(out)
    if #out == 0 then out[1] = "(nobody else here)" end
    return out
end

local function findByLabel(txt)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and labelOf(p) == txt then return p end
    end
end

function M.copyPick()
    local p = findByLabel(tostring(cfg.avaPick))
    if not p then setStatus("Pick a player first (Refresh list)", false); return end
    doCopy(p, cfg.avaMethod or "Auto", labelOf(p))
end

function M.copyName(text)
    text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then setStatus("Type a username or user id", false); return end
    task.spawn(function()
        local uid = tonumber(text:match("^%d+$"))
        if not uid then
            local ok, r = pcall(function() return Players:GetUserIdFromNameAsync(text) end)
            uid = ok and r or nil
        end
        if not uid then setStatus("User not found: " .. text, false); return end
        doCopy(uid, cfg.avaMethod or "Auto", text)
    end)
end

