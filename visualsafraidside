end

local function refresh()
    local ch = lp.Character
    if ch ~= S.char then
        dropCharState()
        S.char, S.hum, S.root = ch, nil, nil
    end
    if not ch then return false end
    if not (S.hum and S.hum.Parent) then S.hum = ch:FindFirstChildOfClass("Humanoid") end
    if not (S.root and S.root.Parent) then S.root = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart end
    local h = S.hum
    if not (h and S.root) then return false end
    if h.Health <= 0 then return false end
    return true
end

local function axes()
    local fwd = (keyDown("W") and 1 or 0) - (keyDown("S") and 1 or 0)
    local str = (keyDown("D") and 1 or 0) - (keyDown("A") and 1 or 0)
    local c = cam()
    if fwd == 0 and str == 0 and S.hum and c then
        local md = S.hum.MoveDirection
        if md.Magnitude > 0.05 then
            local cf = c.CFrame
            local lf = flat(cf.LookVector) or flat(cf.UpVector)
            local rf = flat(cf.RightVector)
            if lf then fwd = md:Dot(lf) end
            if rf then str = md:Dot(rf) end
        end
    end
    local m = sqrt(fwd * fwd + str * str)
    if m > 1 then fwd, str = fwd / m, str / m end
    return fwd, str
end

local function moveDir()
    local h = S.hum
    local md = h and h.MoveDirection or zero
    if md.Magnitude > 0.05 then return md.Unit, true end
    local fwd, str = axes()
    local c = cam()
    if c and (fwd ~= 0 or str ~= 0) then
        local lf = flat(c.CFrame.LookVector) or flat(c.CFrame.UpVector)
        local rf = flat(c.CFrame.RightVector)
        local v = zero
        if lf then v = v + lf * fwd end
        if rf then v = v + rf * str end
        if v.Magnitude > 0.05 then return v.Unit, true end
    end
    return zero, false
end

local function lookFlat()
    local c = cam()
    local f = c and (flat(c.CFrame.LookVector) or flat(c.CFrame.UpVector))
    if f then return f end
    local r = S.root
    return (r and flat(r.CFrame.LookVector)) or V3(0, 0, -1)
end

local function restoreNoclip()
    for p in pairs(S.nc.set) do
        pcall(function() if p.Parent then p.CanCollide = true end end)
    end
    S.nc.set, S.nc.on = {}, false
end

local function noclipStep()
    local want = cfg.ncOn == true or (S.fly.on and cfg.flyNoclip ~= false) or S.tw ~= nil or (cfg.tpFollow == true and S.fol.active == true)
    if want then
        S.nc.on = true
        for _, p in ipairs(S.char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                S.nc.set[p] = true
                p.CanCollide = false
            end
        end
    elseif S.nc.on then
        restoreNoclip()
    end
end

local function ensureRig(root)
    local rig = S.fly.rig
    if rig and rig.lv.Parent == root and rig.ao.Parent == root then return rig end
    destroyRig()
    local att = Instance.new("Attachment")
    att.Name = TG .. "a"
    att.Parent = root
    local lv = Instance.new("LinearVelocity")
    lv.Name = TG .. "v"
    lv.Attachment0 = att
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.MaxForce = math.huge
    lv.VectorVelocity = zero
    lv.Parent = root
    local ao = Instance.new("AlignOrientation")
    ao.Name = TG .. "o"
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.Attachment0 = att
    ao.RigidityEnabled = false
    ao.MaxTorque = 1e7
    ao.Responsiveness = 38
    ao.Enabled = false
    ao.Parent = root
    S.fly.rig = { att = att, lv = lv, ao = ao }
    return S.fly.rig
end

local function flyStart()
    local hum, root = S.hum, S.root
    S.fly.on = true
    S.fly.vel = root.AssemblyLinearVelocity
    S.fly.saved = { ps = hum.PlatformStand, ar = hum.AutoRotate }
    S.fly.dir = nil
    notify("Fly on", 1.2)
end

local function flyStop(silent)
    local hum, root = S.hum, S.root
    destroyRig()
    local sv = S.fly.saved
    S.fly.on = false
    S.fly.saved = nil
    if hum and hum.Parent then
        pcall(function()
            hum.PlatformStand = sv and sv.ps or false
            hum.AutoRotate = sv == nil or sv.ar ~= false
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end)
    end
    if root and root.Parent then
        pcall(function() root.AssemblyLinearVelocity = S.fly.vel * 0.35 end)
    end
    S.fly.vel = zero
    if not silent then notify("Fly off", 1.2) end
end

local function flyWish()
    local c = cam()
    if not c then return zero, 0 end
    local fwd, str = axes()
    local cf = c.CFrame
    local look, right = cf.LookVector, cf.RightVector
    if cfg.flyDir == "Flat" then
        look = flat(look) or flat(cf.UpVector) or V3(0, 0, -1)
        right = flat(right) or V3(1, 0, 0)
    end
    local h = look * fwd + right * str
    local up = 0
    if keyDown(cfg.flyUp) or S.btn.up then up = up + 1 end
    if keyDown(cfg.flyDown) or S.btn.down then up = up - 1 end
    return h, up, fwd, str
end

local function flyOrientation(dt)
    local face = cfg.flyFace
    if face == "Off" then return nil end
    local c = cam()
    local v = S.fly.vel
    local d
    if face == "Move" then
        d = flat(v)
        if d and V3(v.X, 0, v.Z).Magnitude < 2 then d = nil end
    else
        d = c and flat(c.CFrame.LookVector)
    end
    d = d or S.fly.dir or lookFlat()
    S.fly.dir = d
    local right = d:Cross(up3)
    local sp = math.max(cfgNum("flySpeed", 60), 1)
    local lean = rad(cfgNum("flyTilt", 20)) * clamp(v:Dot(d) / sp, -1, 1)
    local roll = rad(cfgNum("flyTilt", 20)) * 0.45 * clamp(v:Dot(right) / sp, -1, 1)
    return CFrame.lookAt(zero, d) * CFa(-lean, 0, -roll)
end

local function flyStep(dt)
    local hum, root = S.hum, S.root
    local mode = cfg.flyMode or "Smooth"
    if S.fly.mode ~= mode then
        destroyRig()
        S.fly.mode = mode
    end
    local h, up = flyWish()
    local mul = 1
    if keyDown(cfg.flyBoostKey) then mul = mul * cfgNum("flyBoost", 2.2) end
    if keyDown(cfg.flySlowKey) then mul = mul * cfgNum("flySlow", 0.35) end
    local tgt = h * cfgNum("flySpeed", 60) * mul + V3(0, up * cfgNum("flyVSpeed", 50) * mul, 0)
    local cur = S.fly.vel
    local k = (tgt.Magnitude >= cur.Magnitude - 0.5) and cfgNum("flyAccel", 9) or cfgNum("flyDecel", 12)
    cur = cur:Lerp(tgt, damp(k, dt))
    if tgt.Magnitude < 0.01 and cur.Magnitude < 0.6 then cur = zero end
    S.fly.vel = cur

    local rot = flyOrientation(dt)
    local sv = S.fly.saved or { ps = false, ar = true }
    if cfg.flyAnim == false then
        if not hum.PlatformStand then hum.PlatformStand = true end
    else
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum:GetState() ~= Enum.HumanoidStateType.Freefall then hum:ChangeState(Enum.HumanoidStateType.Freefall) end
    end
    if rot then
        if hum.AutoRotate then hum.AutoRotate = false end
    elseif sv.ar ~= false and not hum.AutoRotate then
        hum.AutoRotate = true
    end

    if mode == "Smooth" then
        local rig = ensureRig(root)
        rig.lv.VectorVelocity = cur
        if rot then
            rig.ao.Enabled = true
            rig.ao.CFrame = rot
        else
            rig.ao.Enabled = false
        end
    elseif mode == "Velocity" then
        destroyRig()
        root.AssemblyLinearVelocity = cur
        root.AssemblyAngularVelocity = zero
        if rot then
            local now = root.CFrame
            local nr = CFrame.fromMatrix(zero, now.RightVector, now.UpVector, -now.LookVector):Lerp(rot, damp(16, dt))
            root.CFrame = CFn(root.Position) * nr
        end
    else
        destroyRig()
        root.AssemblyLinearVelocity = zero
        root.AssemblyAngularVelocity = zero
        local pos = root.Position + cur * dt
        local nr
        if rot then
            local now = root.CFrame
            nr = CFrame.fromMatrix(zero, now.RightVector, now.UpVector, -now.LookVector):Lerp(rot, damp(16, dt))
        else
            local now = root.CFrame
            nr = CFrame.fromMatrix(zero, now.RightVector, now.UpVector, -now.LookVector)
        end
        root.CFrame = CFn(pos) * nr
    end
end

local function hookWalkSpeed(hum)
    if S.ws.hum == hum and S.ws.conn then return end
    if S.ws.conn then pcall(function() S.ws.conn:Disconnect() end) end
    S.ws.hum = hum
    S.ws.conn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if S.ws.mine ~= nil and cfg.msGuard ~= false and hum.WalkSpeed ~= S.ws.mine then
            hum.WalkSpeed = S.ws.mine
        end
    end)
end

local function restoreWalkSpeed()
    local hum = S.hum
    if S.ws.mine ~= nil and hum and hum.Parent and S.ws.base ~= nil then
        S.ws.mine = nil
        pcall(function() hum.WalkSpeed = S.ws.base end)
    end
    S.ws.mine, S.ws.base = nil, nil
end

local function speedTarget()
    local v = cfgNum("msVal", 40)
    if cfg.msSprint == true and keyDown(cfg.msSprintKey) then v = v * cfgNum("msSprintMul", 1.8) end
    return v
end

local function stepMove(delta)
    local root = S.root
    local len = delta.Magnitude
    if len < 1e-4 then return end
    local res = cast(root.Position, delta.Unit * (len + 1.6))
    if res then return end
    root.CFrame = root.CFrame + delta
end

local function speedStep(dt)
    local hum, root = S.hum, S.root
    local on = cfg.msOn == true
    local bonus = (cfg.bhOn == true) and S.bh.bonus or 0
    local mode = cfg.msMode or "WalkSpeed"
    if not on and bonus < 0.01 then
        if S.ws.mine ~= nil then restoreWalkSpeed() end
        S.ms.f = 0
        return
    end
    if S.ms.mode ~= mode then
        if S.ws.mine ~= nil then restoreWalkSpeed() end
        S.ms.mode = mode
    end
    local target = (on and speedTarget() or 0) + bonus
    if not on then mode = "WalkSpeed" end
    if mode == "WalkSpeed" then
        if S.ws.base == nil then S.ws.base = hum.WalkSpeed end
        if not on then target = S.ws.base + bonus end
        hookWalkSpeed(hum)
        if cfg.msGuard ~= false or S.ws.mine ~= target then
            S.ws.mine = target
            if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
        end
        return
    end
    local md, moving = moveDir()
    local want = moving and 1 or 0
    S.ms.f = S.ms.f + (want - S.ms.f) * damp(cfgNum("msAccel", 16), dt)
    if S.ms.f < 0.01 then return end
    if mode == "CFrame" then
        local extra = target - hum.WalkSpeed
        if extra > 0 and moving then stepMove(md * extra * S.ms.f * dt) end
    else
        if moving then
            local v = root.AssemblyLinearVelocity
            local hv = md * target * S.ms.f
            root.AssemblyLinearVelocity = V3(hv.X, v.Y, hv.Z)
        end
    end
end

local function bhopStep(dt, now)
    local hum, root = S.hum, S.root
    local g = grounded()
    if cfg.bhOn ~= true then
        S.bh.bonus = math.max(0, S.bh.bonus - 90 * dt)
        S.bh.was = g
        return
    end
    if g and jumpHeld() then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    if S.bh.was and not g and root.AssemblyLinearVelocity.Y > 6 and now - S.bh.lastJump > 0.12 then
        S.bh.lastJump = now
        S.bh.bonus = math.min(cfgNum("bhMax", 34), S.bh.bonus + cfgNum("bhGain", 1.4))
    end
    if g and now - S.bh.lastJump > 0.4 then
        S.bh.bonus = math.max(0, S.bh.bonus - 60 * dt)
    end
    S.bh.was = g
end

local function jumpPowerStep()
    local hum = S.hum
    if cfg.jpOn == true then
        local p = cfgNum("jpVal", 90)
        if hum.UseJumpPower then
            if S.jp.base == nil then S.jp.base = hum.JumpPower end
            if hum.JumpPower ~= p then hum.JumpPower = p end
            S.jp.mine = "p"
        else
            if S.jp.base == nil then S.jp.base = hum.JumpHeight end
            local hgt = p * p / (2 * Workspace.Gravity)
            if abs(hum.JumpHeight - hgt) > 0.01 then hum.JumpHeight = hgt end
            S.jp.mine = "h"
        end
    elseif S.jp.mine ~= nil then
        pcall(function()
            if S.jp.mine == "p" then hum.JumpPower = S.jp.base else hum.JumpHeight = S.jp.base end
        end)
        S.jp.mine, S.jp.base = nil, nil
    end
end

local function jumpVelocity()
    local hum = S.hum
    if hum.UseJumpPower then return hum.JumpPower end
    return sqrt(2 * Workspace.Gravity * hum.JumpHeight)
end

local function onJumpRequest()
    if cfg.ijOn ~= true or not refresh() then return end
    if S.fly.on or grounded() then return end
    local now = os.clock()
    if now - S.ij.last < cfgNum("ajDelay", 0.1) then return end
    local max = floor(cfgNum("ajCount", 0) + 0.5)
    if max > 0 and S.ij.used >= max then return end
    S.ij.used = S.ij.used + 1
    S.ij.last = now
    local v = S.root.AssemblyLinearVelocity
    S.root.AssemblyLinearVelocity = V3(v.X, jumpVelocity() * cfgNum("ajPower", 1), v.Z)
    S.hum:ChangeState(Enum.HumanoidStateType.Jumping)
end

local function doDash()
    if cfg.dshOn ~= true or not refresh() then return end
    local now = os.clock()
    if now - S.dash.last < cfgNum("dshCd", 1.2) then return end
    S.dash.last = now
    local d = moveDir()
    if d.Magnitude < 0.05 then d = lookFlat() end
    S.dash.dir = d
    S.dash.t0 = now
    S.dash.dur = clamp(cfgNum("dshForce", 80) / 420, 0.14, 0.32)
    local v = S.root.AssemblyLinearVelocity
    S.root.AssemblyLinearVelocity = V3(d.X * cfgNum("dshForce", 80), math.max(v.Y, 0) + cfgNum("dshUp", 8), d.Z * cfgNum("dshForce", 80))
    S.hum:ChangeState(Enum.HumanoidStateType.Jumping)
end

local function dashStep(now)
    if S.dash.t0 < 0 then return end
    local u = (now - S.dash.t0) / S.dash.dur
    if u >= 1 then S.dash.t0 = -10; return end
    local root = S.root
    local f = cfgNum("dshForce", 80) * (1 - u * 0.45)
    local v = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = V3(S.dash.dir.X * f, v.Y, S.dash.dir.Z * f)
end

local function glideStep(dt)
    local root = S.root
    local v = root.AssemblyLinearVelocity
    if cfg.gldOn == true and not S.fly.on and not grounded() and jumpHeld() and v.Y < 0 then
        local fall = cfgNum("gldFall", 9)
        local ny = v.Y
        if v.Y < -fall then ny = v.Y + (-fall - v.Y) * damp(14, dt) end
        local md, moving = moveDir()
        local d = moving and md or lookFlat()
        local h = V3(v.X, 0, v.Z):Lerp(d * cfgNum("gldSpeed", 30), damp(3, dt))
        root.AssemblyLinearVelocity = V3(h.X, ny, h.Z)
        S.gld.on = true
    else
        S.gld.on = false
    end
end

local function climbStep(dt)
    local root = S.root
    if cfg.clbOn ~= true or S.fly.on then S.clb.on, S.clb.was = false, false; return end
    local look = flat(root.CFrame.LookVector)
    if not look then return end
    local res = cast(root.Position, look * 2.6)
    local md, moving = moveDir()
    local pushing = (moving and md:Dot(look) > 0.35) or keyDown("Space")
    if res and pushing then
        local n = res.Normal
        root.AssemblyLinearVelocity = V3(-n.X * 6, cfgNum("clbSpeed", 28), -n.Z * 6)
        S.clb.on, S.clb.was = true, true
    else
        if S.clb.was and not res then
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = V3(look.X * 14, math.max(v.Y, 16), look.Z * 14)
        end
        S.clb.on, S.clb.was = false, false
    end
end

local function softLandStep()
    local root = S.root
    local v = root.AssemblyLinearVelocity
    if v.Y < -40 then
        local res = cast(root.Position, V3(0, -(-v.Y * 0.12 + 4), 0))
        if res then root.AssemblyLinearVelocity = V3(v.X, -18, v.Z) end
    end
end

local function gravityStep()
    if cfg.grvOn == true then
        if S.gv.base == nil then S.gv.base = Workspace.Gravity end
        local g = cfgNum("grvVal", 196.2)
        if Workspace.Gravity ~= g then Workspace.Gravity = g end
    elseif S.gv.base ~= nil then
        Workspace.Gravity = S.gv.base
        S.gv.base = nil
    end
end

local function freezeStep()
    local root = S.root
    if cfg.frzOn == true then
        if not S.fr.on then S.fr.on = true end
        if not root.Anchored then root.Anchored = true end
    elseif S.fr.on then
        S.fr.on = false
        root.Anchored = false
    end
end

local function spinStep(dt)
    if cfg.spnOn ~= true then return end
    if S.fly.on and (cfg.flyFace or "Camera") ~= "Off" and (cfg.flyMode or "Smooth") == "Smooth" then return end
    local root = S.root
    root.CFrame = root.CFrame * CFa(0, rad(cfgNum("spnSpeed", 360)) * dt, 0)
end

local function killPlatform()
    if S.plat.part then pcall(function() S.plat.part:Destroy() end) end
    S.plat.part, S.plat.y = nil, nil
end

local function platformStep(dt)
    local root, hum = S.root, S.hum
    if cfg.pltOn ~= true then
        if S.plat.part then killPlatform() end
        return
    end
    local c = cam()
    if not (S.plat.part and S.plat.part.Parent) then
        local p = Instance.new("Part")
        p.Name = TG .. "p"
        p.Anchored = true
        p.CanCollide = true
        p.CanTouch = false
        p.CastShadow = false
        p.Material = Enum.Material.Neon
        p.Size = V3(7, 0.5, 7)
        p.Parent = c or Workspace
        S.plat.part = p
        S.plat.y = root.Position.Y - (hum.HipHeight + root.Size.Y / 2) - 0.3
    end
    local p = S.plat.part
    if keyDown(cfg.flyUp) then S.plat.y = S.plat.y + 16 * dt end
    if keyDown(cfg.flyDown) then S.plat.y = S.plat.y - 16 * dt end
    local c1 = themeCol()
    p.Color = c1
    p.Transparency = (cfg.pltVis ~= false) and 0.55 or 1
    p.CFrame = CFn(root.Position.X, S.plat.y - 0.25, root.Position.Z)
end

local function spawnCF()
    local sp = lp.RespawnLocation
    if sp and sp.Parent then return sp.CFrame + V3(0, sp.Size.Y / 2 + 4, 0) end
    local sl = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    if sl then return sl.CFrame + V3(0, sl.Size.Y / 2 + 4, 0) end
    return nil
end

local function tpInstant(cf)
    local root = S.root
    root.CFrame = cf
    root.AssemblyLinearVelocity = zero
    root.AssemblyAngularVelocity = zero
end

local function tpGo(cf, tween, dur)
    if not refresh() then return end
    if tween then
        S.tw = { from = S.root.CFrame, to = cf, t0 = os.clock(), dur = math.max(dur or 0.5, 0.05) }
    else
        S.tw = nil
        tpInstant(cf)
    end
end

local function tweenStep(now)
    local t = S.tw
    if not t then return end
    local u = clamp((now - t.t0) / t.dur, 0, 1)
    local e = u * u * (3 - 2 * u)
    local root = S.root
    root.CFrame = t.from:Lerp(t.to, e)
    root.AssemblyLinearVelocity = zero
    if u >= 1 then S.tw = nil end
end

local function ringFx(pos, normal)
    local c1, c2 = themeCol()
    local p = Instance.new("Part")
    p.Name = TG .. "r"
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Shape = Enum.PartType.Cylinder
    p.Color = c1
    p.Transparency = 0.2
    p.Size = V3(0.12, 1, 1)
    p.CFrame = CFrame.lookAt(pos + normal * 0.08, pos + normal) * CFa(0, rad(90), 0)
    p.Parent = cam() or Workspace
    local ti = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    pcall(function()
        TweenService:Create(p, ti, { Size = V3(0.12, 7, 7), Transparency = 1, Color = c2 }):Play()
    end)
    task.delay(0.7, function() pcall(function() p:Destroy() end) end)
end

local function clickTeleport(input)
    if cfg.ctpOn ~= true or not refresh() then return end
    if (cfg.ctpMode or "Key + click") == "Key + click" and not keyDown(cfg.ctpKey) then return end
    local c = cam()
    if not c then return end
    local ray
    if input.UserInputType == Enum.UserInputType.Touch then
        ray = c:ScreenPointToRay(input.Position.X, input.Position.Y)
    else
        local m = UIS:GetMouseLocation()
        ray = c:ViewportPointToRay(m.X, m.Y)
    end
    local res = cast(ray.Origin, ray.Direction * 3000)
    if not res then return end
    local dest = res.Position + V3(0, cfgNum("ctpUp", 3), 0)
    local look = flat(S.root.CFrame.LookVector) or V3(0, 0, -1)
    ringFx(res.Position, res.Normal)
    tpGo(CFrame.lookAt(dest, dest + look), cfg.ctpStyle == "Tween", cfgNum("ctpTime", 0.5))
end

local function playerList()
    local out = { "Nearest" }
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then names[#names + 1] = p.Name end
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    for _, n in ipairs(names) do out[#out + 1] = n end
    return out
end

local function targetRoot()
    local name = cfg.tpPlayer
    if name == nil or name == "Nearest" then
        local best, bd
        for _, p in ipairs(Players:GetPlayers()) do
            local ch = p ~= lp and p.Character
            local r = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
            if r then
                local d = (r.Position - S.root.Position).Magnitude
                if not bd or d < bd then best, bd = r, d end
            end
        end
        return best, best and best.Parent
    end
    local p = Players:FindFirstChild(name)
    local ch = p and p.Character
    local r = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
    return r, ch
end

local function refreshPlayers(quiet)
    local list = playerList()
    local ctl = Z.players
    if ctl then
        ctl:SetOptions(list)
        local ok = false
        for _, n in ipairs(list) do if n == cfg.tpPlayer then ok = true end end
        if not ok then ctl:Set("Nearest", true) end
    end
    if not quiet then notify("Players: " .. (#list - 1), 1.5) end
end

local function tpToPlayer()
    if not refresh() then return end
    local r = targetRoot()
    if not r then notify("No player to teleport to", 2); return end
    local cf = r.CFrame * CFn(0, 0, 4)
    tpGo(CFrame.lookAt(cf.Position, r.Position), cfg.ctpStyle == "Tween", cfgNum("ctpTime", 0.5))
end

local function slotIndex()
    local n = tostring(cfg.tpSlot or "Spot 1"):match("%d+")
    return tonumber(n) or 1
end

local function saveSpot()
    if not refresh() then return end
    local p = S.root.Position
    local i = slotIndex()
    S.slots[i] = S.root.CFrame
    notify(("Spot %d saved (%d, %d, %d)"):format(i, floor(p.X + 0.5), floor(p.Y + 0.5), floor(p.Z + 0.5)), 2)
end

local function goSpot()
    if not refresh() then return end
    local cf = S.slots[slotIndex()]
    if not cf then notify("Spot " .. slotIndex() .. " is empty", 2); return end
    tpGo(cf, cfg.ctpStyle == "Tween", cfgNum("ctpTime", 0.5))
end

local function goSpawn()
    if not refresh() then return end
    local cf = spawnCF()
    if not cf then notify("No spawn point found", 2); return end
    tpGo(cf, cfg.ctpStyle == "Tween", cfgNum("ctpTime", 0.5))
end

local function followStep(dt)
    S.fol.active = false
    if cfg.tpFollow ~= true then return end
    local r = targetRoot()
    if not r then return end
    local style, dist = cfg.tpStyle or "Behind", cfgNum("tpDist", 7)
    local pos
    if style == "Above" then
        pos = r.Position + V3(0, dist, 0)
    elseif style == "Orbit" then
        S.fol.ang = (S.fol.ang + cfgNum("tpOrbit", 1.4) * dt) % (math.pi * 2)
        pos = r.Position + V3(math.cos(S.fol.ang) * dist, 1.5, math.sin(S.fol.ang) * dist)
    else
        pos = (r.CFrame * CFn(0, 0, dist)).Position
    end
    S.fol.active = true
    local root = S.root
    if (pos - r.Position).Magnitude < 0.05 then return end
    root.CFrame = CFrame.lookAt(pos, r.Position)
    root.AssemblyLinearVelocity = zero
end

local function viewStep()
    local c = cam()
    if not c then return end
    if cfg.tpView == true then
        local r, ch = targetRoot()
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        if h and c.CameraSubject ~= h then c.CameraSubject = h; S.view.on = true end
    elseif S.view.on then
        S.view.on = false
        if S.hum then c.CameraSubject = S.hum end
    end
end

local function voidStep(now)
    local root = S.root
    local trig = Workspace.FallenPartsDestroyHeight + cfgNum("vdMargin", 120)
    if grounded() and root.Position.Y > trig + 20 and now - S.safe.t > 0.5 and S.tw == nil then
        S.safe.t = now
        S.safe.cf = root.CFrame
    end
    if cfg.vdOn ~= true then return end
    if root.Position.Y < trig and now - S.safe.kick > 1 then
        S.safe.kick = now
        local cf = (cfg.vdTo == "Spawn" and spawnCF()) or S.safe.cf or spawnCF()
        if cf then
            S.tw = nil
            tpInstant(cf + V3(0, 3, 0))
            notify("Anti-void: pulled back", 2)
        end
    end
end

local function mkGui()
    local g = Instance.new("ScreenGui")
    g.Name = HttpService:GenerateGUID(false):sub(1, 10)
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    g.DisplayOrder = 997
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(g) end end)
    local ok = pcall(function() g.Parent = (gethui and gethui()) or svc("CoreGui") end)
    if not ok or not g.Parent then g.Parent = lp:WaitForChild("PlayerGui") end
    return g
end

local function hudBuild()
    local H = S.hud
    if H.gui and H.gui.Parent then return end
    local T = UIX.T
    H.gui = mkGui()
    local pill = Instance.new("Frame")
    pill.Name = TG .. "pill"
    pill.AnchorPoint = Vector2.new(0.5, 1)
    pill.Position = UDim2.new(0.5, 0, 1, -96)
    pill.Size = UDim2.fromOffset(0, 32)
    pill.AutomaticSize = Enum.AutomaticSize.X
    pill.BackgroundColor3 = T.panel
    pill.BackgroundTransparency = 0.12
    pill.BorderSizePixel = 0
    pill.Visible = false
    pill.Parent = H.gui
    UIX.corner(pill, 16)
    H.stroke = UIX.stroke(pill, T.acc, 1.2, 0.5)
    UIX.pad(pill, 6, 0, 6, 0)
    local lay = Instance.new("UIListLayout")
    lay.FillDirection = Enum.FillDirection.Horizontal
    lay.VerticalAlignment = Enum.VerticalAlignment.Center
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Padding = UDim.new(0, 6)
    lay.Parent = pill
    H.pill = pill
    for i = 1, 8 do
        local f = Instance.new("Frame")
        f.Size = UDim2.fromOffset(0, 22)
        f.AutomaticSize = Enum.AutomaticSize.X
        f.BackgroundColor3 = T.panel2
        f.BackgroundTransparency = 0.1
        f.BorderSizePixel = 0
        f.LayoutOrder = i
        f.Visible = false
        f.Parent = pill
        UIX.corner(f, 11)
        UIX.pad(f, 9, 0, 9, 0)
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.fromOffset(0, 22)
        l.AutomaticSize = Enum.AutomaticSize.X
        l.Font = Enum.Font.GothamBold
        l.TextSize = 11
        l.TextColor3 = T.text
        l.Text = ""
        l.Parent = f
        H.chips[i] = { f = f, l = l }
    end
    local function mkBtn(name, x, y, iconName, rot, down, up)
        local b = Instance.new("TextButton")
        b.Name = TG .. name
        b.AnchorPoint = Vector2.new(1, 0.5)
        b.Position = UDim2.new(1, x, 0.5, y)
        b.Size = UDim2.fromOffset(50, 50)
        b.BackgroundColor3 = T.panel
        b.BackgroundTransparency = 0.18
        b.Text = ""
        b.AutoButtonColor = false
        b.BorderSizePixel = 0
        b.Visible = false
        b.Parent = H.gui
        UIX.corner(b, 25)
        UIX.stroke(b, T.acc, 1.4, 0.45)
        local ic = UIX.icon(b, iconName, 22, "text")
        ic.AnchorPoint = Vector2.new(0.5, 0.5)
        ic.Position = UDim2.fromScale(0.5, 0.5)
        ic.Rotation = rot
        b.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then down() end
        end)
        b.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then up() end
        end)
        return b
    end
    H.bUp = mkBtn("bu", -22, -34, "ic_jump", 0, function() S.btn.up = true end, function() S.btn.up = false end)
    H.bDown = mkBtn("bd", -22, 26, "ic_jump", 180, function() S.btn.down = true end, function() S.btn.down = false end)
    H.bDash = mkBtn("bs", -22, 92, "ic_speed", 0, function() doDash() end, function() end)
end

local function hudStep(dt, now)
    local H = S.hud
    local wantPill = cfg.mvHud ~= false
    local wantBtns = cfg.mvBtns == true
    if not (wantPill or wantBtns) then
        if H.gui then H.gui.Enabled = false end
        return
    end
    if not (H.gui and H.gui.Parent) then hudBuild() end
    H.gui.Enabled = true
    local T = UIX.T
    local flying = S.fly.on
    H.bUp.Visible = wantBtns and flying
    H.bDown.Visible = wantBtns and flying
    H.bDash.Visible = wantBtns and cfg.dshOn == true
    H.acc = H.acc + dt
    if H.acc < 0.1 then return end
    H.acc = 0
    local items = {}
    if flying then items[#items + 1] = { "FLY  " .. floor(S.fly.vel.Magnitude + 0.5), true } end
    if cfg.msOn == true then
        local t = speedTarget() + ((cfg.bhOn == true) and S.bh.bonus or 0)
        items[#items + 1] = { "SPEED  " .. floor(t + 0.5), true }
    elseif cfg.bhOn == true and S.bh.bonus > 0.5 then
        items[#items + 1] = { "BHOP  +" .. floor(S.bh.bonus + 0.5), true }
    end
    if S.nc.on then items[#items + 1] = { "NOCLIP", true } end
    if S.gld.on then items[#items + 1] = { "GLIDE", true } end
    if S.clb.on then items[#items + 1] = { "CLIMB", true } end
    if cfg.dshOn == true then
        local left = cfgNum("dshCd", 1.2) - (now - S.dash.last)
        items[#items + 1] = { left > 0 and ("DASH  " .. ("%.1f"):format(left)) or "DASH  ready", left <= 0 }
    end
    if cfg.ctpOn == true then items[#items + 1] = { "CLICK TP", true } end
    if cfg.grvOn == true then items[#items + 1] = { "GRAV  " .. floor(cfgNum("grvVal", 196.2) + 0.5), true } end
    if cfg.vdOn == true then items[#items + 1] = { "VOID GUARD", true } end
    H.pill.Visible = wantPill and #items > 0
    H.stroke.Color = T.acc
    H.pill.BackgroundColor3 = T.panel
    for i, c in ipairs(H.chips) do
        local it = items[i]
        c.f.Visible = it ~= nil
        if it then
            c.l.Text = it[1]
            c.l.TextColor3 = it[2] and T.acc or T.dim
            c.f.BackgroundColor3 = T.panel2
        end
    end
end

local function sub(tag, fn, ...)
    local ok, e = pcall(fn, ...)
    if not ok then warnOnce(tag, e) end
end

local function tick(dt)
    if S.dead then return end
    if not refresh() then return end
    local now = os.clock()
    sub("props", function()
        gravityStep()
        jumpPowerStep()
        speedStep(dt)
        bhopStep(dt, now)
    end)
    sub("tween", tweenStep, now)
    sub("follow", followStep, dt)
    local wantFly = cfg.flyOn == true and S.tw == nil
    if wantFly and not S.fly.on then sub("fly", flyStart) elseif not wantFly and S.fly.on then sub("fly", flyStop) end
    if S.fly.on then sub("fly", flyStep, dt) end
    sub("noclip", noclipStep)
    sub("dash", dashStep, now)
    sub("glide", glideStep, dt)
    sub("climb", climbStep, dt)
    if cfg.noFall == true then sub("land", softLandStep) end
    if grounded() then S.ij.used = 0 end
    sub("freeze", freezeStep)
    sub("spin", spinStep, dt)
    sub("plat", platformStep, dt)
    sub("view", viewStep)
    sub("void", voidStep, now)
end

local started = false
local function start()
    if started then return end
    started = true
    bind(RunService.Stepped, function(_, dt) tick(dt or 0.016) end)
    bind(UIS.JumpRequest, function() sub("jump", onJumpRequest) end)
    bind(UIS.InputBegan, function(i, gp)
        if gp then return end
        if i.UserInputType == Enum.UserInputType.Keyboard then
            if cfg.dshOn == true and i.KeyCode.Name == cfg.dshKey then sub("dash", doDash) end
        elseif i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sub("ctp", clickTeleport, i)
        end
    end)
    bind(UIS.InputChanged, function(i)
        if i.UserInputType == Enum.UserInputType.MouseWheel and S.fly.on and cfg.flyWheel ~= false then
            local f = Flags.flySpeed
            if f then
                local v = cfgNum("flySpeed", 60)
                f:Set(clamp(v * (1 + 0.1 * (i.Position.Z > 0 and 1 or -1)), 5, 400))
            end
        end
    end)
    bind(Players.PlayerAdded, function() task.delay(0.3, function() refreshPlayers(true) end) end)
    bind(Players.PlayerRemoving, function() task.delay(0.1, function() refreshPlayers(true) end) end)
end

function M.step(dt)
    if S.dead then return end
    local ok, e = pcall(hudStep, dt, os.clock())
    if not ok then warnOnce("hud", e) end
end

local function resetAll()
    for _, k in ipairs({ "flyOn", "msOn", "bhOn", "jpOn", "ijOn", "dshOn", "gldOn", "clbOn", "noFall", "ncOn", "frzOn", "grvOn", "spnOn", "pltOn", "ctpOn", "tpFollow", "tpView", "vdOn" }) do
        local f = Flags[k]
        if f and f.Set then f:Set(false) else cfg[k] = false end
    end
    notify("Movement: everything off", 1.8)
end

local gravPresets = { Moon = 32.7, Mars = 73, Earth = 196.2, Heavy = 400, Zero = 0 }

function M.buildTab()
    local tab = UITab("Movement", "ic_movement", nil)
    local zz = buildMoveUI(tab, {
        refresh = function() refreshPlayers(false) end,
        tpPlayer = tpToPlayer, save = saveSpot, go = goSpot, spawn = goSpawn, reset = resetAll,
        gravPreset = function(v)
            local g = gravPresets[v]
            if g and Z.gravSlider then Z.gravSlider:Set(g) end
        end,
    })
    Z.players, Z.gravSlider, Z.gravPreset = zz.players, zz.gravSlider, zz.gravPreset
    if touchOnly and Flags.mvBtns then Flags.mvBtns:Set(true, true) end
    refreshPlayers(true)
    start()
    M.tab = tab
    return tab
end

function M.status()
    local parts = {}
    if S.fly.on then parts[#parts + 1] = "fly" end
    if S.ws.mine ~= nil then parts[#parts + 1] = "speed" end
    if S.nc.on then parts[#parts + 1] = "noclip" end
    if S.gld.on then parts[#parts + 1] = "glide" end
    if S.clb.on then parts[#parts + 1] = "climb" end
    return #parts > 0 and table.concat(parts, ", ") or "idle"
end

M.api = { doDash = doDash, tpToPlayer = tpToPlayer, saveSpot = saveSpot, goSpot = goSpot, goSpawn = goSpawn, tpGo = tpGo, refreshPlayers = refreshPlayers, resetAll = resetAll,
    onJumpRequest = onJumpRequest, clickTeleport = clickTeleport, spawnCF = spawnCF, tick = tick }

function M.cleanup()
    S.dead = true
    pcall(function()
        if S.fly.on and S.hum and S.hum.Parent then flyStop(true) end
        destroyRig()
        restoreWalkSpeed()
        if S.jp.mine ~= nil and S.hum then
            if S.jp.mine == "p" then S.hum.JumpPower = S.jp.base else S.hum.JumpHeight = S.jp.base end
        end
        if S.gv.base ~= nil then Workspace.Gravity = S.gv.base; S.gv.base = nil end
        restoreNoclip()
        if S.fr.on and S.root then S.root.Anchored = false end
        killPlatform()
        local c = cam()
        if S.view.on and c and S.hum then c.CameraSubject = S.hum end
        if S.ws.conn then S.ws.conn:Disconnect() end
        if S.hud.gui then S.hud.gui:Destroy() end
    end)
end

return M
end)()
