local function roleColor(role, c1, c2)
    if role == "blade" then return c1:Lerp(Color3.new(1, 1, 1), 0.78)
    elseif role == "glow" then return c1:Lerp(Color3.new(1, 1, 1), 0.2)
    elseif role == "gold" then return c2:Lerp(GOLD, 0.6)
    elseif role == "grip" then return c1:Lerp(Color3.new(0, 0, 0), 0.82)
    elseif role == "crystal" then return c1
    elseif role == "core" then return c2:Lerp(Color3.new(1, 1, 1), 0.5)
    elseif role == "shell" then return c1:Lerp(Color3.new(1, 1, 1), 0.25)
    end
    return c1
end

