        b.P({ of = root, cf = CF(tp), shape = "s", size = V3(0.14, 0.14, 0.14) * k, col = "b", mat = "g" })
        rim[#rim + 1] = tp
        local nx = o.tips[i + 1]
        if nx then
            local m = (tp + nx * k) / 2
            rim[#rim + 1] = m + (W - m).Unit * ins
        end
    end
    local last = o.tips[#o.tips] * k
    local m = (last + Ba) / 2
    rim[#rim + 1] = m + (W - m).Unit * ins
    rim[#rim + 1] = Ba
    for i = 1, #rim - 1 do
