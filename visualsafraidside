local function plumeFan(r)
    local list = {}
    for i = 1, r.n do
        local f = (r.n == 1) and 0.5 or (i - 1) / (r.n - 1)
        local c = 2 * f - 1
        local len = (r.l0 + r.bump * (1 - c * c) ^ (r.pw or 1)) * (1 + 0.05 * sin(i * 12.9898 + r.z * 40))
        local ang = -90 + c * r.spread + 2 * sin(i * 5.11 + r.z * 17)
        list[i] = { c * r.ox, 0.05 * (1 - c * c) - r.z * 0.4, r.z + (i - 1) * 0.004, ang, len, r.w * (1 + 0.08 * sin(i * 4.37 + r.z * 23)), c * r.bend, r.cup or 0.2, r.p or 1.8, r.q or 0.8,
            r.skew or 0.12, r.lod or 1, 0.02, 0.3 }
    end
    return list
end

