    local function ghostOf(char, col, tr)
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local base = hrp.CFrame
        local list = {}
        for _, d in ipairs(char:GetChildren()) do
            if d:IsA("BasePart") and d ~= hrp and d.Transparency < 0.9 and d.Size.Magnitude < 12 and #list < 20 then
                local g = np({ Color = col, Transparency = tr, Size = d.Size * 0.96, CFrame = d.CFrame, Material = Enum.Material.ForceField })
                list[#list + 1] = { p = g, rel = base:ToObjectSpace(d.CFrame) }
            end
        end
        if #list == 0 then return nil end
        return { list = list, rot = CF(base.Position):Inverse() * base }
    end

