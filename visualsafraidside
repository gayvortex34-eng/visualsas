local CIRCLE_PAL = { Magic = { 268, 0.55 }, Rune = { 305, 0.6 }, Ring = { 200, 0.5 }, Frost = { 190, 0.4 }, Afraid = { 272, 0.6 }, Vortex = { 205, 0.5 }, Bloom = { 330, 0.5 } }

local function anchoredPart(pos, size, cf)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
    p.Size = size or Vector3.new(0.2, 0.2, 0.2)
    p.Transparency = 1
    p.CFrame = cf or CFrame.new(pos)
    p.Parent = fxFolder()
    return p
end

local function oneEmitter(att, props)
    local pe = Instance.new("ParticleEmitter")
    pe.Name = TAG .. "pe"
    pe.Rate = 0
    applyProps(pe, props)
    pe.Parent = att
    return pe
end

local function spawnCircle(pos, o)
    o = o or {}
    local style = o.style or cfg.circleStyle
    local texs = CIRCLE_TEX[style] or CIRCLE_TEX.Magic
    local life = clamp(o.life or cfg.circleLife, 0.6, 30)
    local size = (o.size or cfg.circleSize) * 1.6
    local grow = clamp((o.grow or cfg.circleGrow) / 100, 1, 8)
    local spin = o.spin or cfg.circleSpin
    local pal = CIRCLE_PAL[style] or CIRCLE_PAL.Magic
    local c1 = o.color or hsv(pal[1], pal[2], 1)
    local c2 = c1:Lerp(WHITE, 0.45)
    local cf
    if cfg.fxGround ~= false then
        local gp, gn = FX.groundFit(pos - Vector3.new(0, 0.1, 0), size * 0.5)
        if gp then
            cf = FX.groundCF(gp + gn * 0.06, gn, Vector3.new(0, 0, -1))
            pos = gp + gn * 0.06
        end
    end
    local part = anchoredPart(pos, nil, cf)
    local att = Instance.new("Attachment")
    att.Parent = part
    local function layer(tex, mul, dir, a)
        local pe = oneEmitter(att, flat({
            Texture = TX(tex), Lifetime = NumberRange.new(life), LockedToPart = false,
            Size = NS(K(0, size * mul * 0.3), K(0.1, size * mul), K(1, size * mul * grow)),
            Transparency = NS(K(0, 1), K(0.06, 1 - a), K(0.55, 1 - a * 0.85), K(1, 1)),
            Color = seq2(c2, c1), RotSpeed = NumberRange.new(dir * spin), Rotation = NumberRange.new(0, 360), LightEmission = 1,
            LightInfluence = 0, ZOffset = 0.02,
        }))
        pcall(function() pe:Emit(1) end)
    end
    layer(texs[2], 1.45, 0, 0.5)
    layer(texs[1], 1, 1, 0.95)
    if style == "Magic" or style == "Rune" or style == "Frost" then layer("ring", 0.62, -1, 0.7) end
    local sp = oneEmitter(att, glowy({
        Texture = TX("spark"), Lifetime = NumberRange.new(0.8, 1.6), Speed = NumberRange.new(2, 7), SpreadAngle = Vector2.new(80, 80),
        Size = NS(K(0, 0.6), K(1, 0)), Transparency = NS(K(0, 0), K(1, 1)), Color = seq2(c2, c1), Acceleration = Vector3.new(0, 3, 0),
        Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-120, 120),
    }))
    pcall(function() sp:Emit(math.floor(10 + size * 2)) end)
    Debris:AddItem(part, life + 1.2)
    return part
end

local KILL_STYLES = { "Neon Burst", "Soul Ascend", "Disintegrate", "Shatter", "Sakura Burst", "Lightning Strike", "Blood Mist", "Slash X", "Soul Harvest", "Supernova", "Dark Ritual" }
FX.KILL_STYLES = KILL_STYLES

local killFx = (function()
    local V3, CF, ANGc = Vector3.new, CFrame.new, CFrame.Angles
    local PI = math.pi
    local ORI_VEL = Enum.ParticleOrientation.VelocityParallel

    local ANIM = {}
    FX.anims = ANIM
    local function anim(dur, fn, done)
        ANIM[#ANIM + 1] = { t = 0, dur = math.max(dur, 0.05), fn = fn, done = done }
    end
    function FX.animStep(dt)
        local i = 1
        while i <= #ANIM do
            local a = ANIM[i]
            a.t = a.t + dt
            local u = math.min(a.t / a.dur, 1)
            local ok = pcall(a.fn, u, a.t, dt)
            if u >= 1 or not ok then
                if a.done then pcall(a.done) end
                table.remove(ANIM, i)
            else
                i = i + 1
            end
        end
    end
    function FX.animClear()
        for i = #ANIM, 1, -1 do ANIM[i] = nil end
    end

    local function eo3(u) local v = 1 - u; return 1 - v * v * v end
    local function eo2(u) return 1 - (1 - u) * (1 - u) end
    local function ei2(u) return u * u end
    local function eio(u) return u * u * (3 - 2 * u) end
    local function eob(u) local v = u - 1; return 1 + 2.70158 * v * v * v + 1.70158 * v * v end
    local function seg(u, a, b) return clamp((u - a) / math.max(b - a, 1e-4), 0, 1) end
    local function mix(a, b, k) return a + (b - a) * k end
    local function gm() return clamp(Gov.fxMul or 1, 0.3, 1) end
    local function cnt(n) return math.max(1, math.floor(n * gm() + 0.5)) end
    local function later(t, fn) if t and t > 0 then task.delay(t, fn) else fn() end end

    local LIVE = 0

    local function np(props, class)
        local p = Instance.new(class or "Part")
        p.Name = TAG .. "kf"
        p.Anchored = true
        p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
        p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        p.Material = Enum.Material.Neon
        for k, v in pairs(props) do p[k] = v end
        p.Parent = fxFolder()
        Debris:AddItem(p, 9)
        return p
    end
    local function kill(p) if p then pcall(function() p:Destroy() end) end end

    local function emitOn(parent, props, n)
        if props.ZOffset == nil and props.Orientation == nil and props.Size then
            local okm, m = pcall(function()
                local top = 0
                for _, k in ipairs(props.Size.Keypoints) do if k.Value > top then top = k.Value end end
                return top
            end)
            if okm and m > 5 then props.ZOffset = math.min(m * 0.15, 5) end
        end
        local pe = oneEmitter(parent, props)
        if n and n > 0 then pcall(function() pe:Emit(n) end) end
        return pe
    end

    local function holder(cf)
        local p = np({ Transparency = 1, Size = V3(0.2, 0.2, 0.2), CFrame = cf, Material = Enum.Material.SmoothPlastic })
        local a = Instance.new("Attachment")
        a.Parent = p
        return p, a
    end

    local function groundOf(pos, fy)
        local G, n = pos - V3(0, fy - 0.12, 0), V3(0, 1, 0)
        if cfg.fxGround ~= false and FX.groundFit then
            local ok, gp, gn = pcall(FX.groundFit, G + V3(0, 0.4, 0), 8)
            if ok and gp and pos.Y - gp.Y < 30 then G, n = gp + gn * 0.05, gn end
        end
        local cf = CF(G)
        if FX.groundCF then
            local ok, r = pcall(FX.groundCF, G, n, V3(0, 0, -1))
            if ok and r then cf = r end
        end
        return G, n, cf
    end

    local function bodyParts(char)
        local out = {}
        if not char then return out end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.98 and #out < 60 then out[#out + 1] = d end
        end
        return out
    end
    local function fadeParts(parts, from, to, k)
        for i, d in ipairs(parts) do
            if d.Parent then
                local tr = mix(from[i], to, k)
                d.Transparency = tr
                if k >= 0.98 then
                    for _, c in ipairs(d:GetChildren()) do
                        if c:IsA("Decal") or c:IsA("Texture") then pcall(function() c.Transparency = 1 end) end
                    end
                end
            end
        end
    end

    local function context(pos, char)
        local x = { P = pos, char = char, S = clamp(cfg.killScale or 1, 0.4, 2.5) }
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local fy = 3
        if hum and hrp then fy = (hum.RigType == Enum.HumanoidRigType.R6) and 3 or (hum.HipHeight + hrp.Size.Y / 2) end
        x.G, x.gn, x.gcf = groundOf(pos, fy)
        x.c = hsv(cfg.killH, cfg.killS, 1)
        x.cw = x.c:Lerp(WHITE, 0.6)
