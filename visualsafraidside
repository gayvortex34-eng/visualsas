local function stepL(c, k)
    local v = c.want()
    local restoring = false
    if v == nil then
        if not c.touched then return false end
        v = ORIG[c.prop]
        restoring = true
        if v == nil then c.touched = false; c.cur = nil; return false end
    end
    if c.kind == "bool" then
        pcall(function() Lighting[c.prop] = v end)
        c.touched = not restoring
        return false
    end
    if c.cur == nil then
        local ok, cur = pcall(function() return Lighting[c.prop] end)
        c.cur = (ok and cur ~= nil) and cur or v
    end
    local nv, done
    if c.kind == "n" then
        nv, done = approachNum(c.cur, v, k)
    elseif c.kind == "log" then
        local lc, lt = math.log(math.max(c.cur, 1)), math.log(math.max(v, 1))
        if math.abs(lt - lc) < 0.004 then nv, done = v, true
        else nv, done = math.exp(lc + (lt - lc) * k), false end
    elseif c.kind == "clock" then
        if cfg.timeCycle and not restoring then
            nv, done = v, true
        else
            local d = ((v - c.cur + 12) % 24) - 12
            if math.abs(d) < 0.01 then nv, done = v, true
            else nv, done = (c.cur + d * k) % 24, false end
        end
    else
        nv, done = approachCol(c.cur, v, k)
    end
    c.cur = nv
    pcall(function() Lighting[c.prop] = nv end)
    if done and restoring then
        c.touched = false
        c.cur = nil
    else
        c.touched = true
    end
    return not done or (c.kind == "clock" and cfg.timeCycle)
end

