local function keysStep(dt, t)
    local k = H.ks
    local pn, pn2, ac, ac2, tx, dim, onacc = themeCols()
    local now = os.clock()
    for _, e in ipairs(k.keys) do
        local down = false
        if e.mouse then
            local ok, v = pcall(function() return UIS:IsMouseButtonPressed(e.key) end)
            down = ok and v
        else
            local ok, v = pcall(function() return UIS:IsKeyDown(e.key) end)
            down = ok and v
        end
        e.a = e.a + ((down and 1 or 0) - e.a) * damp(20, dt)
        e.f.BackgroundColor3 = pn2:Lerp(ac, e.a)
        e.f.BackgroundTransparency = 0.2 - e.a * 0.15
        e.lb.TextColor3 = tx:Lerp(onacc, e.a)
        e.st.Color = ac
    end
    local c = H.clicks
    while c[1] and now - c[1] > 1 do table.remove(c, 1) end
    local txt = ("%d CPS"):format(#c)
    if k.cps.Text ~= txt then k.cps.Text = txt end
    k.cps.TextColor3 = dim
end

