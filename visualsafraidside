            if sv and p.Parent then
                pcall(function() p.Material = sv[1]; p.Color = sv[2]; p.Transparency = sv[3]; p.Reflectance = sv[4] end)
            end
        end
        for p, id in pairs(texSaved) do pcall(function() if p.Parent then p.TextureID = id end end) end
        for _, s in ipairs(surf) do pcall(function() s[1].Parent = s[2] end) end
