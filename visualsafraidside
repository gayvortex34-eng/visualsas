function Sec:Toggle(key, text, default, onChange)
    local f = self:_row(32)
    local lbl = label(f, text, 12, "text", F.med, XL)
    lbl.Size = UDim2.new(1, -62, 1, 0); lbl.Position = UDim2.fromOffset(9, 0); lbl.TextTruncate = Enum.TextTruncate.AtEnd
    local TW, KS = 34, 12
    local track = new("Frame", { Size = UDim2.fromOffset(TW, 18), Position = UDim2.new(1, -(TW + 9), 0.5, -9), BorderSizePixel = 0 }, f)
    corner(track, 9); bindTheme(track, "BackgroundColor3", "off")
    local tst = stroke(track, T.line, 1, 0.45)
    local fillOn = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0 }, track)
    corner(fillOn, 9); bindGrad(new("UIGradient", {}, fillOn), "lin")
    local shine = new("Frame", { Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0 }, track)
    corner(shine, 9)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, shine)
    local knob = new("Frame", { Size = UDim2.fromOffset(KS, KS), Position = UDim2.fromOffset(3, 3), BorderSizePixel = 0, BackgroundColor3 = T.dim }, track)
    corner(knob, 6)
    local function knobPos(on, w) return on and UDim2.fromOffset(TW - w - 3, 3) or UDim2.fromOffset(3, 3) end
    local chip = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(30, 16), Position = UDim2.new(1, -(TW + 18), 0.5, 0), BackgroundTransparency = 0.45,
        BorderSizePixel = 0, Visible = false }, f)
    corner(chip, 5); bindTheme(chip, "BackgroundColor3", "panel2")
    bindTheme(stroke(chip, T.line, 1, 0.3), "Color", "line")
    local chipTxt = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", TextSize = 10, Font = F.bold, BorderSizePixel = 0 }, chip)
    bindTheme(chipTxt, "TextColor3", "acc")
    local nameBtn = new("TextButton", { Size = UDim2.new(1, -90, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, f)
    local btn = new("TextButton", { Size = UDim2.fromOffset(90, 32), Position = UDim2.new(1, -90, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, f)
    local ctl = { kind = "toggle", frame = f, key = key, text = text, chipRight = TW + 18 }
    ctl.where = (self.tab and self.tab.name or "") .. ((self.title and self.title ~= "") and ("  |  " .. self.title) or "")
    local grp = self.grp
    cfg[key] = default
    Flags[key] = ctl
    local first = true
    local function render(snap)
        local on = cfg[key] == true
        local fp = { BackgroundTransparency = on and 0 or 1 }
        local kp = { Position = knobPos(on, KS), Size = UDim2.fromOffset(KS, KS), BackgroundColor3 = on and WHITE or T.dim }
        local lp_ = { TextColor3 = on and T.text or T.dim }
        local sp = { Transparency = on and 1 or 0.45, Color = T.line }
        local hp = { BackgroundTransparency = on and 0.72 or 1 }
        if first or snap == true then
            first = false
            for k, v in pairs(fp) do fillOn[k] = v end
            for k, v in pairs(kp) do knob[k] = v end
            for k, v in pairs(lp_) do lbl[k] = v end
            for k, v in pairs(sp) do tst[k] = v end
            for k, v in pairs(hp) do shine[k] = v end
        else
            tw(fillOn, TI.med, fp)
            tw(knob, TI.back, kp)
            tw(lbl, TI.fast, lp_)
            tw(tst, TI.med, sp)
            tw(shine, TI.med, hp)
        end
    end
    reg(render)
    function ctl.paintBind()
        local b = bindOf(key)
        if b then
            local t_ = UIX.keyLabel(b.k) .. (b.m == "Hold" and " hold" or "")
            chipTxt.Text = t_
            local w = 12 + #t_ * 6
            chip.Size = UDim2.fromOffset(w, 16)
            chip.Position = UDim2.new(1, -ctl.chipRight, 0.5, 0)
            chip.Visible = true
            lbl.Size = UDim2.new(1, -(ctl.chipRight + w + 12), 1, 0)
        else
            chip.Visible = false
            lbl.Size = UDim2.new(1, -(ctl.chipRight + 8), 1, 0)
        end
    end
    UIX.bindCtls[#UIX.bindCtls + 1] = ctl
    function ctl:Set(v, silent)
        cfg[key] = v and true or false
        render()
        if not silent then
            mark(grp)
            if onChange then onChange(cfg[key]) end
        end
    end
    btn.Activated:Connect(function() ctl:Set(not cfg[key]) end)
    btn.InputBegan:Connect(function(i)
        if isPress(i) then tw(knob, TI.fast, { Size = UDim2.fromOffset(KS + 5, KS), Position = knobPos(cfg[key] == true, KS + 5) }) end
    end)
    btn.InputEnded:Connect(function(i)
        if isPress(i) then tw(knob, TI.back, { Size = UDim2.fromOffset(KS, KS), Position = knobPos(cfg[key] == true, KS) }) end
    end)
    nameBtn.Activated:Connect(function()
        if cfg.bindClick ~= false then openBind(ctl) else ctl:Set(not cfg[key]) end
    end)
    render(true)
    ctl.paintBind()
    UIX.indexCtl(self, text, f)
    return ctl
end

function Sec:Group(key, text, default, onChange, startOpen)
    local ctl = self:Toggle(key, text, default, onChange)
    local more = new("TextButton", { Text = "", BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -78, 0, 3), BorderSizePixel = 0 }, ctl.frame)
    ctl.chipRight = 82
    ctl.paintBind()
    local chev = chevron(more, "dim", 12)
    chev.Position = UDim2.fromScale(0.5, 0.5)
    self.n = self.n + 1
    local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, LayoutOrder = self.n, BorderSizePixel = 0 }, self.body)
    vlist(holder, 0)
    local inner = new("Frame", { BackgroundTransparency = 0.55, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0 }, holder)
    bindTheme(inner, "BackgroundColor3", "panel2")
    corner(inner, 10)
    bindTheme(stroke(inner, T.line, 1, 0.55), "Color", "line")
    vlist(inner, 3); pad(inner, 6, 6, 6, 6)
    local open, busy = false, 0
    local function targetH() return math.floor(inner.AbsoluteSize.Y / curScale() + 0.5) + 4 end
    local function setOpen(v)
        if open == v then return end
        open = v
        busy = busy + 1
        local my = busy
        tw(chev, TI.back, { Rotation = open and 180 or 0 })
        holder.AutomaticSize = Enum.AutomaticSize.None
        if open then
            tw(holder, TI.med, { Size = UDim2.new(1, 0, 0, targetH()) })
            task.delay(0.26, function()
                if busy == my and open then holder.AutomaticSize = Enum.AutomaticSize.Y; holder.Size = UDim2.new(1, 0, 0, 0) end
            end)
        else
            holder.Size = UDim2.new(1, 0, 0, targetH())
            tw(holder, TI.med, { Size = UDim2.new(1, 0, 0, 0) })
        end
    end
    more.Activated:Connect(function() setOpen(not open) end)
    if startOpen then
        open = true
        chev.Rotation = 180
        holder.AutomaticSize = Enum.AutomaticSize.Y
    end
    local parentReveal = self.reveal
    local sub = setmetatable({ body = inner, grp = self.grp, n = 0, tab = self.tab, title = self.title,
        reveal = function() if parentReveal then parentReveal() end; setOpen(true) end }, Sec)
    return sub, ctl
end

function Sec:Slider(key, text, min, max, default, dec, suffix, onChange)
    dec = dec or 0
    local f = self:_row(44)
    local nm = label(f, text, 12, "text", F.med, XL)
    nm.Size = UDim2.new(1, -86, 0, 18); nm.Position = UDim2.fromOffset(9, 4)
    local vl = new("TextBox", { BackgroundTransparency = 1, Text = "", TextSize = 11, Font = F.bold, TextXAlignment = XR, ClearTextOnFocus = false, BorderSizePixel = 0,
        Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, -79, 0, 3), ZIndex = 3 }, f)
    bindTheme(vl, "TextColor3", "dim"); bindTheme(vl, "BackgroundColor3", "off")
    corner(vl, 6); pad(vl, 6, 0, 6, 0)
    local vst = stroke(vl, T.acc, 1, 1)
    bindTheme(vst, "Color", "acc")
    local track = new("Frame", { Size = UDim2.new(1, -22, 0, 5), Position = UDim2.fromOffset(11, 32), BorderSizePixel = 0 }, f)
    corner(track, 3); bindTheme(track, "BackgroundColor3", "off")
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, BackgroundColor3 = WHITE }, track)
    corner(fill, 3); bindGrad(new("UIGradient", {}, fill), "lin")
    local halo = new("ImageLabel", { Size = UDim2.fromOffset(34, 34), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 1, Image = "",
        ImageTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, track)
    bindTheme(halo, "ImageColor3", "acc")
    Assets.watchTex(halo, "glow")
    local knob = new("Frame", { Size = UDim2.fromOffset(13, 13), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2 }, track)
    corner(knob, 7)
    local kst = stroke(knob, T.acc, 2, 0)
    bindTheme(kst, "Color", "acc")
    local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, f)
    local ctl = { kind = "slider", track = track, fill = fill, knob = knob, frame = f, vis = 0, tgt = 0, min = min, max = max, field = vl }
    local grp = self.grp
    cfg[key] = default
    Flags[key] = ctl
    local fmt = "%." .. dec .. "f"
    local editing = false
    local function ratio() return (cfg[key] - min) / (max - min) end
    local function paint()
        local r = clamp(ctl.vis, 0, 1)
        fill.Size = UDim2.fromScale(r, 1)
        knob.Position = UDim2.fromScale(r, 0.5)
        halo.Position = knob.Position
        if ctl.onPaint then ctl.onPaint(cfg[key]) end
    end
    local function render(snap)
        ctl.tgt = ratio()
        if not editing then vl.Text = string.format(fmt, cfg[key]) .. (suffix or "") end
        if snap or not UIX.shell.Visible then ctl.vis = ctl.tgt; paint() else sliderAnim[ctl] = true end
    end
    ctl.paint = paint
    reg(function() paint() end)
    function ctl:Set(v, silent)
        v = clamp(tonumber(v) or min, min, max)
        local stp = 10 ^ (-dec)
        v = math.floor(v / stp + 0.5) * stp
        cfg[key] = v
        render(false)
        if not silent then
            mark(grp)
            if onChange then onChange(v) end
        end
    end
    local function fromX(x)
        local r = clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        ctl:Set(min + (max - min) * r)
    end
    hit.InputBegan:Connect(function(i)
        if isPress(i) then
            closeDD()
            local sc = f:FindFirstAncestorWhichIsA("ScrollingFrame")
            if sc then sc.ScrollingEnabled = false; UIX.drag.lock = sc end
            tw(knob, TI.fast, { Size = UDim2.fromOffset(18, 18) })
            tw(halo, TI.fast, { ImageTransparency = 0.55 })
            tw(vl, TI.fast, { TextColor3 = T.acc })
            UIX.drag.fn = function(m) fromX(m.Position.X) end
            UIX.dragEnd = function()
                tw(knob, TI.back, { Size = UDim2.fromOffset(13, 13) })
                tw(halo, TI.med, { ImageTransparency = 1 })
                tw(vl, TI.med, { TextColor3 = T.dim })
            end
            fromX(i.Position.X)
        end
    end)
    vl.Focused:Connect(function()
        editing = true
        vl.Text = string.format(fmt, cfg[key])
        tw(vl, TI.fast, { BackgroundTransparency = 0.2 })
        tw(vst, TI.fast, { Transparency = 0.35 })
    end)
    vl.FocusLost:Connect(function()
        local n = tonumber((vl.Text:gsub("[^%d%.%-]", "")))
        editing = false
        if n then ctl:Set(n) else render(true) end
        vl.Text = string.format(fmt, cfg[key]) .. (suffix or "")
        tw(vl, TI.med, { BackgroundTransparency = 1 })
        tw(vst, TI.med, { Transparency = 1 })
    end)
    render(true)
    UIX.indexCtl(self, text, f)
    return ctl
end

function Sec:Hue(key, text, default, onChange)
    local ctl = self:Slider(key, text, 0, 360, default, 0, " deg", onChange)
    ctl.track.BackgroundColor3 = WHITE
    local ks = {}
    for i = 0, 6 do ks[#ks + 1] = CK(i / 6, Color3.fromHSV((i % 6) / 6, 0.95, 1)) end
    new("UIGradient", { Color = ColorSequence.new(ks) }, ctl.track)
    ctl.fill.BackgroundTransparency = 1
    for _, c in ipairs(ctl.fill:GetChildren()) do if c:IsA("UIGradient") then c.Enabled = false end end
    ctl.onPaint = function(v) ctl.knob.BackgroundColor3 = hsv(v, 0.75, 1) end
    reg(function() ctl.track.BackgroundColor3 = WHITE end)
    ctl.paint()
    return ctl
end

function Sec:Segment(key, text, options, default, onChange)
    local f = self:_row(32)
    local n = #options
    local chars = 0
    for _, o in ipairs(options) do chars = chars + #tostring(o) end
    local bw = math.max(0.52, math.min(0.8, 0.12 + 0.026 * chars))
    local lbl = label(f, text, 12, "text", F.med, XL)
    lbl.Size = UDim2.new(1 - bw, 0, 1, 0); lbl.Position = UDim2.fromOffset(9, 0); lbl.TextTruncate = Enum.TextTruncate.AtEnd
    local box = new("Frame", { Size = UDim2.new(bw, -9, 0, 25), Position = UDim2.new(1 - bw, 0, 0.5, -12), BorderSizePixel = 0, ClipsDescendants = true }, f)
    corner(box, 9); bindTheme(box, "BackgroundColor3", "off")
    bindTheme(stroke(box, T.line, 1, 0.5), "Color", "line")
    local hl = new("Frame", { Size = UDim2.new(1 / n, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, box)
    corner(hl, 7); bindGrad(new("UIGradient", {}, hl), "lin")
    local hlGloss = new("Frame", { Size = UDim2.fromScale(1, 0.55), BackgroundColor3 = WHITE, BackgroundTransparency = 0.74, BorderSizePixel = 0 }, hl)
    corner(hlGloss, 7)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, hlGloss)
    local btns = {}
    local ctl = { kind = "segment", options = options, frame = f }
    local grp = self.grp
    cfg[key] = default
    Flags[key] = ctl
    local first = true
    local function render(snap)
        local idx = 1
        for i, o in ipairs(options) do if o == cfg[key] then idx = i end end
        local pos = UDim2.new((idx - 1) / n, 2, 0, 2)
        if first or snap == true then first = false; hl.Position = pos else tw(hl, TI.back, { Position = pos }) end
        for i, b in ipairs(btns) do
            local on = (i == idx)
            local col = on and T.onacc or T.dim
            if snap == true then b.TextColor3 = col else tw(b, TI.fast, { TextColor3 = col }) end
        end
    end
    reg(render)
    for i, o in ipairs(options) do
        local b = new("TextButton", { Size = UDim2.new(1 / n, 0, 1, 0), Position = UDim2.new((i - 1) / n, 0, 0, 0), BackgroundTransparency = 1, Text = o, TextSize = 11,
            Font = F.bold, TextColor3 = T.dim, AutoButtonColor = false, BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd }, box)
        btns[i] = b
        b.Activated:Connect(function() ctl:Set(o) end)
    end
    function ctl:Set(v, silent)
        cfg[key] = v
        render()
        if not silent then
            mark(grp)
            if onChange then onChange(v) end
        end
    end
    render(true)
    UIX.indexCtl(self, text, f)
    return ctl
end

function Sec:Dropdown(key, text, options, default, multi, onChange)
    local f = self:_row(32)
    local lbl = label(f, text, 12, "text", F.med, XL)
    lbl.Size = UDim2.new(0.36, 0, 1, 0); lbl.Position = UDim2.fromOffset(9, 0); lbl.TextTruncate = Enum.TextTruncate.AtEnd
    local box = new("TextButton", { Size = UDim2.new(0.64, -9, 0, 25), Position = UDim2.new(0.36, 0, 0.5, -12), Text = "", AutoButtonColor = false, BorderSizePixel = 0,
        ClipsDescendants = true }, f)
    corner(box, 9); bindTheme(box, "BackgroundColor3", "off")
    local bst = stroke(box, T.line, 1, 0.4)
    bindTheme(bst, "Color", "line")
    local val = label(box, "", 12, "text", F.reg, XL)
    val.Size = UDim2.new(1, -28, 1, 0); val.Position = UDim2.fromOffset(10, 0); val.TextTruncate = Enum.TextTruncate.AtEnd
    local arr = chevron(box, "dim", 10)
    arr.Position = UDim2.new(1, -13, 0.5, 0)
    box.MouseEnter:Connect(function() tw(bst, TI.fast, { Color = T.acc, Transparency = 0.2 }) end)
    box.MouseLeave:Connect(function() tw(bst, TI.fast, { Color = T.line, Transparency = 0.4 }) end)
    box.InputBegan:Connect(function(i) if isPress(i) then UIX.ripple(box, i.Position, "acc") end end)
    local ctl = { kind = "dropdown", options = options, frame = f }
    local grp = self.grp
    if multi then cfg[key] = copyT(default) else cfg[key] = default end
    Flags[key] = ctl
    local function txt()
        if multi then
            local parts = {}
            for _, o in ipairs(ctl.options) do if cfg[key][o] then parts[#parts + 1] = o end end
            return #parts > 0 and table.concat(parts, ", ") or "None"
        end
        return tostring(cfg[key])
    end
    function ctl:Set(v, silent)
        if multi then
            local nt = {}
            if type(v) == "table" then for k, x in pairs(v) do nt[k] = x and true or false end end
            cfg[key] = nt
        else
            cfg[key] = v
        end
        val.Text = txt()
        if not silent then
            mark(grp)
            if onChange then onChange(cfg[key]) end
        end
    end
    function ctl:SetOptions(o) ctl.options = o; val.Text = txt() end
    box.Activated:Connect(function()
        tw(arr, TI.back, { Rotation = 180 })
        openDD(box, ctl.options, multi, function() return cfg[key] end, function(opt)
            if multi then
                cfg[key][opt] = not cfg[key][opt]
                val.Text = txt()
                mark(grp)
                if onChange then onChange(cfg[key]) end
            else
                ctl:Set(opt)
            end
        end)
        UIX.ddClosed = function() tw(arr, TI.med, { Rotation = 0 }) end
    end)
    val.Text = txt()
    UIX.indexCtl(self, text, f)
    return ctl
end

