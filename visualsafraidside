    end
    for i, q in ipairs({ { 96, 1.3 }, { -8, 1.5 }, { -62, 1.1 } }) do spire(3, q[1], q[2], 0.3, 0.24, 0.3, 0.22, 0.8) end
    local chips = { { 52, 6.3, 0.26 }, { 34, 6.9, 0.2 }, { 14, 6.6, 0.22 }, { -6, 5.7, 0.18 }, { -28, 4.8, 0.16 } }
