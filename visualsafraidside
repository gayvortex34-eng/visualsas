do
local unit3, frame, horn = H.unit3, H.frame3, H.horn3

local function mirror(src)
    local out = {}
    for i, op in ipairs(src) do
        local c = {}
        for k, v in pairs(op) do c[k] = v end
        if op.p then c.p = { -op.p[1], op.p[2], op.p[3] } end
        if op.fr then
            local X, Y, Z = op.fr[1], op.fr[2], op.fr[3]
            c.fr = { { X[1], -X[2], -X[3] }, { -Y[1], Y[2], Y[3] }, { -Z[1], Z[2], Z[3] } }
        elseif op.r then
            c.r = { op.r[1], -op.r[2], -op.r[3] }
        end
        local s = op.s
        if op.k ~= "tube" then
            if type(s) == "number" then c.s = { -s, s, s } elseif type(s) == "table" then c.s = { -s[1], s[2], s[3] } else c.s = { -1, 1, 1 } end
        end
        if op.pts and (op.k == "tube") then
            local np = {}
            for j, q in ipairs(op.pts) do np[j] = { -q[1], q[2], q[3] } end
            c.pts = np
        end
        if op.ra then c.ra = -op.ra end
        out[i] = c
    end
    return out
end
local function both(ops)
    local m = mirror(ops)
    local all = {}
    for _, o in ipairs(ops) do all[#all + 1] = o end
    for _, o in ipairs(m) do all[#all + 1] = o end
