local function makeObj(e)
    local o = Instance.new(e.class)
    o.Name = TAG .. e.key
    local ok = pcall(function() o.Parent = parentFor(e.class) end)
    if not ok then pcall(function() o:Destroy() end) return nil end
    return o
end

local function dropE(e)
    if e.obj then pcall(function() e.obj:Destroy() end) end
    e.obj, e.cur, e.applied = nil, nil, nil
end

local function stepE(e, k)
    local want = e.want()
    local tgt
    if want then
        tgt = e.target()
        e.lastT = tgt
        if e.obj and not e.obj.Parent then
            local okp = pcall(function() e.obj.Parent = parentFor(e.class) end)
            if not okp then dropE(e) end
        end
        if not e.obj then
            e.obj = makeObj(e)
            if not e.obj then return false end
            e.cur = e.neutral(tgt)
            e.applied = {}
        end
    else
        if not e.obj then return false end
        tgt = e.neutral(e.lastT or e.cur)
    end
    local moving = false
    for key, tv in pairs(tgt) do
        local cv = e.cur[key]
        if cv == nil then cv = tv end
        local nv, done = approachAny(cv, tv, k)
        e.cur[key] = nv
        if not done then moving = true end
        if e.applied[key] ~= nv then
            e.applied[key] = nv
            pcall(function() e.obj[key] = nv end)
        end
    end
    if not want and not moving then dropE(e) end
    return moving
end

local function celestial(sky)
    local c = cfg.celestial
    pcall(function()
        sky.CelestialBodiesShown = (c ~= "None")
        sky.SunAngularSize = (c == "Moon") and 0 or cfg.celSize
        sky.MoonAngularSize = (c == "Sun") and 0 or clamp(cfg.celSize * 11 / 21, 0, 11)
        sky.StarCount = cfg.stars
    end)
end

local function fetchSky(id)
    local objs
    local ok, r = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
    if ok and type(r) == "table" and #r > 0 then objs = r end
    if not objs then
        local ok2, m = pcall(function() return svc("InsertService"):LoadAsset(tonumber(id)) end)
        if ok2 and m then objs = { m } end
    end
    if not objs then return nil, "asset did not load" end
    local found
    for _, o in ipairs(objs) do
        if o:IsA("Sky") then found = o else found = o:FindFirstChildWhichIsA("Sky", true) end
        if found then break end
    end
    if not found then
        for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
        return nil, "no Sky inside"
    end
    local sky = found:Clone()
    if not sky then
        found.Parent = nil
        sky = found
    end
    for _, o in ipairs(objs) do
        if o ~= sky then pcall(function() o:Destroy() end) end
    end
    for _, c in ipairs(sky:GetChildren()) do pcall(function() c:Destroy() end) end
    return sky
end

local function loadSkyAsync(name, id, quiet)
    local started = W.loading[name]
    if started and os.clock() - started < 25 then return end
    W.loading[name] = os.clock()
    W.loadFail[name] = nil
    task.spawn(function()
        local sky, err = fetchSky(id)
        W.loading[name] = nil
        if sky then
            if W.skyCache[name] then pcall(function() W.skyCache[name]:Destroy() end) end
            W.skyCache[name] = sky
            if not quiet and cfg.skybox == name then notify("Sky loaded: " .. name) end
            dirty.world = true
        else
            W.loadFail[name] = tostring(err)
            if not quiet then notify("Sky failed (" .. tostring(err) .. "): " .. name, 4) end
            dirty.world = true
        end
    end)
end

local function dropSkyInst()
    if W.sky.inst then pcall(function() W.sky.inst:Destroy() end) end
    W.sky.inst = nil
end

local function swapSky(name)
    if name == "Game Default" then
        dropSkyInst(); claim("Sky", false)
    else
        local tpl = (name == "Roblox Default" or PROC_SKY[name]) and "default" or W.skyCache[name]
        if not tpl then return false end
        claim("Sky", true)
        dropSkyInst()
        local s = (tpl == "default") and Instance.new("Sky") or tpl:Clone()
        if PROC_SKY[name] then
            for _, f in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do pcall(function() s[f] = "" end) end
        end
        s.Name = TAG .. "sky"
        s.Parent = Lighting
        W.sky.inst = s
        celestial(s)
    end
    W.sky.shown = name
    return true
end

local function setDip(d)
    local S = W.sky
    S.dip = d
    if d > 0.002 then
        if not S.dipObj or not S.dipObj.Parent then
            if S.dipObj then pcall(function() S.dipObj:Destroy() end) end
            local o = Instance.new("ColorCorrectionEffect")
            o.Name = TAG .. "dip"
            local ok = pcall(function() o.Parent = Lighting end)
            S.dipObj = ok and o or nil
        end
        if S.dipObj then
            pcall(function() S.dipObj.Brightness = -0.85 * d; S.dipObj.Contrast = 0.2 * d end)
        end
    elseif S.dipObj then
        pcall(function() S.dipObj:Destroy() end)
        S.dipObj = nil
    end
end

local function stepSky(dt)
    local S = W.sky
    local want = on() and cfg.skybox or "Game Default"
    if S.phase == "idle" then
        if want ~= S.shown then
            local ready = (want == "Game Default") or (want == "Roblox Default") or PROC_SKY[want] or W.skyCache[want] ~= nil
            if not ready then
                local id = SKY_ID[want]
                if id then
                    if W.loadFail[want] then
                        if S.announce ~= want then
                            S.announce = want
                            if cfg.skybox == want and Flags.skybox then Flags.skybox:Set(S.shown, true) end
                        end
                    else
                        loadSkyAsync(want, id)
                    end
                elseif Flags.skybox then
                    Flags.skybox:Set(S.shown, true)
                end
                return false
            end
            S.announce = nil
            if cfg.skyFade then
                S.phase, S.t = "out", 0
            else
                swapSky(want)
            end
            return true
        end
        if S.inst and dirty.world then celestial(S.inst) end
        return false
    elseif S.phase == "out" then
        S.t = S.t + dt
        setDip(clamp(S.t / 0.26, 0, 1))
        if S.t >= 0.26 then
            local w2 = on() and cfg.skybox or "Game Default"
            swapSky(w2)
            S.phase, S.t = "in", 0
        end
        return true
    else
        S.t = S.t + dt
        local x = clamp(S.t / 0.5, 0, 1)
        setDip(1 - x * x * (3 - 2 * x))
        if S.t >= 0.5 then S.phase = "idle"; setDip(0) end
        return true
    end
end

local function qualityStep(dt)
    W.qAcc = W.qAcc + dt
    if W.qAcc < 1.5 then return end
    W.qAcc = 0
    local want = on() and cfg.forceQ and (cfg.optQuality == "Game" or cfg.optQuality == nil) and (cfg.bloomOn or cfg.dofOn or cfg.sunOn or cfg.atmoOn or cfg.cloudsOn)
    local ok, ql = pcall(function() return settings().Rendering.QualityLevel end)
    if not ok or ql == nil then return end
    local v = ql.Value or 0
    if want and not W.qForced and v >= 1 and v < 5 then
        W.qOrig = ql
        local ok2 = pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level07 end)
        if ok2 then W.qForced = true; notify("Graphics quality raised for post-fx", 3) end
    elseif not want and W.qForced then
        if W.qOrig then pcall(function() settings().Rendering.QualityLevel = W.qOrig end) end
        W.qForced, W.qOrig = nil, nil
    end
end

function W.step(dt)
    W.acc = W.acc + dt
    local run = dirty.world or W.animating or W.acc > 0.3
    if not run then return end
    local d = W.acc
    W.acc = 0
    local k = damp(rate(), d)
    if cfg.smooth <= 0.06 then k = 1 end

    if cfg.master and cfg.timeOn and cfg.timeCycle then
        cfg.time = (cfg.time + d * 24 / math.max(10, cfg.timeLen)) % 24
        W.timeAcc = W.timeAcc + d
        if W.timeAcc > 0.4 and Flags.time then
            W.timeAcc = 0
            Flags.time:Set(cfg.time, true)
        end
    end

    if cfg.master and cfg.cycle and os.clock() > W.cycleAt then
        W.cycleAt = os.clock() + math.max(5, cfg.cycleTime)
        W.nextSky()
    end

    local fogOn = on() and cfg.fogOn and not cfg.fullbright
    local needA = (on() and cfg.atmoOn) or fogOn
    local fogCh = lchBy.FogEnd
    claim("Atmosphere", needA or E.atmo.obj ~= nil or fogCh.touched)
    claim("Clouds", (on() and cfg.cloudsOn) or E.clouds.obj ~= nil)

    local moving = false
    for _, c in ipairs(lch) do
        if stepL(c, k) then moving = true end
    end
    for _, e in ipairs(EL) do
        if stepE(e, k) then moving = true end
    end
    if stepSky(d) then moving = true end
    qualityStep(d)
    W.animating = moving
    dirty.world = false
end

local function setKey(k, v)
    if Flags[k] and Flags[k].Set then Flags[k]:Set(v, true) else cfg[k] = v end
end

W.setKey = setKey

function W.applyLook(name)
    local p = PRESETS[name]
    if not p then return end
    for _, k in ipairs(LOOK_KEYS) do
        if k ~= "skybox" then
            local v = p[k]
            if v == nil then v = D[k] end
            if v ~= nil then setKey(k, v) end
        end
    end
    cfg.master = true
    if Flags.master then Flags.master:Set(true, true) end
    mark("world"); mark("weather"); mark("screen")
end

function W.applyPreset(name)
    local p = PRESETS[name]
    if not p then return end
    W.applyLook(name)
    if p.skybox then setKey("skybox", p.skybox) end
    cfg.preset = name
    if Flags.preset then Flags.preset:Set(name, true) end
    mark("world")
end

function W.onSkyPicked(name)
    cfg.skybox = name
    local look = SKY_LOOK[name]
    if cfg.skyLook and look and PRESETS[look] then
        W.applyLook(look)
        if Flags.preset then Flags.preset:Set(look, true) end
        cfg.preset = look
    end
    cfg.master = true
    if Flags.master then Flags.master:Set(true, true) end
    mark("world")
end

function W.nextSky()
    local i = 0
    for n, name in ipairs(SKY_OPTIONS) do if name == cfg.skybox then i = n end end
    local nxt = SKY_OPTIONS[(i % #SKY_OPTIONS) + 1]
    if nxt == "Game Default" or nxt == "Roblox Default" then nxt = SKY_OPTIONS[3] end
    if Flags.skybox then Flags.skybox:Set(nxt, true) end
    W.onSkyPicked(nxt)
end

function W.randomSky()
    local e = SKY_LIST[math.random(1, #SKY_LIST)]
    if Flags.skybox then Flags.skybox:Set(e[1], true) end
    W.onSkyPicked(e[1])
end

function W.loadCustom(text)
    local id = tonumber((tostring(text):gsub("%D", "")))
    if not id then notify("Enter a numeric Sky asset ID", 3) return end
    local name = "Custom / " .. id
    if not SKY_ID[name] then
        SKY_ID[name] = id
        SKY_OPTIONS[#SKY_OPTIONS + 1] = name
        if Flags.skybox then Flags.skybox:SetOptions(SKY_OPTIONS) end
    end
    if W.skyCache[name] then
        if Flags.skybox then Flags.skybox:Set(name, true) end
        W.onSkyPicked(name)
        return
    end
    notify("Loading " .. id .. " ...", 2)
    task.spawn(function()
        local sky, err = fetchSky(id)
        if sky then
            W.skyCache[name] = sky
            if Flags.skybox then Flags.skybox:Set(name, true) end
            W.onSkyPicked(name)
            notify("Sky loaded: " .. name)
        else
            notify("Custom sky failed: " .. tostring(err), 4)
        end
    end)
end

function W.checkAll()
    notify("Checking " .. #SKY_LIST .. " skies...", 3)
    task.spawn(function()
        local okN, bad = 0, {}
        for _, e in ipairs(SKY_LIST) do
            if not W.skyCache[e[1]] then
                local sky = fetchSky(e[2])
                if sky then W.skyCache[e[1]] = sky; okN = okN + 1 else bad[#bad + 1] = e[1] end
            else
                okN = okN + 1
            end
            task.wait(0.12)
        end
        notify(("Skies OK: %d / %d"):format(okN, #SKY_LIST), 5)
        if #bad > 0 then notify("Failed: " .. table.concat(bad, ", "):sub(1, 90), 6) end
    end)
end

W.clarity = clarity

function W.diag()
    local lines = {}
    local function add(s) lines[#lines + 1] = s end
    local okq, q = pcall(function() return settings().Rendering.QualityLevel.Name end)
    add("quality: " .. (okq and tostring(q) or "?"))
    add("sky shown: " .. W.sky.shown .. " (want " .. tostring(cfg.skybox) .. ")")
    local gameAtmo = false
    for _, o in ipairs(Lighting:GetChildren()) do
        if o:IsA("Atmosphere") and string.sub(o.Name, 1, #TAG) ~= TAG then gameAtmo = true end
    end
    add("atmosphere claimed: " .. tostring(W.claimed.Atmosphere == true) .. ", game atmosphere visible: " .. tostring(gameAtmo))
    local act = {}
    for _, e in ipairs(EL) do if e.obj then act[#act + 1] = e.key end end
    add("effects: " .. (#act > 0 and table.concat(act, ",") or "none"))
    add(("fog: %s  start %.0f end %.0f"):format(tostring(cfg.fogOn), Lighting.FogStart or 0, Lighting.FogEnd or 0))
    add("governor tier: " .. Gov.tier)
    return table.concat(lines, "\n")
end

function W.cleanup()
    for _, e in ipairs(EL) do dropE(e) end
    setDip(0)
    dropSkyInst()
    claim("Sky", false); claim("Atmosphere", false); claim("Clouds", false)
    for _, c in ipairs(lch) do
        if c.touched and ORIG[c.prop] ~= nil then pcall(function() Lighting[c.prop] = ORIG[c.prop] end) end
        c.touched, c.cur = false, nil
    end
