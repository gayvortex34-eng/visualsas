local function auraSig()
    local parts = {}
    for _, k in ipairs(AURA_ORDER) do if cfg.auraTypes[k] then parts[#parts + 1] = k end end
    return table.concat(parts, ",") .. "|" .. tostring(Assets.done) .. "|" .. tostring(Assets.ready)
end

local function buildAura(rec)
    local e = newE(auraSig())
    e.rec = rec
    local fy = rec.feetY
    local anchor, tracker
    function e.isGround(y) return y >= fy - 0.25 and y <= fy + 0.95 end
    function e.groundPart()
        if anchor then return anchor end
        local p = Instance.new("Part")
        p.Name = TAG .. "gnd"
        p.Anchored = true
        p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
        p.Transparency = 1
        p.Size = Vector3.new(0.2, 0.2, 0.2)
        p.Parent = fxFolder()
        e.items[#e.items + 1] = p
        anchor = p
        tracker = FX.groundTracker(0)
        local function put(_, dt)
            local hrp = rec.hrp
            if not (hrp and hrp.Parent and p.Parent) then return end
            local feet = hrp.Position + Vector3.new(0, fy, 0)
            local pos, nrm = tracker.update(feet, dt or 0.016, os.clock(), 2.6 * A.s())
            p.CFrame = FX.groundCF(pos, nrm, hrp.CFrame.LookVector)
        end
        put(0, 0.016)
        e.upd[#e.upd + 1] = put
        return p
    end
    local plainAtt = e.att
    function e.att(parent, pos, cf)
        if parent == rec.hrp and not cf and pos and e.isGround(pos.Y) then
            return plainAtt(e.groundPart(), Vector3.new(pos.X, pos.Y - fy, pos.Z))
        end
        return plainAtt(parent, pos, cf)
    end
    for _, k in ipairs(AURA_ORDER) do
        if cfg.auraTypes[k] and AURAS[k] then
            local ok, err = pcall(AURAS[k], e, rec)
            if not ok then report("aura " .. k, err) end
        end
    end
    return e
end

local TRAIL_STYLES = { "Bloom", "Glow", "Sparkle", "Stars", "Fireflies", "Snow", "Petals", "Hearts", "Embers", "Mist", "Ribbon", "Comet" }
local TRAIL_HEIGHTS = { "Feet", "Waist", "Chest", "Head", "Full" }
local TS = {}

local function TP()
    local size, life = cfg.trailSize, cfg.trailLife
    local sp = cfg.trailSpread / 100
    return {
        W = 0.45 * size,
        L = 0.2 + 0.28 * life,
        dens = math.max(cfg.trailDensity, 1) / 100,
        br = clamp(cfg.trailBright / 100, 0.05, 1),
        sp = sp,
        vs = 0.4 + sp * 1.1,
        ang = clamp(sp * 70, 4, 180),
        dr = cfg.trailDrift / 100,
    }
end

local function trailAnchors(e, rec)
    local fy, hy = rec.feetY, rec.headY
    local ys
    local h = cfg.trailHeight
    if h == "Waist" then ys = { -0.6 }
    elseif h == "Chest" then ys = { 0.6 }
    elseif h == "Head" then ys = { hy + 0.2 }
    elseif h == "Full" then ys = { fy + 0.2, -0.6, 0.8 }
    else ys = { fy + 0.2 } end
    local xs = cfg.trailSplit and { -0.55, 0.55 } or { 0 }
    local list = {}
    for _, y in ipairs(ys) do
        for _, x in ipairs(xs) do
            list[#list + 1] = { at = e.att(rec.hrp, Vector3.new(x, y, 0)), pos = Vector3.new(x, y, 0) }
        end
    end
    return list
end

local function perAnchor(e, anchors, specFn)
    local share = 1 / #anchors
    for _, a in ipairs(anchors) do
        e.pe(a.at, function()
            local P = TP()
            local c1, c2 = trailPal()
            local p = specFn(P, c1, c2)
            p.Rate = (p.Rate or 0) * P.dens * share
            p.LightInfluence = 0
            if p.LightEmission == nil then p.LightEmission = 1 end
            return p
        end)
    end
end

local function ribbons(e, anchors, specFn, lenFn)
    for _, a in ipairs(anchors) do
        local a1 = e.att(a.at.Parent, a.pos + Vector3.new(0, 0.5, 0))
        e.tr(a.at.Parent, a.at, a1, function()
            local P = TP()
            local c1, c2 = trailPal()
            local p = specFn(P, c1, c2)
            p.LightInfluence = 0
            p.MinLength = 0.03
            p.TextureMode = Enum.TextureMode.Stretch
            if p.LightEmission == nil then p.LightEmission = 1 end
            return p
        end)
        e.rf[#e.rf + 1] = function()
            local P = TP()
            a1.Position = a.pos + Vector3.new(0, (lenFn and lenFn(P)) or (0.4 + 0.12 * P.W), 0)
        end
        pcall(e.rf[#e.rf])
    end
end

