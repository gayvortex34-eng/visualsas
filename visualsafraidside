local function viewStep(dt)
    local on = cfg.dhOn == true
    local want = on and (cfg.dhCircle ~= false or cfg.dhTracer ~= false or cfg.dhTag ~= false)
    if want and not (V.gui and V.gui.Parent) then buildView() end
    V.a = V.a + ((want and 1 or 0) - V.a) * damp(10, dt)
    if not V.gui then return end
    if V.a < 0.01 and not want then
        V.ring.Visible, V.line.Visible, V.mark.Visible, V.tag.Visible = false, false, false, false
        return
    end
    local t = os.clock()
    local c1, c2 = themeCols()
    local ap = aimPoint()
    local c = cam()
    if t >= S.nextPick and c then
        S.nextPick = t + 0.05
        local ok, p, ch, _, pos = pcall(getTarget, c.CFrame.Position)
        if ok then S.part, S.char, S.pos = p, ch, pos else warnOnce("pick", p); S.part, S.char, S.pos = nil, nil, nil end
    end
    local locked = S.part ~= nil and S.part.Parent ~= nil
    V.lock = V.lock + ((locked and 1 or 0) - V.lock) * damp(14, dt)
    local pulse = clamp(1 - (t - S.lastHit) / 0.28, 0, 1)

    local r = clamp(tonumber(cfg.dhFov) or 300, 10, 1500)
    V.size = (V.size == 0) and r or (V.size + (r - V.size) * damp(14, dt))
    V.ring.Visible = cfg.dhCircle ~= false
    V.ring.Position = UDim2.fromOffset(ap.X, ap.Y)
    V.ring.Size = UDim2.fromOffset(V.size * 2, V.size * 2)
    local colr = c1:Lerp(Color3.new(1, 1, 1), V.lock * 0.55 + pulse * 0.4)
    V.grad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, colr), ColorSequenceKeypoint.new(0.5, c2:Lerp(Color3.new(1, 1, 1), V.lock * 0.35)), ColorSequenceKeypoint.new(1, colr) })
    V.grad.Rotation = (t * (30 + V.lock * 90)) % 360
    V.stroke.Transparency = 0.34 - V.lock * 0.24 - pulse * 0.1 + (1 - V.a) * 0.66
    V.stroke.Thickness = 1.5 + V.lock * 0.7 + pulse * 1.3
    V.halo.Color = c1
    V.halo.Transparency = 0.93 - V.lock * 0.1 - pulse * 0.15 + (1 - V.a) * 0.07
    for _, k in ipairs(V.ticks) do
        k.f.Position = UDim2.new(0.5, math.sin(k.ang) * (V.size - 4), 0.5, -math.cos(k.ang) * (V.size - 4))
        k.f.BackgroundColor3 = c2
        k.f.BackgroundTransparency = 0.45 - V.lock * 0.35
    end

    local pos = S.pos
    local show = locked and pos ~= nil and V.a > 0.05
    local tp = show and V2(pos.X, pos.Y) or nil
    if show and cfg.dhTracer ~= false then
        local dx, dy = tp.X - ap.X, tp.Y - ap.Y
        V.line.Visible = true
        V.line.Position = UDim2.fromOffset(ap.X, ap.Y)
        V.line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1.6)
        V.line.Rotation = math.deg(math.atan2(dy, dx))
        V.line.BackgroundColor3 = c1:Lerp(Color3.new(1, 1, 1), 0.4)
    else
        V.line.Visible = false
    end
    V.mark.Visible = show
    if show then
        local s = 30 + math.sin(t * 6) * 2 + pulse * 16
        V.mark.Position = UDim2.fromOffset(tp.X, tp.Y)
        V.mark.Size = UDim2.fromOffset(s, s)
        V.markStroke.Color = c2:Lerp(Color3.new(1, 1, 1), pulse)
        V.markStroke.Transparency = 0.1 + (1 - V.lock) * 0.9
        V.dot.BackgroundColor3 = c1:Lerp(Color3.new(1, 1, 1), 0.5)
    end
    if show and cfg.dhTag ~= false and S.char then
        local hum = S.char:FindFirstChildOfClass("Humanoid")
        local hp = hum and math.floor(hum.Health + 0.5) or 0
        local pl = Players:GetPlayerFromCharacter(S.char)
        local nm = pl and (pl.DisplayName ~= "" and pl.DisplayName or pl.Name) or S.char.Name
        local dist = c and S.part and math.floor((c.CFrame.Position - S.part.Position).Magnitude + 0.5) or 0
        V.tag.Visible = true
        V.tag.Position = UDim2.fromOffset(tp.X, tp.Y + 24 + pulse * 6)
        local txt = ("%s  %d hp  %d st"):format(nm, hp, dist)
        if V.tag.Text ~= txt then V.tag.Text = txt end
        V.tag.TextColor3 = c2:Lerp(Color3.new(1, 1, 1), 0.55)
    else
        V.tag.Visible = false
    end
end

function M.step(dt)
    if not alive then return end
    local on = cfg.dhOn == true
    if on and not S.hook then
        local was = S.rising
        local ok = install()
        if ok then notify("Da Hood silent aim ready", 2.5)
        elseif not was or os.clock() - (S.warnT or 0) > 30 then S.warnT = os.clock(); notify("Da Hood: " .. S.why, 5) end
    end
    S.rising = on
    local ok, e = pcall(viewStep, dt)
    if not ok then warnOnce("view", e) end
end

function M.cleanup()
    alive = false
    local G = genv.AS_DHHK
    if G and G.handler == onShoot then G.handler = nil end
    pcall(function() if V.gui then V.gui:Destroy() end end)
    V.gui = nil
end

