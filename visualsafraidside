local API
local unloaded = false
local statAcc = 0
local userSteps, userUnloads = {}, {}

local function step(dt)
    if unloaded then return end
    local t = os.clock()
    try("ui", UI.step, dt)
    try("world", W.step, dt)
    try("fx", FX.step, dt)
    try("cosmetics", COS.step, dt)
    try("accessories", ACC.step, dt)
    try("character", CHAR.step, dt)
    try("avatar", AVA.step, dt)
    try("glyphs", GL.step, t, dt)
    try("screen", screenFrame, dt)
    try("weather", wxStep, t, dt)
    try("seals", MISC.SEAL.step, t, dt)
    try("constellations", MISC.CONST.step, t, dt)
    try("esp", ESP.step, dt)
    try("combat", COMBAT.step, dt)
    try("mm2", MISC.MM2.step, dt)
    try("mm2 label", MISC.MM2.updateLabel)
    try("dahood", MISC.DH.step, dt)
    try("dahood label", MISC.DH.updateLabel)
    try("move", MISC.MOVE.step, dt)
    try("hud", HUD.step, dt)
    try("opt", OPT.step, dt)
    for i = 1, #userSteps do try("user", userSteps[i], dt) end
    statAcc = statAcc + dt
    if statAcc >= 1 then
        statAcc = 0
        local fps = OPT.getFps()
        UI.setHud(fps)
        UI.setStatus(("Tier %d  |  %s"):format(Gov.tier, MISC.MOVE.status()))
        UI.setFps(("%d fps"):format(math.floor(fps + 0.5)))
        UI.setPerf(Gov.tier)
        if UI.isOpen() then
            local txt = FX.othersStatus().text
            for i = 1, #UIX.othersLbl do UIX.othersLbl[i].Text = txt end
            if UIX.cosSum then UIX.cosSum.Text = COS.summary() end
            for k, l in pairs(UIX.cosLbl) do l.Text = COS.status(k) end
        end
        if UI.isOpen() and optStats then
            local st = FX.stats()
            optStats.Text = ("fps %d  |  tier %d  |  emitters %d  |  skies %d"):format(math.floor(fps + 0.5), Gov.tier, st.emitters, (function() local n = 0 for _ in pairs(W.skyCache) do n = n + 1 end return n end)())
        end
    end
end

