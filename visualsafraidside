        local id = H.mesh(b, { at = o.at, of = o.of, cf = o.cf, off = o.off, anim = o.anim, mesh = key, sx = o.w, sy = o.h, sz = 1, col = o.col or "a", mat = o.mat or "c", tr = o.tr })
