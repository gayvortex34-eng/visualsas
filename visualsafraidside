    mkF("UICorner", { CornerRadius = UDim.new(0, 2) }, ent.hpBg)
    ent.hpStroke = mkF("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ent.hpBg)
    ent.hpFill = mkF("Frame", { BackgroundColor3 = Color3.fromRGB(90, 255, 130), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 1, 0) }, ent.hpBg)
    mkF("UICorner", { CornerRadius = UDim.new(0, 2) }, ent.hpFill)
    ent.hpGrad = mkF("UIGradient", { Rotation = 0 }, ent.hpFill)
    ent.hpSeg = mkF("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 2 }, ent.hpBg)
    mkF("UIGradient", { Rotation = 90, Transparency = SEG_SEQ }, ent.hpSeg)
    local function pill(anchorY, posY, size, font)
        local l = mkF("TextLabel", { BackgroundColor3 = Color3.new(0.04, 0.03, 0.08), BackgroundTransparency = 0.35, BorderSizePixel = 0, Font = font, Text = "", TextSize = size,
            TextColor3 = WHITE, AnchorPoint = Vector2.new(0.5, anchorY), Position = UDim2.new(0.5, 0, anchorY == 1 and 0 or 1, posY),
            Size = UDim2.new(0, 0, 0, size + 6), AutomaticSize = Enum.AutomaticSize.X, Visible = false }, root)
        mkF("UICorner", { CornerRadius = UDim.new(0, 6) }, l)
        mkF("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, l)
        local st = mkF("UIStroke", { Color = WHITE, Thickness = 1, Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, l)
        return l, st
    end
    ent.name, ent.nameStroke = pill(1, -7, 13, Enum.Font.GothamBold)
    ent.info, ent.infoStroke = pill(0, 6, 11, Enum.Font.GothamMedium)
    return ent
end

local function styleSig()
    return table.concat({ cfg.espBox, cfg.espThick, tostring(cfg.espNames), tostring(cfg.espHealth), cfg.espText, cfg.espFill, cfg.espFillStyle or "", tostring(cfg.espGlow),
        tostring(cfg.espGrad), cfg.espHpStyle or "", cfg.espHpSide or "", tostring(cfg.espPill) }, "|")
end

local function applyStyle(ent)
    local style = cfg.espBox
    local th = cfg.espThick
    local strokeStyle = (style == "Box" or style == "Rounded" or style == "Glow")
    local pieceStyle = (style == "Corners" or style == "Brackets")
    local rad = (style == "Rounded") and 9 or ((style == "Glow") and 3 or 0)
    ent.stroke.Enabled = strokeStyle
    ent.stroke.Thickness = th
    ent.rootCorner.CornerRadius = UDim.new(0, rad)
    ent.fillCorner.CornerRadius = UDim.new(0, rad)
    ent.glowCorner.CornerRadius = UDim.new(0, rad + 3)
    ent.glow.Visible = cfg.espGlow and style ~= "Off"
    ent.glowStroke.Thickness = 4 + th * 2
    for _, c in ipairs(ent.corners) do
        c.f.Visible = pieceStyle
        if pieceStyle then
            if style == "Corners" then
                c.f.Size = c.h and UDim2.new(0.3, 0, 0, th) or UDim2.new(0, th, 0.2, 0)
            else
                c.f.Size = c.h and UDim2.new(0.14, 0, 0, th) or UDim2.new(0, th, 0.55, 0)
            end
        end
    end
    local fs = cfg.espFillStyle or "Gradient"
    ent.fill.Visible = style ~= "Off" and fs ~= "Off"
    if fs == "Gradient" then
        ent.fill.BackgroundTransparency = 0
        ent.fillGrad.Enabled = true
        ent.fillGrad.Transparency = NS(K(0, 1), K(0.5, math.min(1, cfg.espFill + (1 - cfg.espFill) * 0.65)), K(1, cfg.espFill))
    else
        ent.fillGrad.Enabled = false
        ent.fill.BackgroundTransparency = cfg.espFill
    end
    local right = cfg.espHpSide == "Right"
    ent.hpBg.AnchorPoint = Vector2.new(right and 0 or 1, 0)
    ent.hpBg.Position = UDim2.new(right and 1 or 0, right and 5 or -5, 0, 0)
    ent.hpBg.Visible = cfg.espHealth
    ent.hpSeg.Visible = cfg.espHealth and cfg.espHpStyle == "Segments"
    local pillOn = cfg.espPill ~= false
    ent.name.BackgroundTransparency = pillOn and 0.35 or 1
    ent.info.BackgroundTransparency = pillOn and 0.35 or 1
    ent.nameStroke.Enabled = pillOn
    ent.infoStroke.Enabled = pillOn
    ent.name.Visible = cfg.espNames
    ent.name.TextSize = cfg.espText
    ent.name.Size = UDim2.new(0, 0, 0, cfg.espText + 6)
    ent.info.TextSize = math.max(8, cfg.espText - 2)
    ent.info.Size = UDim2.new(0, 0, 0, math.max(8, cfg.espText - 2) + 6)
    ent.sig = styleSig()
    ent.colKey = nil
end

local function setColor(ent, col)
    if ent.colKey == col then return end
    ent.colKey = col
    local c2 = second(col)
    local seq = ColorSequence.new({ CK(0, col), CK(0.5, c2), CK(1, col) })
    ent.strokeGrad.Color = seq
    ent.glowStroke.Color = col
    ent.fill.BackgroundColor3 = WHITE
    ent.fillGrad.Color = ColorSequence.new(c2, col)
    for _, c in ipairs(ent.corners) do c.f.BackgroundColor3 = col end
    ent.name.TextColor3 = WHITE
    ent.nameStroke.Color = col
    ent.info.TextColor3 = col:Lerp(WHITE, 0.6)
    ent.infoStroke.Color = col
    if ent.line then ent.line.BackgroundColor3 = col end
    if ent.arrow then ent.arrow.TextColor3 = col; ent.dist.TextColor3 = col:Lerp(WHITE, 0.55) end
end

local function setHp(ent, hp)
    if math.abs(ent.hpv - hp) < 0.004 then return end
    ent.hpv = hp
    ent.hpFill.Size = UDim2.new(1, 0, hp, 0)
    local c = cfg.espHpGrad ~= false and hpColor(hp) or Color3.fromRGB(90, 255, 130)
    ent.hpFill.BackgroundColor3 = WHITE
    ent.hpGrad.Color = ColorSequence.new(c:Lerp(WHITE, 0.3), c)
end

local function drawBox(ent, cx, cy, w, h, hp, nameStr, infoStr, t, animate)
    if ent.sig ~= styleSig() then applyStyle(ent) end
    ent.root.Position = UDim2.fromOffset(cx - w / 2, cy - h / 2)
    ent.root.Size = UDim2.fromOffset(w, h)
    if not ent.shown then ent.shown = true; ent.root.Visible = true end
    setHp(ent, hp)
    if nameStr ~= ent.nm then ent.nm = nameStr; ent.name.Text = nameStr end
    if infoStr ~= ent.txt then ent.txt = infoStr; ent.info.Text = infoStr end
    ent.info.Visible = infoStr ~= ""
    if animate and ent.stroke.Enabled then ent.strokeGrad.Rotation = (t * (cfg.espGradSpin and 90 or 0) + (ent.phase or 0)) % 360 end
end

local function killEnt(ent)
    for _, k in ipairs({ "root", "line", "arrow" }) do
        if ent[k] then pcall(function() ent[k]:Destroy() end) end
    end
end

local function newEnt(rec)
    local gui = ensureGui()
    local ent = buildBox(gui)
    ent.rec = rec
    ent.phase = math.random() * 360
    ent.line = mkF("Frame", { Name = TAG .. "esl", BackgroundColor3 = WHITE, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(10, 1), Visible = false }, gui)
    mkF("UIGradient", { Transparency = NS(K(0, 0.85), K(1, 0.05)) }, ent.line)
    ent.arrow = mkF("TextLabel", { Name = TAG .. "esa", BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "▲", TextSize = 20, TextColor3 = WHITE,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(28, 28), Visible = false }, gui)
    ent.dist = mkF("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "", TextSize = 10, TextColor3 = WHITE,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.fromOffset(60, 12), Visible = false }, ent.arrow)
    return ent
end

local function hideEnt(ent)
    if ent.shown then ent.shown = false; ent.root.Visible = false end
    if ent.tracer then ent.tracer = false; ent.line.Visible = false end
    if ent.arrowOn then ent.arrowOn = false; ent.arrow.Visible = false end
end

local function dropCham(rec)
    if rec.espHL then
        pcall(function() rec.espHL:Destroy() end)
        rec.espHL = nil
        HL.free()
    end
end

local function dropRecEsp(rec)
    dropCham(rec)
    if rec.esp then killEnt(rec.esp); rec.esp = nil end
end

local function teamMate(plr)
    local ok, r = pcall(function() return plr.Team ~= nil and plr.Team == lp.Team end)
    return ok and r
end

local function colorFor(rec, dist, idx)
    local mode = cfg.espColor
    if mode == "Team" then
        local ok, c = pcall(function() return rec.plr.Team and rec.plr.Team.TeamColor.Color end)
        if ok and c then return c end
        return WHITE
    elseif mode == "Health" then
        local hp = rec.hum and clamp(rec.hum.Health / math.max(rec.hum.MaxHealth, 1), 0, 1) or 1
        return hpColor(hp)
    elseif mode == "Rainbow" then
        return hsv(rainbowHue() + idx * 37, 0.8, 1)
    end
    return hsv(cfg.espH, cfg.espS, 1)
end

local function textFor(rec, dist)
    local m = cfg.espNameMode
    local nm
    if m == "Username" then nm = rec.plr.Name
    elseif m == "Both" then nm = rec.plr.DisplayName .. " (@" .. rec.plr.Name .. ")"
    else nm = rec.plr.DisplayName end
    local parts = {}
    if cfg.espDist then parts[#parts + 1] = ("%d st"):format(math.floor(dist + 0.5)) end
    if cfg.espHpText and rec.hum then parts[#parts + 1] = ("%d hp"):format(math.floor(rec.hum.Health + 0.5)) end
    if cfg.espTool and rec.char then
        local tool = rec.char:FindFirstChildOfClass("Tool")
        if tool then parts[#parts + 1] = tool.Name end
    end
    return nm, table.concat(parts, "  |  ")
end

local function cham(rec, col, t)
    local h = rec.espHL
    if not h then
        if not HL.take() then return end
        h = Instance.new("Highlight")
        h.Name = TAG .. "hl"
        h.Adornee = rec.char
        h.Parent = fxFolder()
        rec.espHL = h
    end
    h.DepthMode = cfg.espThrough and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    h.FillColor = col
    h.OutlineColor = col:Lerp(WHITE, 0.55)
    local f = cfg.espFillT
    if cfg.espPulse then f = clamp(f + math.sin(t * 3) * 0.12, 0, 1) end
    h.FillTransparency = f
    h.OutlineTransparency = cfg.espOutT
end

local RATE_DT = { ["Every frame"] = 0, ["30 Hz"] = 1 / 30, ["15 Hz"] = 1 / 15 }

local function espStep(dt)
    if not cfg.espOn then
        if ESP.active then
            ESP.active = false
            for _, rec in pairs(recs) do
                if rec.esp then hideEnt(rec.esp) end
                dropCham(rec)
            end
        end
        return
    end
    ESP.active = true
    local t = os.clock()
    local cm = cam()
    if not cm then return end
    local rdt = RATE_DT[cfg.espRate or "Every frame"] or 0
    if rdt > 0 then
        if t < ESP.nextFrame then return end
        ESP.nextFrame = t + rdt - 0.002
    end
    local sk = styleSig()
    local vp = cm.ViewportSize
    local camCF = cm.CFrame
    local camPos = camCF.Position
    local inv = camCF:Inverse()
    local rangeMax = cfg.espRange
    local doText = t >= ESP.nextText
    if doText then ESP.nextText = t + 0.2 end
    local doColor = t >= ESP.nextColor
    if doColor then ESP.nextColor = t + 0.1 end
    local doAnim = t >= ESP.nextAnim
    if doAnim then ESP.nextAnim = t + 1 / 30 end
    local doCham = t >= ESP.nextCham
    local lead = cfg.espPredict or 0
    local smooth = cfg.espSmooth or 0
    local hs = cfg.espHeight or 1
    local list, idx = {}, 0
    ESP.nShown = 0
    for _, rec in pairs(recs) do
        if not rec.isSelf then
            local ent = rec.esp
            local hrp, hum = rec.hrp, rec.hum
            local ok = hrp and hrp.Parent and hum and hum.Health > 0
            local dist = ok and (hrp.Position - camPos).Magnitude or 0
            if ok and dist > rangeMax then ok = false end
            if ok and cfg.espTeam and teamMate(rec.plr) then ok = false end
            if not ok then
                if ent then hideEnt(ent) end
                if rec.espHL then dropCham(rec) end
            else
                idx = idx + 1
                list[#list + 1] = { rec = rec, dist = dist }
                ent = ent or newEnt(rec)
                rec.esp = ent
                if ent.sig ~= sk then applyStyle(ent) end
                if doColor or not ent.colKey then setColor(ent, colorFor(rec, dist, idx)) end
                local pos = hrp.Position
                if lead > 0 then pos = pos + hrp.AssemblyLinearVelocity * lead end
                local sTop = cm:WorldToViewportPoint(pos + Vector3.new(0, 2.7 * hs, 0))
                local sBot = cm:WorldToViewportPoint(pos + Vector3.new(0, rec.feetY * hs - 0.1, 0))
                local front = sTop.Z > 0 and sBot.Z > 0
                local drawn = false
                if front then
                    local h = math.max(math.abs(sBot.Y - sTop.Y), 8)
                    local w = math.max(h * 0.55 * cfg.espWidth, 5)
                    local cx, cy = (sTop.X + sBot.X) / 2, (sTop.Y + sBot.Y) / 2
                    if cx > -w and cx < vp.X + w and cy > -h and cy < vp.Y + h then
                        drawn = true
                        ESP.nShown = ESP.nShown + 1
                        if smooth > 0 and ent.sx then
                            local a = 1 - smooth ^ (dt * 60)
                            ent.sx = ent.sx + (cx - ent.sx) * a; ent.sy = ent.sy + (cy - ent.sy) * a
                            ent.sw = ent.sw + (w - ent.sw) * a; ent.sh = ent.sh + (h - ent.sh) * a
                        else
                            ent.sx, ent.sy, ent.sw, ent.sh = cx, cy, w, h
                        end
                        local hp = clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        if doText or not ent.shown then
                            local nm, info = textFor(rec, dist)
                            ent.pn, ent.pi = nm, info
                        end
                        if cfg.espBox ~= "Off" or cfg.espNames or cfg.espHealth or cfg.espDist then
                            drawBox(ent, ent.sx, ent.sy, ent.sw, ent.sh, hp, ent.pn or "", ent.pi or "", t, doAnim)
                        end
                        if cfg.espTracer then
                            local fy = (cfg.espTracerFrom == "Top") and 0 or (cfg.espTracerFrom == "Center" and vp.Y / 2 or vp.Y)
                            local x0, y0 = vp.X / 2, fy
                            local x1, y1 = cx, sBot.Y
                            local dx, dy = x1 - x0, y1 - y0
                            local len = math.sqrt(dx * dx + dy * dy)
                            ent.line.Size = UDim2.fromOffset(len, cfg.espTracerW)
                            ent.line.Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2)
                            ent.line.Rotation = math.deg(math.atan2(dy, dx))
                            if not ent.tracer then ent.tracer = true; ent.line.Visible = true end
                        elseif ent.tracer then ent.tracer = false; ent.line.Visible = false end
                    end
                end
                if not drawn then
                    ent.sx = nil
                    if ent.shown then ent.shown = false; ent.root.Visible = false end
                    if ent.tracer then ent.tracer = false; ent.line.Visible = false end
                    if cfg.espArrows then
                        local rel = inv * pos
                        local dx, dy = rel.X, -rel.Y
                        if front == false and rel.Z > 0 then dx, dy = -dx, -dy end
                        local m = math.sqrt(dx * dx + dy * dy)
                        if m < 0.001 then dx, dy, m = 0, 1, 1 end
                        dx, dy = dx / m, dy / m
                        local R = math.min(vp.X, vp.Y) * 0.5 * cfg.espArrowR
                        ent.arrow.Position = UDim2.fromOffset(vp.X / 2 + dx * R * (vp.X / math.min(vp.X, vp.Y)) * 0.8, vp.Y / 2 + dy * R)
                        ent.arrow.Rotation = math.deg(math.atan2(dy, dx)) + 90
                        if doText then ent.dist.Text = ("%d"):format(math.floor(dist + 0.5)) end
                        if not ent.arrowOn then ent.arrowOn = true; ent.arrow.Visible = true; ent.dist.Visible = cfg.espDist end
                    elseif ent.arrowOn then ent.arrowOn = false; ent.arrow.Visible = false end
                elseif ent.arrowOn then
                    ent.arrowOn = false
                    ent.arrow.Visible = false
                end
            end
        end
    end
    if doCham then
        ESP.nextCham = t + ((Gov.tier or 0) >= 3 and 0.5 or 0.25)
        local keep = {}
        if cfg.espChams then
            table.sort(list, function(a, b) return a.dist < b.dist end)
            local cap = math.max(1, math.floor(HL.cap * math.max(Gov.fxMul or 1, 0.5)))
            for i = 1, math.min(#list, cap) do keep[list[i].rec] = i end
        end
        local n = 0
        for _, rec in pairs(recs) do
            if not rec.isSelf then
                local i = keep[rec]
                if i then
                    cham(rec, colorFor(rec, 0, i), t)
                    if rec.espHL then n = n + 1 end
                elseif rec.espHL then
                    dropCham(rec)
                end
            end
        end
        ESP.nChams = n
    elseif cfg.espChams and (cfg.espPulse or cfg.espColor == "Rainbow") then
        for _, rec in pairs(recs) do
            if rec.espHL then cham(rec, colorFor(rec, 0, 1), t) end
        end
    end
end

function M.newPreview(parent)
    local ent = buildBox(parent)
    ent.phase = 0
    return {
        ent = ent,
        draw = function(cx, cy, w, h, hp, nm, info, col, t)
            if ent.sig ~= styleSig() then applyStyle(ent) end
            if ent.colKey ~= col then setColor(ent, col) end
            drawBox(ent, cx, cy, w, h, hp, nm, info, t, true)
        end,
        hide = function() hideEnt(ent) end,
        destroy = function() pcall(function() ent.root:Destroy() end) end,
    }
end
function M.previewColor(i) return colorFor({ plr = lp, hum = nil }, 0, i or 1) end

local RD = { root = nil, stroke = nil, sweep = nil, dots = {}, sig = nil, nextTheme = 0, mark = nil }
local RPOS = {
    ["Top Left"] = { 0, 0, 16, 56 }, ["Top Right"] = { 1, 0, -16, 56 }, ["Bottom Left"] = { 0, 1, 16, -60 },
    ["Bottom Right"] = { 1, 1, -16, -60 }, ["Left Middle"] = { 0, 0.5, 16, 0 }, ["Right Middle"] = { 1, 0.5, -16, 0 },
}
M.RADAR_POS = { "Top Right", "Top Left", "Bottom Right", "Bottom Left", "Left Middle", "Right Middle" }

local function radarAcc() return (T and T.acc) or Color3.fromRGB(150, 98, 255) end

local function buildRadar()
    local g = ensureGui()
    local acc = radarAcc()
    local root = mkF("Frame", { Name = TAG .. "radar", BackgroundColor3 = Color3.fromRGB(10, 8, 18), BackgroundTransparency = 0.28, BorderSizePixel = 0,
        Size = UDim2.fromOffset(150, 150), Visible = false }, g)
    mkF("UICorner", { CornerRadius = UDim.new(0.5, 0) }, root)
    RD.stroke = mkF("UIStroke", { Color = acc, Thickness = 2, Transparency = 0.12, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, root)
    for _, k in ipairs({ 0.66, 0.33 }) do
        local r = mkF("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(k, k) }, root)
        mkF("UICorner", { CornerRadius = UDim.new(0.5, 0) }, r)
        mkF("UIStroke", { Color = acc, Thickness = 1, Transparency = 0.72, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, r)
    end
    mkF("Frame", { BackgroundColor3 = acc, BackgroundTransparency = 0.82, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -14, 0, 1) }, root)
    mkF("Frame", { BackgroundColor3 = acc, BackgroundTransparency = 0.82, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 1, 1, -14) }, root)
    local wrap = mkF("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(0.94, 0.94) }, root)
    local bar = mkF("Frame", { BackgroundColor3 = acc, BackgroundTransparency = 0, BorderSizePixel = 0, Position = UDim2.new(0.5, 0, 0.5, -1), Size = UDim2.new(0.5, 0, 0, 2) }, wrap)
    mkF("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }) }, bar)
    RD.sweep, RD.bar = wrap, bar
    RD.mark = mkF("TextLabel", { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "▲", TextSize = 13, TextColor3 = acc,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16) }, root)
    RD.root = root
    RD.dots = {}
    RD.sig = nil
    return root
end

local function newDot()
    local d = mkF("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6), Visible = false }, RD.root)
    mkF("UICorner", { CornerRadius = UDim.new(0.5, 0) }, d)
    mkF("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, d)
    RD.dots[#RD.dots + 1] = d
    return d
end

local function radarStep(dt, t)
    if not cfg.radarOn then
        if RD.root and RD.root.Visible then RD.root.Visible = false end
        return
    end
    local cm = cam()
    if not cm then return end
    if not (RD.root and RD.root.Parent) then buildRadar() end
    local root = RD.root
    local S = cfg.radarSize
    local sig = cfg.radarPos .. "|" .. S .. "|" .. cfg.radarDot
    if RD.sig ~= sig then
        RD.sig = sig
        local p = RPOS[cfg.radarPos] or RPOS["Top Right"]
        root.AnchorPoint = Vector2.new(p[1], p[2])
        root.Position = UDim2.new(p[1], p[3], p[2], p[4])
        root.Size = UDim2.fromOffset(S, S)
        for _, d in ipairs(RD.dots) do d.Size = UDim2.fromOffset(cfg.radarDot, cfg.radarDot) end
    end
    if not root.Visible then root.Visible = true end
    if cfg.radarSweep then
        if not RD.sweep.Visible then RD.sweep.Visible = true end
        RD.sweep.Rotation = (t * 110) % 360
    elseif RD.sweep.Visible then
        RD.sweep.Visible = false
    end
    if t >= RD.nextTheme then
        RD.nextTheme = t + 0.5
        local acc = radarAcc()
        RD.stroke.Color = acc
        RD.bar.BackgroundColor3 = acc
        RD.mark.TextColor3 = acc
    end
    local me = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
