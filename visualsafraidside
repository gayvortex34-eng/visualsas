        local id = H.mesh(b, { at = o.at, of = o.of, cf = o.cf, off = o.off, anim = o.anim, mesh = key, sx = sc, sy = sc, sz = sc, col = o.col or "a", mat = o.mat or "s", tr = o.tr })
