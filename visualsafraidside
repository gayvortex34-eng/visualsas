    local aEnd = atan2(ty, tx - d)
    for i = 1, n2 - 1 do
        local a = (ang0 + TAU) + (aEnd - (ang0 + TAU)) * i / n2
        pts[#pts + 1] = { d + r2 * cos(a), r2 * sin(a) }
    end
