local function outline2(pts, seg)
    local n = #pts
    local corners = {}
    for i = 1, n do if pts[i][3] == 1 then corners[#corners + 1] = i end end
    local out = {}
    if #corners == 0 then
        for i = 1, n do
            local p0, p1, p2, p3 = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1], pts[(i + 1) % n + 1]
            for s = 0, seg - 1 do
                local t = s / seg
                local t2, t3 = t * t, t * t * t
                local q = {}
                for k = 1, 2 do
                    q[k] = 0.5 * ((2 * p1[k]) + (-p0[k] + p2[k]) * t + (2 * p0[k] - 5 * p1[k] + 4 * p2[k] - p3[k]) * t2 + (-p0[k] + 3 * p1[k] - 3 * p2[k] + p3[k]) * t3)
                end
                out[#out + 1] = q
            end
        end
    else
        local nc = #corners
        for ci = 1, nc do
            local a, b = corners[ci], corners[ci % nc + 1]
            local list = { { pts[a][1], pts[a][2], 0 } }
            local i = a % n + 1
            while true do
                list[#list + 1] = { pts[i][1], pts[i][2], 0 }
                if i == b then break end
                i = i % n + 1
            end
            local sp = K.spline(list, seg)
            for k = 1, #sp - 1 do out[#out + 1] = { sp[k][1], sp[k][2] } end
        end
    end
    local area = 0
    for i = 1, #out do
        local p, q = out[i], out[i % #out + 1]
        area = area + p[1] * q[2] - q[1] * p[2]
    end
    if area < 0 then
        local r = {}
        for i = #out, 1, -1 do r[#r + 1] = out[i] end
        out = r
    end
    return out
end
