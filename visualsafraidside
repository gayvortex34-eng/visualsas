end

function S.petals(ops, g, r0, n, len, w, hz, y, pp, q, ra)
    ops[#ops + 1] = { k = "spindle", g = g, pp = pp or 1.6, q = q or 0.9, s = { len, w, hz }, p = { r0 + len / 2, y or 0, 0 }, rep = n, ra = ra }
end

function S.gems(ops, g, R, n, len, w, y, ra, sides)
    ops[#ops + 1] = { k = "crystal", g = g, f = 0.5, sides = sides or 4, s = { len, w, w }, r = { 0, 0, 90 }, p = { R, (y or 0) + len / 2, 0 }, rep = n, ra = ra }
end

local GL = {
    { { -1, 0, 1, 0 }, { 0.2, 0, 1, 0.8 }, { -0.6, 0, 0.2, 0.8 } },
