    S.fly.on = false
    S.fly.saved = nil
    S.fly.vel = zero
    S.nc.on, S.nc.set = false, {}
    S.fr.on = false
    S.ws.base, S.ws.mine = nil, nil
    S.jp.base, S.jp.mine = nil, nil
    S.ij.used = 0
    S.dash.t0 = -10
    S.gld.on, S.clb.on, S.clb.was = false, false, false
    S.tw = nil
    S.ms.f = 0
