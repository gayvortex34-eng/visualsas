local function paintSet(set, force)
    local pals = {}
    for _, name in ipairs(set.names) do pals[DEFS[name]] = M.palette(DEFS[name]) end
    local op = clamp(cfg.accOpacity or 1, 0.1, 1)
    for i, p in ipairs(set.pcs) do
        local part = set.parts[i]
        if part and not p.ghost then
            local c = colorOf(pals, p)
            if force or part.Color ~= c then part.Color = c end
            local m = M.pieceMaterial(p)
            if force or part.Material ~= m then part.Material = m end
            local tr = 1 - (1 - p.tr) * op
            if force or math.abs(part.Transparency - tr) > 0.004 then part.Transparency = tr end
        end
    end
    if set.emit then paintEmit(set, pals, force) end
end

local function dropSet(rec)
    local set = rec.accSet
    if set then
        ACC.parts = math.max(0, ACC.parts - (set.count or 0))
        if not set.isSelf then ACC.otherParts = math.max(0, ACC.otherParts - (set.count or 0)) end
        if set.model then pcall(function() set.model:Destroy() end) end
        rec.accSet = nil
    end
end

local function newPart(p)
    local part
    if p.shape == "w" then
        part = Instance.new("WedgePart")
    else
        part = Instance.new("Part")
        if p.shape == "c" then part.Shape = Enum.PartType.Cylinder end
        if p.shape == "s" then
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.Sphere
            mesh.Parent = part
        elseif p.shape == "m" then
            local url = MESH.ensure(p.mesh)
            local mesh = Instance.new("SpecialMesh")
            if url then
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = url
                mesh.Scale = p.msc or Vector3.new(1, 1, 1)
            else
                mesh.MeshType = Enum.MeshType.Sphere
            end
            mesh.Parent = part
        end
    end
    part.Name = TAG .. "ac"
    part.Anchored = false
    part.CanCollide = false; part.CanQuery = false; part.CanTouch = false; part.CastShadow = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth; part.BottomSurface = Enum.SurfaceType.Smooth
    local sz = p.bound or p.size
    part.Size = Vector3.new(math.max(sz.X, 0.05), math.max(sz.Y, 0.05), math.max(sz.Z, 0.05))
    if p.ghost then part.Transparency = 1 end
    return part
end

local function makeEmitter(part, f, sc)
    local pe = Instance.new("ParticleEmitter")
    pe.Name = TAG .. "pe"
    local s0, s1, s2 = f.size[1] * sc, f.size[2] * sc, f.size[3] * sc
    local mid = f.tr or 0.2
    local acc = f.acc or { 0, 0, 0 }
    local sp = f.spread or 180
    applyProps(pe, {
        Texture = TX(f.tex or "glow"), LightInfluence = 0, LightEmission = f.light or 1, Rate = 0,
        Lifetime = NumberRange.new(f.life[1], f.life[2]), Speed = NumberRange.new(f.speed[1] * sc, f.speed[2] * sc),
        SpreadAngle = Vector2.new(sp, sp), Acceleration = Vector3.new(acc[1] * sc, acc[2] * sc, acc[3] * sc), Drag = f.drag or 0,
        Rotation = NumberRange.new(f.rot and f.rot[1] or 0, f.rot and f.rot[2] or 360), RotSpeed = NumberRange.new(f.rs and f.rs[1] or 0, f.rs and f.rs[2] or 0),
        LockedToPart = f.locked and true or false,
        Size = NS(K(0, s0), K(f.pk or 0.3, s1), K(1, s2)),
        Transparency = NS(K(0, 1), K(f.fin or 0.14, mid), K(f.hold or 0.62, mid), K(1, 1)),
        Shape = Enum.ParticleEmitterShape.Box, ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
    })
    if f.orient then pcall(function() pe.Orientation = Enum.ParticleOrientation.VelocityParallel end) end
    pe.Parent = part
    return pe
end

paintEmit = function(set, pals, force)
    for _, e in ipairs(set.emit) do
        local pl = pals[e.p.def]
        local keys = e.f.col or { "a", "b" }
        local c1, c2, c3 = pl[keys[1]] or pl.a, pl[keys[2]] or pl.b, keys[3] and (pl[keys[3]] or pl.w) or nil
        if force or e.c1 ~= c1 or e.c2 ~= c2 or e.c3 ~= c3 then
            e.c1, e.c2, e.c3 = c1, c2, c3
            local seq
            if c3 then seq = ColorSequence.new({ CK(0, c1), CK(0.5, c2), CK(1, c3) }) else seq = ColorSequence.new({ CK(0, c1), CK(1, c2) }) end
            setp(e.pe, "Color", seq)
        end
    end
end

local function fxTick(rec)
    local set = rec.accSet
    if not set or not set.emit then return end
    local fac = 0
    if cfg.wingFx then
        fac = clamp(cfg.wingFxAmt or 1, 0, 3) * math.max(Gov.fxMul or 1, 0.25)
        if not set.isSelf then fac = fac * 0.5 end
    end
    for _, e in ipairs(set.emit) do
        local r = ((e.f.main or set.isSelf) and fac > 0) and e.f.rate * fac or 0
        if e.rate ~= r then
            e.rate = r
            setp(e.pe, "Rate", r)
            setp(e.pe, "Enabled", r > 0)
        end
    end
end

local function buildSet(rec, names)
    local rig = rigOf(rec)
    if not rig then return nil end
    local pcs = pieceList(names, rig)
    if not rec.isSelf and ACC.otherParts + #pcs > PART_CAP then rec.accWhy = "part cap"; return nil end
    rec.accWhy = nil
    local t = os.clock()
    local mem = {}
    local st = { speed = 0, air = false, sx = 0, sy = 0, sz = 0, yaw = 0, dt = 0, mem = mem }
    local att = {}
    for k, v in pairs(rig.att) do att[k] = v.p.CFrame * v.o end
    local lay = M.layout(pcs, att, t, st)
    local model = Instance.new("Model")
    model.Name = TAG .. "acc"
    local set = { names = names, sig = table.concat(names, ",") .. "|" .. rig.sig, pcs = pcs, parts = {}, welds = {}, anim = {}, model = model, rig = rig, count = #pcs, isSelf = rec.isSelf, mem = mem }
    for i, p in ipairs(pcs) do
        local part = newPart(p)
        part.CFrame = lay[i]
        part.Parent = model
        set.parts[i] = part
        if p.fx then
            set.emit = set.emit or {}
            for _, f in ipairs(p.fx) do set.emit[#set.emit + 1] = { pe = makeEmitter(part, f, rig.ctx.scale or 1), f = f, p = p, rate = 0 } end
        end
    end
    for i, p in ipairs(pcs) do
        local w = Instance.new("Weld")
        w.Name = TAG .. "w"
        local base, p0
        if p.of then
            base, p0 = CFrame.new(), set.parts[p.of]
        else
            local a = rig.att[p.at] or rig.att.torso
            base, p0 = a.o, a.p
        end
        w.Part0 = p0
        w.Part1 = set.parts[i]
        local a0 = p.anim and p.anim(t, st) or CFrame.new()
        w.C0 = base * p.cf * a0 * p.off
        w.C1 = CFrame.new()
        w.Parent = set.parts[i]
        set.welds[i] = w
        if p.anim then set.anim[#set.anim + 1] = { i = i, p = p, base = base } end
    end
    paintSet(set, true)
    if set.emit then fxTick({ accSet = set }) end
    model.Parent = FX.folder()
    ACC.parts = ACC.parts + set.count
    if not rec.isSelf then ACC.otherParts = ACC.otherParts + set.count end
    return set
end

local function syncAcc(rec, budget)
    if not rec.hrp or not rec.hrp.Parent then return true end
    local names = selectedNames()
    if wantAcc(rec) and #names > 0 then
        local rig0 = rigOf(rec)
        local sg = rig0 and (table.concat(names, ",") .. "|" .. rig0.sig)
        local cur = rec.accSet
        if cur and cur.sig == sg then
            paintSet(cur, false)
        else
            if not rec.isSelf and budget and budget.n <= 0 then return false end
            dropSet(rec)
            if budget and not rec.isSelf then budget.n = budget.n - 1 end
            rec.accSet = buildSet(rec, names)
        end
    else
        dropSet(rec)
    end
    rec.accMask = (wantAcc(rec) and "1" or "0")
    return true
end

local function motionOf(rec, set, dt)
    local hrp = rec.hrp
    local cf = hrp.CFrame
    local lv = cf:VectorToObjectSpace(hrp.AssemblyLinearVelocity)
    local look = cf.LookVector
    local m = set.mot
    if not m then
        m = { sx = 0, sy = 0, sz = 0, yaw = 0, look = look }
        set.mot = m
    end
    dt = math.max(dt, 1 / 120)
    local k = 1 - math.exp(-math.min(dt, 0.25) * 8)
    m.sx = m.sx + (lv.X - m.sx) * k
    m.sy = m.sy + (lv.Y - m.sy) * k
    m.sz = m.sz + (-lv.Z - m.sz) * k
    local rate = -(m.look.X * look.Z - m.look.Z * look.X) / dt
    m.yaw = m.yaw + (math.max(-8, math.min(8, rate)) - m.yaw) * (1 - math.exp(-math.min(dt, 0.25) * 10))
    m.look = look
    return m
end

local function horizSpeedOf(hrp)
    local v = hrp.AssemblyLinearVelocity
    return math.sqrt(v.X * v.X + v.Z * v.Z)
end

function M.step(dt)
    local recs = FX.recs
    local t = os.clock()
    MESH.setDetail(cfg.meshDetail)
    if dirty.acc and t >= ACC.nextSync then
        dirty.acc = false
        ACC.nextSync = t + 0.1
        local budget = { n = 2 }
        for _, rec in pairs(recs) do
            local ok, res = pcall(syncAcc, rec, budget)
            if not ok then report("accessories", res) elseif res == false then dirty.acc = true end
        end
    end
    if t >= ACC.nextScan then
        ACC.nextScan = t + 0.25
        for _, rec in pairs(recs) do
            local m = wantAcc(rec) and "1" or "0"
            if m ~= rec.accMask or (m == "1" and not rec.accSet and #selectedNames() > 0) then
                local ok, err = pcall(syncAcc, rec, { n = 1 })
                if not ok then report("accessories", err) end
            end
        end
    end
    if (cfg.accRainbow) and cfg.accOn and t >= ACC.nextColor then
        ACC.nextColor = t + 0.12
        for _, rec in pairs(recs) do
            if rec.accSet then pcall(paintSet, rec.accSet, false) end
        end
    end
    if t >= (ACC.nextFx or 0) then
        ACC.nextFx = t + 0.25
        for _, rec in pairs(recs) do if rec.accSet and rec.accSet.emit then fxTick(rec) end end
    end
    if not cfg.accAnim then return end
    ACC.acc = ACC.acc + dt
    local others = ACC.acc >= 0.05
    for _, rec in pairs(recs) do
        local set = rec.accSet
        if set and #set.anim > 0 and (rec.isSelf or others) and rec.hrp and rec.hrp.Parent then
            local sdt = rec.isSelf and dt or ACC.acc
            local mo = motionOf(rec, set, sdt)
            local st = { speed = horizSpeedOf(rec.hrp), air = (rec.hum and rec.hum.FloorMaterial == Enum.Material.Air) or false,
                sx = mo.sx, sy = mo.sy, sz = mo.sz, yaw = mo.yaw, dt = sdt, mem = set.mem }
            for _, a in ipairs(set.anim) do
                local ok, c = pcall(a.p.anim, t, st)
                if ok then set.welds[a.i].C0 = a.base * a.p.cf * c * a.p.off end
            end
        end
    end
    if others then ACC.acc = 0 end
end

