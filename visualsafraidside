local function ringAtts(e, hrp, n, radiusFn, yFn, outTilt)
    local list = {}
    local rec = e.rec
    local gl = rec ~= nil and hrp == rec.hrp and e.isGround ~= nil and e.isGround(yFn())
    local par = gl and e.groundPart() or hrp
    local yo = gl and rec.feetY or 0
    for k = 1, n do
        local a = (k / n) * math.pi * 2
        local at = e.att(par, Vector3.new())
        list[k] = { at = at, a = a }
    end
    local function place()
        local r, y = radiusFn(), yFn() - yo
        for _, it in ipairs(list) do
            local pos = Vector3.new(math.cos(it.a) * r, y, math.sin(it.a) * r)
            if outTilt then
                it.at.CFrame = CFrame.new(pos) * CFrame.Angles(0, -it.a, 0) * CFrame.Angles(0, 0, -outTilt)
            else
                it.at.Position = pos
            end
        end
    end
    place()
    e.rf[#e.rf + 1] = place
    return list
end

