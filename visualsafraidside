local RIP_MAX = 8

local function spawnRipple(x, y)
    local g = guiOver()
    local r
    for i = 1, RIP_MAX do
        local c = H.rip[i]
        if not c then
            c = { f = mkF("ImageLabel", { Name = TAG .. "rp", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(20, 20), Visible = false }, g), on = false }
            H.rip[i] = c
        end
        if not c.on then r = c break end
    end
    if not r then r = H.rip[1] end
    r.on = true
    r.born = os.clock()
    r.f.Image = TX(CURS_TEX[cfg.cursStyle] or "ring")
    r.f.ImageColor3 = hsv(cfg.cursH, cfg.cursS, 1)
    r.f.Position = UDim2.fromOffset(x, y)
    r.f.Rotation = (cfg.cursStyle == "Ring") and 0 or math.random(0, 90)
    r.f.Visible = true
end

local function cursStep(dt, t)
    for _, r in ipairs(H.rip) do
        if r.on then
            local f = (t - r.born) / 0.55
            if f >= 1 then
                r.on = false
                r.f.Visible = false
            else
                local e = 1 - (1 - f) ^ 3
                local s = (14 + cfg.cursSize * e)
                r.f.Size = UDim2.fromOffset(s, s)
                r.f.ImageTransparency = 0.15 + f * 0.85
            end
        end
    end
    if cfg.cursTrail and (Gov.tier or 0) < 3 then
        local ok, m = pcall(function() return UIS:GetMouseLocation() end)
        local g = guiOver()
        local n = cfg.cursTrailLen
        if ok and m then
            local hist = H.hist
            table.insert(hist, 1, { m.X, m.Y })
            while #hist > n + 1 do table.remove(hist) end
        end
        local acc, acc2 = hsv(cfg.cursH, cfg.cursS, 1), hsv(cfg.cursH + 50, cfg.cursS, 1)
        for i = 1, n do
            local d = H.trail[i]
            if not d then
                d = mkF("ImageLabel", { Name = TAG .. "tr", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Image = TX("glow"), Visible = false, Size = UDim2.fromOffset(16, 16) }, g)
                H.trail[i] = d
            end
            local h = H.hist[i]
            if h then
                local f = (i - 1) / n
                d.Position = UDim2.fromOffset(h[1], h[2])
                local s = 22 * (1 - f * 0.8)
                d.Size = UDim2.fromOffset(s, s)
                d.ImageColor3 = acc:Lerp(acc2, f)
                d.ImageTransparency = 0.25 + f * 0.75
                d.Visible = true
            else
                d.Visible = false
            end
        end
        for i = n + 1, #H.trail do if H.trail[i].Visible then H.trail[i].Visible = false end end
    elseif #H.trail > 0 then
        for _, d in ipairs(H.trail) do if d.Visible then d.Visible = false end end
        H.hist = {}
    end
end

function M.step(dt)
    local t = os.clock()
    local P, amt = fltStep(dt)
    overlayStep(dt, t, P, amt)
    linesStep(dt, t)
    local anyHud = cfg.hudOn and (cfg.hudFps or cfg.hudPing or cfg.hudClock or cfg.hudSpeed or cfg.hudPos2 or cfg.hudPlayers)
    if anyHud then
        if not H.pill or not H.pill.root.Parent then buildPill() end
        if H.pillSig ~= pillSig() then applyPill() end
        H.pill.root.Visible = true
        if t >= H.nextTxt then
            H.nextTxt = t + 0.25
            pillText()
        end
    elseif H.pill and H.pill.root.Visible then
        H.pill.root.Visible = false
    end
    if cfg.ksOn then
        if not H.ks or not H.ks.root.Parent then buildKeys() end
        if H.ksSig ~= (cfg.ksPos .. cfg.ksScale .. cfg.hudPos .. tostring(cfg.hudFps)) then placeKeys() end
        H.ks.root.Visible = true
        keysStep(dt, t)
    elseif H.ks and H.ks.root.Visible then
        H.ks.root.Visible = false
    end
    if t >= H.nextTheme then
        H.nextTheme = t + 0.6
        if T.acc ~= H.lastAcc then H.lastAcc = T.acc; themePill() end
    end
    if cfg.cursOn then cursStep(dt, t)
    elseif #H.rip > 0 or #H.trail > 0 then
        for _, r in ipairs(H.rip) do r.on = false; r.f.Visible = false end
        for _, d in ipairs(H.trail) do d.Visible = false end
        H.hist = {}
    end
end

function M.start()
    bind(UIS.InputBegan, function(i, gp)
        local ut = i.UserInputType
        if ut == Enum.UserInputType.MouseButton1 then
            H.clicks[#H.clicks + 1] = os.clock()
        end
        if not cfg.cursOn then return end
        if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.MouseButton2 then
            local ok, m = pcall(function() return UIS:GetMouseLocation() end)
            if ok and m then spawnRipple(m.X, m.Y) end
        elseif ut == Enum.UserInputType.Touch then
            spawnRipple(i.Position.X, i.Position.Y)
        end
    end)
end

function M.stats()
    local n = 0
    for _, r in ipairs(H.rip) do if r.on then n = n + 1 end end
    return { ripples = n, filter = H.flt ~= nil }
end

function M.cleanup()
    for _, k in ipairs({ "flt", "fltB" }) do if H[k] then pcall(function() H[k]:Destroy() end); H[k] = nil end end
    for _, k in ipairs({ "under", "over" }) do if H[k] then pcall(function() H[k]:Destroy() end); H[k] = nil end end
end

return M
