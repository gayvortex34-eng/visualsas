local function nrm3(v) local l = sqrt(v[1] * v[1] + v[2] * v[2] + v[3] * v[3]) + 1e-9; return { v[1] / l, v[2] / l, v[3] / l } end
local function cross3(a, c) return { a[2] * c[3] - a[3] * c[2], a[3] * c[1] - a[1] * c[3], a[1] * c[2] - a[2] * c[1] } end
local function frame3(d, z0)
    local X = nrm3(d)
    local dot = X[1] * z0[1] + X[2] * z0[2] + X[3] * z0[3]
    local Z = nrm3({ z0[1] - dot * X[1], z0[2] - dot * X[2], z0[3] - dot * X[3] })
    return { X, cross3(Z, X), Z }
end
local T0, U0, N0 = { 0, 0, -1 }, { 0, 1, 0 }, { 1, 0, 0 }
local function rooted(kind, g, alpha, R, y, d, len, sx, sy, sz, extra)
    local fr = frame3(d, N0)
    local X = fr[1]
    local op = { k = kind, g = g, fr = fr, p = { R + X[1] * len / 2, y + X[2] * len / 2, X[3] * len / 2 }, s = { sx, sy, sz }, ra = alpha }
    if extra then for kk, v in pairs(extra) do op[kk] = v end end
    return op
end
local function dirTU(s, phi, theta)
    local c, sn = cos(rad(phi)), sin(rad(phi))
    local ct, st = cos(rad(theta or 0)), sin(rad(theta or 0))
    local x = s * T0[1] * c + U0[1] * sn
    local y = s * T0[2] * c + U0[2] * sn
    local z = s * T0[3] * c + U0[3] * sn
    return { x * ct + N0[1] * st, y * ct + N0[2] * st, z * ct + N0[3] * st }
end

