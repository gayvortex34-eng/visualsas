                for f = 0, 6 do
                    local x = (f / 6 - 0.5) * 0.46
                    ops2[#ops2 + 1] = { k = "tube", g = 3, pts = { { x, -h * 0.97, zp }, { x, -h - 0.1, zp }, { x, -h - 0.22, zp } }, r0 = 0.022, r1 = 0.012, sides = 5, seg = 2 }
