local function rim(g, y, R, t, s, tilt, hgt) return { k = "torus", g = g, a = t / R, b = hgt or t, s = { R, 1, R }, p = { 0, y, 0 }, r = { 0, 0, -s * (tilt or 0) } } end
local function tl(s, tilt, x, y, z)
    local a = rad(tilt or 0) * s
    return { x * cos(a) + y * sin(a), -x * sin(a) + y * cos(a), z }
end

local function shell(o, s, p)
    local Rr, T = p.R, p.tilt
    local a = rad(T) * s
    local function rot(v) return { v[1] * cos(a) + v[2] * sin(a), -v[1] * sin(a) + v[2] * cos(a), v[3] } end
    for ri, row in ipairs(p.rows) do
        local th = rad(row.th)
        for k = 0, row.n - 1 do
            local ph = (k + 0.5 * (ri % 2)) / row.n * TAU
            local n = { sin(th) * cos(ph), cos(th), sin(th) * sin(ph) }
            local down = { cos(th) * cos(ph), -sin(th), cos(th) * sin(ph) }
            local X = unit3(add3(down, n, p.lift or 0.3))
            local Zn = unit3(add3(n, down, -(p.lift or 0.3)))
            local f = { rot(X), rot(cross3(Zn, X)), rot(Zn) }
            local wdt = max(0.26, TAU * Rr * sin(th) / row.n * (p.wmul or 1.3))
            local pos = rot({ n[1] * Rr, n[2] * Rr * (p.sy or 0.9) + p.cy, n[3] * Rr })
