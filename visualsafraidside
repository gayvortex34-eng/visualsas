    local right = c:Cross(V3(0, 1, 0))
    if right.Magnitude < 1e-3 then right = V3(1, 0, 0) end
    right = right.Unit
    local up = right:Cross(c)
    local insts = {}
    local nE = #edges
    local F = {
        id = ST.nextId, kind = kind, insts = insts, nodes = {}, edges = {}, born = t, ang = ang, laz = laz, el = el, dir = c,
        drawT = (cfg.constDraw ~= false) and (1.4 + 0.45 * nE) or 0, fadeT = 1.8, ph = random() * 10, lm = 0.7 + 0.6 * random(),
        prog = -1, vis = -1, sv = -1, ck = -1,
    }
    ST.nextId = ST.nextId + 1
    local showNodes = cfg.constNodes ~= false
    for i, p in ipairs(pts) do
        local d = (c + (right * p[1] + up * p[2]) * tanR).Unit
        local pos = d * R
        local N = { pos = pos, bright = 0.75 + 0.25 * random(), ph = random() * 6.28, first = 1, tw = 1 }
        N.at = newAtt(dome, insts, pos)
        if showNodes then
            N.ut = (up - d * d:Dot(up)).Unit
            N.s0, N.s1 = newAtt(dome, insts, pos), newAtt(dome, insts, pos)
            N.beam = newBeam(dome, insts, "cs", N.s0, N.s1)
            N.beam.Texture = TX("sparkle4")
        end
        F.nodes[i] = N
    end
    for k, ed in ipairs(edges) do
        local A, B = F.nodes[ed[1]], F.nodes[ed[2]]
        local E = { i = ed[1], j = ed[2], len = math.max((A.pos - B.pos).Magnitude, 0.001), p = -1, al = -1, g = 0.1 }
        E.beam = newBeam(dome, insts, "cb", A.at, B.at)
        F.edges[k] = E
        A.first = math.min(A.first, (k - 1) / nE)
        B.first = math.min(B.first, k / nE)
    end
    return F
end

local function lineSeq(g, p, a)
    local x1 = math.min(p, 1 - g)
    if x1 - g < 0.004 or a <= 0.004 then return CLEAR end
    local e = math.min(0.07, (x1 - g) * 0.35)
    local v = 1 - a
    return NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(g, 1),
        NumberSequenceKeypoint.new(g + e, v),
        NumberSequenceKeypoint.new(x1 - e, v),
        NumberSequenceKeypoint.new(x1, 1),
        NumberSequenceKeypoint.new(1, 1),
    })
end

local function setStar(F, N)
    local sb = N.beam
    if not sb then return end
    local nE = #F.edges
    local lit = clamp((F.prog - N.first) * nE * 1.6, 0, 1)
    local tr = 1 - clamp(N.bright * ST.sty.glow * N.tw, 0, 1) * lit * clamp(F.vis, 0, 1)
    if N.tr == nil or abs(tr - N.tr) > 0.004 then
        N.tr = tr
        sb.Transparency = NumberSequence.new(tr)
    end
end

local function figureState(F, t)
    local age = t - F.born
    local vis = clamp(age / 0.9, 0, 1)
    if F.leaveAt then vis = vis * clamp(1 - (t - F.leaveAt) / F.fadeT, 0, 1) end
    local prog = F.drawT > 0 and clamp(age / F.drawT, 0, 1) or 1
    return vis, prog
end

local function applyF(F, vis, prog)
    local sv = ST.styVer
    local ck = colKey(F)
    if F.vis == vis and F.prog == prog and F.sv == sv and F.ck == ck then return 0 end
    local sty = ST.sty
    local restyle, recolor = F.sv ~= sv, F.ck ~= ck
    F.vis, F.prog, F.sv, F.ck = vis, prog, sv, ck
    local c1, c2
    if recolor then c1, c2 = tintOf(F) end
    local nE = #F.edges
    local a = clamp(0.92 * sty.glow, 0.05, 1) * vis
    for k, E in ipairs(F.edges) do
        local p = clamp(prog * nE - (k - 1), 0, 1)
        local b = E.beam
        if restyle then
            b.Width0, b.Width1 = sty.lineW, sty.lineW
            E.g = clamp(sty.gap / E.len, 0.02, 0.4)
            E.p = -1
        end
        if recolor then b.Color = ColorSequence.new(c1) end
        if E.p ~= p or E.al ~= a then
            E.p, E.al = p, a
            b.Transparency = lineSeq(E.g, p, a)
        end
    end
    for _, N in ipairs(F.nodes) do
        local sb = N.beam
        if sb then
            if restyle then
                local h = sty.starS * 0.5
                N.s0.Position = N.pos - N.ut * h
                N.s1.Position = N.pos + N.ut * h
                sb.Width0, sb.Width1 = sty.starS, sty.starS
            end
            if recolor then sb.Color = ColorSequence.new(c2) end
            setStar(F, N)
        end
    end
    return nE + (F.nodes[1] and F.nodes[1].beam and #F.nodes or 0)
end

local function leave(F, t, delay, fadeT)
    if F.leaveAt then return end
    F.leaveAt = t + (delay or 0)
    F.fadeT = fadeT or 1.8
end

local function leaveAll(t, spread)
    for _, F in ipairs(ST.figs) do leave(F, t, random() * (spread or 1), 1.4) end
end

local function destroyFigure(F)
    for _, o in ipairs(F.insts) do o:Destroy() end
    F.insts = {}
end

function M.step(t, dt)
    ST.frame = ST.frame + 1
    local cm = cam()
    local gv = Gov.wxMul or 1
    local want = cfg.constOn and gv > 0 and cm ~= nil
    local target = want and floor(clamp((cfg.constStars or 160) * gv, 0, 3000) + 0.5) or 0
    local c0 = clk()
    local budget = M.budget or 0.0035

    if #ST.figs == 0 and #ST.trash == 0 and target == 0 then
        if ST.dome then dropDome() end
        return
    end
    if not cm then return end
    if ST.dome and not ST.dome.Parent then
        ST.dome, ST.figs, ST.trash = nil, {}, {}
    end
    if not ST.dome then
        if target == 0 then return end
        ST.dome = makeDome()
    end
    local figs = ST.figs

    local cf = cm.CFrame
    local look = cf.LookVector
    if abs(look.Y) < 0.96 then ST.camAz = atan2(look.X, -look.Z) end
    ST.skyAz = (ST.skyAz + rad(0.7) * (cfg.constSpeed or 1) * dt) % TAU
    ST.dome.CFrame = CFrame.new(cf.Position) * CFrame.Angles(0, -ST.skyAz, 0)

    local R = cfg.constDist or 110
    local vp, fov = cm.ViewportSize, clamp(cm.FieldOfView, 5, 120)
    local ppr = (math.max(vp.Y, 100) * 0.5) / tan(rad(fov) * 0.5)
    local q = floor(math.log(ppr) / 0.04 + 0.5)
    local px = R / math.exp(q * 0.04)
    local ns = cfg.constNodeSize or 1
    local sty = ST.sty
    sty.glow = cfg.constGlow or 1
    sty.lineW = 1.6 * (cfg.constThick or 1) * px
    sty.starS = 12 * ns * px
    sty.gap = 12 * ns * px * 0.7 * (cfg.constGap or 1)
    local key = table.concat({ q, R, cfg.constThick or 1, ns, sty.glow, cfg.constGap or 1, cfg.constHue or 218, cfg.constSat or 0.28, tostring(cfg.constRainbow) }, "|")
    if key ~= ST.styKey then ST.styKey = key; ST.styVer = ST.styVer + 1 end

    local gkey = table.concat({ R, cfg.constSize or 1, tostring(cfg.constNodes ~= false) }, "|")
    if gkey ~= ST.geoKey then
        if ST.geoKey then ST.geoAt = t + 0.7 end
        ST.geoKey = gkey
    end
    if ST.geoAt and t >= ST.geoAt then ST.geoAt = nil; leaveAll(t, 1.2) end
    if ST.regen then ST.regen = false; leaveAll(t, 1.2) end

    local nStars = 0
    for i = 1, #figs do
        local F = figs[i]
        if not F.leaveAt then nStars = nStars + #F.nodes end
    end

    if target == 0 then
        if not ST.allLeft then ST.allLeft = true; leaveAll(t, 1.0) end
        nStars = 0
    else
        ST.allLeft = false
        if nStars > target * 1.1 + 4 then
            for i = 1, #figs do
                if nStars <= target * 1.1 + 4 then break end
                local F = figs[i]
                if not F.leaveAt then leave(F, t, random() * 1.2, 1.4); nStars = nStars - #F.nodes end
            end
        end
        ST.debt = math.min(ST.debt + math.max(14, target / 16) * dt, 30)
        local spawned = 0
        while ST.debt >= 1 and nStars < target and (spawned == 0 or clk() - c0 < budget) do
            ST.debt = ST.debt - 1
            local F = buildFigure(t)
            figs[#figs + 1] = F
            nStars = nStars + #F.nodes
            spawned = spawned + 1
        end
        if nStars >= target then ST.debt = math.min(ST.debt, 1) end
    end
    ST.nStars = nStars

    local follow = cfg.constFollow ~= false
    local cone = rad(clamp(cfg.constCone or 80, 10, 180))
    local forever = cfg.constForever == true
    local life = cfg.constLife or 40
    local lo, hi = rad(cfg.constMinElev or 6) - rad(2), rad(cfg.constMaxElev or 70) + rad(2)
    local nF = #figs
    if nF > 0 then
        for n = 1, math.min(nF, 10) do
            ST.rc = ST.rc % nF + 1
            local F = figs[ST.rc]
            if not F.leaveAt and t - F.born > 5 then
                if not forever and t - F.born > life * F.lm then
                    leave(F, t, 0)
                elseif follow and cone < rad(179) then
                    local d = abs((F.laz + ST.skyAz - ST.camAz + pi) % TAU - pi)
                    if d > cone + rad(24) + F.ang then leave(F, t, 0, 1.4) end
                end
                if not F.leaveAt and (F.el < lo or F.el > hi) then leave(F, t, 0, 1.4) end
            end
        end
    end

    local ub = M.updates or 700
    local stopped
    local gone = 0
    nF = #figs
    for n = 0, nF - 1 do
        local F = figs[(ST.cur + n) % nF + 1]
        local vis, prog = figureState(F, t)
        local active = prog < 1 or vis < 1 or F.leaveAt ~= nil
        if F.leaveAt and t - F.leaveAt >= F.fadeT then
            F.gone = true
            gone = gone + 1
        elseif active or ub > 0 then
            ub = ub - applyF(F, vis, prog)
        elseif not stopped then
            stopped = n
        end
    end
    if nF > 0 then ST.cur = (ST.cur + (stopped or 0)) % nF end
    if gone > 0 then
        local nf, k = {}, 0
        for _, F in ipairs(figs) do
            if F.gone then ST.trash[#ST.trash + 1] = F else k = k + 1; nf[k] = F end
        end
        ST.figs = nf
        figs = nf
        ST.cur = 0
    end

    if nStars <= 300 and cfg.constNodes ~= false then
        for i = 1, #figs do
            local F = figs[i]
            if (F.id + ST.frame) % 6 == 0 and F.vis > 0 then
                for k, N in ipairs(F.nodes) do
                    N.tw = 0.78 + 0.22 * sin(t * (1.6 + (k % 3) * 0.5) + N.ph)
                    setStar(F, N)
                end
            end
        end
    end

    local tr = ST.trash
    local done = 0
    while #tr > 0 and (done == 0 or clk() - c0 < budget) do
        destroyFigure(tr[#tr])
        tr[#tr] = nil
        done = done + 1
    end
    if target == 0 and #figs == 0 and #tr == 0 then dropDome() end
end

function M.regenerate() ST.regen = true end

function M.stats()
    local alive, leaving, stars, nodes, beams, sbeams = 0, 0, 0, 0, 0, 0
    local function count(F)
        nodes = nodes + #F.nodes
        beams = beams + #F.edges
        for _, N in ipairs(F.nodes) do if N.beam then sbeams = sbeams + 1 end end
    end
    for _, F in ipairs(ST.figs) do
        if F.leaveAt then leaving = leaving + 1 else alive = alive + 1; stars = stars + #F.nodes end
        count(F)
    end
    for _, F in ipairs(ST.trash) do if #F.insts > 0 then count(F) end end
    return { slots = #ST.figs, alive = alive, leaving = leaving, stars = stars, nodes = nodes, beams = beams, starBeams = sbeams, trash = #ST.trash }
end

function M.cleanup()
    dropDome()
    ST.styKey, ST.geoKey, ST.geoAt, ST.regen, ST.allLeft, ST.debt, ST.cur, ST.rc = nil, nil, nil, false, false, 0, 0, 0
end

return M
end)()
MISC.CHAR = (function()

