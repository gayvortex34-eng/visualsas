local function tailChain(b, o)
    local piv = b.pivot({ at = "torso", cf = CF(0, -b.th * 0.78, b.td + 0.05) * ANG(rad(-(o.rise or 30)), 0, 0) })
    local prev = piv
    for i = 1, o.n do
        local f = (i - 1) / (o.n - 1)
        local seg = b.pivot({ of = prev, cf = CF(0, 0, (i == 1) and 0 or o.len), anim = function(t, st)
            local sp = min(st.speed or 0, 22)
            return ANG(-(o.curl or 0.1) * (1 + sp / 30), 0, 0) * ANG(0, (o.wag or 0.2) * sin(t * (1.6 + sp / 14) - i * 0.5), 0)
        end })
        local d = o.d[i] or o.d[#o.d]
        local col = (o.tip and i > o.n - o.tip) and "w" or "a"
        local made = false
        if b.mesh then
            local dn = o.d[i + 1] or d * 0.4
            if i == o.n then dn = d * 0.3 end
            local c0 = o.cyl or col
            local id = H.tube(b, { of = seg, pts = { V3(0, 0, 0), V3(0, 0, o.len * 0.5), V3(0, 0, o.len * 1.0) }, r0 = d / 2, r1 = dn / 2, sides = 14, seg = 2, col = c0, mat = o.cyl and "m" or "c" })
            if id then
                H.orb(b, { of = seg, d = d, col = c0, mat = o.cyl and "m" or "c" })
                if i == o.n then H.orb(b, { of = seg, cf = CF(0, 0, o.len), d = dn * 1.05, col = c0, mat = o.cyl and "m" or "c" }) end
                made = true
            end
        end
        if made then
        elseif o.cyl then
            b.P({ of = seg, cf = CF(0, 0, o.len / 2) * ANG(0, PI / 2, 0), shape = "c", size = V3(o.len * 1.05, d, d), col = o.cyl, mat = "m" })
            b.P({ of = seg, cf = CF(0, 0, o.len), shape = "s", size = V3(d, d, d), col = o.cyl, mat = "m" })
        else
            b.P({ of = seg, cf = CF(0, 0, o.len / 2), shape = "s", size = V3(d, d, o.len * 1.25), col = col, mat = "c" })
        end
        prev = seg
    end
    return prev
end

