function S.orbAt(ops, g, x, y, d, yy) ops[#ops + 1] = { k = "orb", g = g, s = d, p = { x, yy or 0, y } } end
function S.gemAt(ops, g, x, y, len, w, yy, sides) ops[#ops + 1] = { k = "crystal", g = g, f = 0.5, sides = sides or 4, s = { len, w, w }, r = { 0, 0, 90 }, p = { x, (yy or 0) + len / 2, y } } end
function S.ngon(n, R, a0)
