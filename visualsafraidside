local function boltPoints(a, b, segs, jit)
    local pts = { a }
    local dir = b - a
    local len = dir.Magnitude
    if len < 0.05 then return { a, b } end
    local fwd = dir.Unit
    local ref = (math.abs(fwd.Y) > 0.95) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
    local r = fwd:Cross(ref).Unit
    local u = fwd:Cross(r)
    for i = 1, segs - 1 do
        local f = i / segs
        local taper = 1 - math.abs(2 * f - 1) ^ 3
        local off = r * (rnd(-1, 1) * jit * taper) + u * (rnd(-1, 1) * jit * taper)
        pts[#pts + 1] = a + dir * f + off
    end
    pts[#pts + 1] = b
    return pts
end

function M.bolt(from, to, o)
    o = o or {}
    local par = terrainInst()
    local col = o.color or Color3.fromRGB(200, 215, 255)
    local width = o.width or 0.6
    local segs = o.segs or 9
    local jit = o.jit or (to - from).Magnitude * 0.07
    local life = o.life or 0.45
    local items, beams = {}, {}
    local dead = false
    local function chain(points, w, tr, c)
        local atts = {}
        for i, p in ipairs(points) do
            local at = Instance.new("Attachment")
            at.Name = TAG .. "wa"
            at.Parent = par
            at.WorldPosition = p
            atts[i] = at
            items[#items + 1] = at
        end
        for i = 1, #atts - 1 do
            local bm = Instance.new("Beam")
            bm.Name = TAG .. "bm"
            bm.Attachment0, bm.Attachment1 = atts[i], atts[i + 1]
            bm.Width0 = w * (1 - 0.5 * (i - 1) / #atts)
            bm.Width1 = w * (1 - 0.5 * i / #atts)
            bm.FaceCamera = true
            bm.Segments = 1
            bm.LightEmission = 1
            bm.LightInfluence = 0
            bm.Color = ColorSequence.new(c)
            bm.Transparency = NumberSequence.new(tr)
            bm.Parent = fxFolder()
            items[#items + 1] = bm
            beams[#beams + 1] = { bm = bm, base = tr }
        end
    end
    local pts = boltPoints(from, to, segs, jit)
    chain(pts, width * 3.4, 0.72, col)
    chain(pts, width, 0.05, col:Lerp(Color3.new(1, 1, 1), 0.7))
    local nb = (o.branches == nil) and 2 or o.branches
    for _ = 1, nb do
        local k = math.random(2, math.max(2, #pts - 2))
        local p0 = pts[k]
        local d = (to - from)
        local side = Vector3.new(rnd(-1, 1), rnd(-0.2, 0.3), rnd(-1, 1))
        local tip = p0 + d.Unit * (d.Magnitude * 0.12) + side.Unit * (d.Magnitude * rnd(0.1, 0.22))
        local bp = boltPoints(p0, tip, 5, jit * 0.5)
        chain(bp, width * 1.1, 0.35, col)
    end
    local h = { destroy = function() end }
    local function kill()
        if dead then return end
        dead = true
        for _, i in ipairs(items) do pcall(function() i:Destroy() end) end
        items, beams = {}, {}
    end
    h.destroy = kill
    liveBolts[h] = true
    task.spawn(function()
        local function vis(v) for _, b in ipairs(beams) do pcall(function() b.bm.Enabled = v end) end end
        task.wait(0.05); if dead then liveBolts[h] = nil return end
