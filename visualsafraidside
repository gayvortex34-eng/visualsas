function G:vtx(x, y, z, u, v)
    local n = self.n + 1
    self.n = n
    self.x[n], self.y[n], self.z[n], self.u[n], self.v[n] = x, y, z, u or 0, v or 0
    return n
end

function G:tri(a, b, c)
    local f, nf = self.f, self.nf
    f[nf + 1], f[nf + 2], f[nf + 3] = a, b, c
    self.nf = nf + 3
end

function G:quad(a, b, c, d)
    self:tri(a, b, c)
    self:tri(a, c, d)
end

function G:grid(nu, nv, fn, wrapU, flip)
    local cols = wrapU and nu or nu + 1
    local base = self.n
    for j = 0, nv do
        for i = 0, cols - 1 do
            local x, y, z = fn(i / nu, j / nv)
            self:vtx(x, y, z, i / nu, j / nv)
        end
    end
    for j = 0, nv - 1 do
        for i = 0, nu - 1 do
            local a = base + j * cols + (i % cols) + 1
            local b = base + j * cols + ((i + 1) % cols) + 1
            local c = base + (j + 1) * cols + ((i + 1) % cols) + 1
            local d = base + (j + 1) * cols + (i % cols) + 1
            if flip then self:quad(a, d, c, b) else self:quad(a, b, c, d) end
        end
    end
end

function G:flat(p1, p2, p3, cx, cy, cz)
    local ux, uy, uz = p2[1] - p1[1], p2[2] - p1[2], p2[3] - p1[3]
    local vx, vy, vz = p3[1] - p1[1], p3[2] - p1[2], p3[3] - p1[3]
    local nx, ny, nz = uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx
    if cx then
        local mx, my, mz = (p1[1] + p2[1] + p3[1]) / 3 - cx, (p1[2] + p2[2] + p3[2]) / 3 - cy, (p1[3] + p2[3] + p3[3]) / 3 - cz
        if nx * mx + ny * my + nz * mz < 0 then p2, p3 = p3, p2 end
    end
    local a = self:vtx(p1[1], p1[2], p1[3])
    local b = self:vtx(p2[1], p2[2], p2[3])
    local c = self:vtx(p3[1], p3[2], p3[3])
    self:tri(a, b, c)
end

function G:add(o, fn, mirror)
