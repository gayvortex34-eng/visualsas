local function gmul() return Gov.fxMul or 1 end

local GRD = { params = nil, ig = {}, nextIg = 0 }
local GRD_UP = Vector3.new(0, 1, 0)
local function grdBase()
    local now = os.clock()
    if not GRD.params then
        GRD.params = RaycastParams.new()
        GRD.params.FilterType = Enum.RaycastFilterType.Exclude
    end
    if now >= GRD.nextIg then
        GRD.nextIg = now + 0.5
        local ig = { fxFolder(), cam() }
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then ig[#ig + 1] = p.Character end end
        GRD.ig = ig
    end
    return GRD.params
end

local function grdCast(origin, len)
    local params = grdBase()
    local extra
    for _ = 1, 5 do
        if extra then
            local m = {}
            for i, v in ipairs(GRD.ig) do m[i] = v end
            for _, v in ipairs(extra) do m[#m + 1] = v end
            params.FilterDescendantsInstances = m
        else
            params.FilterDescendantsInstances = GRD.ig
        end
        local ok, res = pcall(function() return Workspace:Raycast(origin, Vector3.new(0, -len, 0), params) end)
        if not ok or not res then return nil end
        local inst = res.Instance
        local skip
        if inst.ClassName ~= "Terrain" then
            if inst.CanCollide == false then
                skip = inst
            else
                local mdl = inst:FindFirstAncestorOfClass("Model")
                if mdl and mdl:FindFirstChildOfClass("Humanoid") then skip = mdl end
            end
        end
        if not skip then return res end
        extra = extra or {}
        extra[#extra + 1] = skip
    end
end

function FX.groundFit(origin, radius)
    local c = grdCast(origin + Vector3.new(0, 2.5, 0), 70)
    if not c then return nil end
    local sumY, n, cnt = c.Position.Y, c.Normal, 1
    if radius and radius > 0.9 then
        local r = math.min(radius, 10) * 0.6
        for _, d in ipairs({ Vector3.new(r, 0, 0), Vector3.new(-r, 0, 0), Vector3.new(0, 0, r), Vector3.new(0, 0, -r) }) do
            local h = grdCast(origin + d + Vector3.new(0, 2.5, 0), 70)
            if h and math.abs(h.Position.Y - c.Position.Y) < 3.5 then
                sumY = sumY + h.Position.Y
                n = n + h.Normal
                cnt = cnt + 1
            end
        end
    end
    local avg = sumY / cnt
    local y = c.Position.Y + math.max(0, avg - c.Position.Y) * 0.35
    if n.Magnitude < 0.01 then n = GRD_UP else n = n.Unit end
    if n.Y < 0.707 then
        local hz = Vector3.new(n.X, 0, n.Z)
        n = (hz.Magnitude > 0.01) and (hz.Unit * 0.7071 + GRD_UP * 0.7071) or GRD_UP
    end
    return Vector3.new(origin.X, y, origin.Z), n
end

function FX.groundCF(pos, n, fwd)
    local look = fwd - n * fwd:Dot(n)
    if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) - n * n.Z * -1 end
    if look.Magnitude < 0.05 then look = Vector3.new(1, 0, 0) end
    local zv = -look.Unit
    local xv = n:Cross(zv)
    return CFrame.fromMatrix(pos, xv, n, zv)
end

function FX.groundTracker(radius)
    local T = { radius = radius or 0, pos = nil, nrm = GRD_UP, tp = nil, tn = GRD_UP, nextRay = 0 }
    function T.update(feet, dt, now, rad)
        if now >= T.nextRay then
            T.nextRay = now + 0.05
            T.tp, T.tn = FX.groundFit(feet, rad or T.radius)
        end
        local target, tnorm
        local tp = T.tp
        if cfg.fxGround == false or not tp or feet.Y - tp.Y > 26 then
            target, tnorm = feet, GRD_UP
        else
            target, tnorm = Vector3.new(feet.X, tp.Y, feet.Z), T.tn
        end
        if not T.pos then
            T.pos, T.nrm = target, tnorm
        else
            local ky, kn = damp(cfg.fxGroundSmooth or 13, dt), damp(9, dt)
            T.pos = Vector3.new(target.X, T.pos.Y + (target.Y - T.pos.Y) * ky, target.Z)
            local nn = T.nrm + (tnorm - T.nrm) * kn
            T.nrm = (nn.Magnitude > 0.01) and nn.Unit or GRD_UP
        end
        return T.pos, T.nrm
    end
    return T
end

