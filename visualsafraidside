        p.Name = name; p.Size = size; p.CFrame = CF(pos); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
        p.Color = col; p.Material = Enum.Material.SmoothPlastic
        p.Parent = m
        return p
    end
    local hrp = P("HumanoidRootPart", V3(2, 2, 1), V3(0, -1, 0), skin)
    hrp.Transparency = 1
    P("UpperTorso", V3(2, 1.6, 1), V3(0, 0, 0), shirt)
    P("LowerTorso", V3(2, 0.4, 1), V3(0, -1, 0), pants)
    P("Head", V3(1.2, 1.2, 1.2), V3(0, 1.4, 0), skin)
    for _, s in ipairs({ { "Left", -1 }, { "Right", 1 } }) do
