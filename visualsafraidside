local function batWing3(b, side, o)
    local k = o.k
    local A, B = rig(b, side, o)
    local E, W, Ba = o.E * k, o.W * k, o.Ba * k
    local ka, kam = MESH.batArm({ E = arr(E), W = arr(W), Ba = arr(Ba), k = k, zs = side, r0 = o.r0 or 0.15, r1 = o.r1 or 0.1, rn = o.rn or 0, ra = o.ra or 0, rip = o.rip or 0.02 })
    if not (MESH.ensure(ka) and MESH.ensure(kam)) then return nil end
    local R = 4 * k
    H.mesh(b, { of = B, mesh = ka, sx = 1, bound = bound(R * 2), col = o.bone or "k", mat = o.boneMat or "p" })
    H.mesh(b, { of = B, mesh = kam, sx = 1, bound = bound(R * 2), col = o.cA or "a", mat = o.memMat or "s" })
    local P = wristPivot(b, B, W, o)
    local n = #o.tips
    local tips = {}
    for i, t in ipairs(o.tips) do tips[i] = t * k - W end
    local relBa = Ba - W
    for i = 1, n do
        local tp = tips[i]
        local nx = tips[i + 1] or relBa
        local dx, dy = tp.X, tp.Y
        local l = math.sqrt(dx * dx + dy * dy) + 1e-9
        local bf = (o.bow or 0.07) * l
        local bw = V3(-dy / l * bf, dx / l * bf, 0)
        local bw2 = { 0, 0, 0 }
        if tips[i + 1] then
            local ex, ey = tips[i + 1].X, tips[i + 1].Y
            local l2 = math.sqrt(ex * ex + ey * ey) + 1e-9
            local bf2 = (o.bow or 0.07) * l2
            bw2 = { -ey / l2 * bf2, ex / l2 * bf2, 0 }
        end
        local fk, fm = MESH.fan({ T = arr(tp), T2 = arr(nx), bw = arr(bw), bw2 = bw2, k = k, zs = side, rb = o.rb or 0.085, rt = o.rt or 0.024, inset = o.inset or 0.6,
            sag = o.sag or 0.2, rip = o.rip or 0.02, lift = (i - 1) * 0.014 })
        if MESH.ensure(fk) and MESH.ensure(fm) then
            local f = (n - i) / math.max(1, n - 1)
            local piv = b.pivot({ of = P, anim = function(t, st)
                local w = wingState(st, t)
                local c = 1 - w.sp
                local lag = 0.5 * (w.A / 0.46) * (Fl(w.ph - 0.6 - 0.12 * (n - i)) - Fl(w.ph)) * (0.4 + 0.6 * f)
                return ANG(0, 0, -c * (o.fold or 0.9) * f + lag + 0.02 * sin(t * 1.1 + i + (o.ph or 0)))
            end })
            local R2 = (tp.Magnitude + 1) * 1.0
            H.mesh(b, { of = piv, mesh = fk, sx = 1, bound = bound(R2 * 2), col = o.bone or "k", mat = o.boneMat or "p" })
            H.mesh(b, { of = piv, mesh = fm, sx = 1, bound = bound(R2 * 2), col = (i % 2 == 1) and (o.cA or "a") or (o.cB or "e"), mat = o.memMat or "s" })
        end
    end
    return A
end

