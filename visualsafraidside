function Sec:BindList()
    self.n = self.n + 1
    local f = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = self.n }, self.body)
    vlist(f, 3)
    local function rebuild()
        for _, c in ipairs(f:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        local rows = {}
        for _, c in ipairs(UIX.bindCtls) do
            local b = bindOf(c.key)
            if b then rows[#rows + 1] = { c = c, b = b } end
        end
        table.sort(rows, function(a, b) return (a.c.where .. a.c.text) < (b.c.where .. b.c.text) end)
        local rowH = 32
        if #rows == 0 then
            local l = label(f, "No binds yet. Click the name of any switch and press a key.", 11, "dim", F.reg, XL)
            l.Size = UDim2.new(1, 0, 0, 34); l.TextWrapped = true; l.LayoutOrder = 1
            f.Size = UDim2.new(1, 0, 0, 40)
            return
        end
        f.Size = UDim2.new(1, 0, 0, #rows * (rowH + 3))
        for i, r in ipairs(rows) do
            local row = new("Frame", { Size = UDim2.new(1, 0, 0, rowH), BackgroundTransparency = 0.55, BorderSizePixel = 0, LayoutOrder = i }, f)
            bindTheme(row, "BackgroundColor3", "panel2"); corner(row, 8)
            local nm = label(row, r.c.text, 12, "text", F.med, XL)
            nm.Size = UDim2.new(1, -118, 0, 16); nm.Position = UDim2.fromOffset(8, 3); nm.TextTruncate = Enum.TextTruncate.AtEnd
            local wh = label(row, r.c.where, 9, "dim", F.reg, XL)
            wh.Size = UDim2.new(1, -118, 0, 12); wh.Position = UDim2.fromOffset(8, 18); wh.TextTruncate = Enum.TextTruncate.AtEnd
            local kb = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(74, 22), Position = UDim2.new(1, -32, 0.5, 0), BackgroundTransparency = 0.82,
                Text = UIX.keyLabel(r.b.k) .. (r.b.m == "Hold" and "  hold" or ""), TextSize = 11, Font = F.bold, AutoButtonColor = false, BorderSizePixel = 0 }, row)
            corner(kb, 6); bindTheme(kb, "BackgroundColor3", "acc"); bindTheme(kb, "TextColor3", "acc")
            kb.Activated:Connect(function() openBind(r.c) end)
            local x = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -6, 0.5, 0), BackgroundTransparency = 1, Text = "x",
                TextSize = 13, Font = F.bold, AutoButtonColor = false, BorderSizePixel = 0 }, row)
            bindTheme(x, "TextColor3", "dim")
            x.Activated:Connect(function()
                cfg.binds[r.c.key] = nil
                UIX.refreshBinds()
            end)
        end
    end
    UIX.onBinds = rebuild
    UIX._bindList = f
    rebuild()
    return f
end

function Sec:ThemeGrid()
    self.n = self.n + 1
    local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = self.n, BorderSizePixel = 0 }, self.body)
    new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 70), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
    local cards = {}
    local ctl = { kind = "themes", frame = holder }
    Flags.theme = ctl
    local function paintAll(snap)
        for name, c in pairs(cards) do
            local on = (C("theme") == name)
            local props = { Thickness = on and 2.5 or 1.5, Color = on and T.acc or c.th.line }
            if snap == true then for k, v in pairs(props) do c.st[k] = v end else tw(c.st, TI.med, props) end
            local tk = { BackgroundTransparency = on and 0 or 1 }
            if snap == true then c.tick.BackgroundTransparency = tk.BackgroundTransparency else tw(c.tick, TI.back, tk) end
            c.tickIn.Visible = on
        end
    end
    reg(paintAll)
    function ctl:Set(v, silent)
        if not UIX.THEMES[v] then return end
        cfg.theme = v
        paintAll()
        if not silent then mark("ui") end
    end
    for i, name in ipairs(UIX.THEME_ORDER) do
        local th = UIX.THEMES[name]
        local card = new("TextButton", { BackgroundColor3 = th.bg, Text = "", AutoButtonColor = false, LayoutOrder = i, BorderSizePixel = 0, ClipsDescendants = true }, holder)
        corner(card, 11)
        local cst = stroke(card, th.line, 1.5, 0)
        local strip = new("Frame", { Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, card)
        corner(strip, 8)
        new("UIGradient", { Color = ColorSequence.new({ CK(0, th.acc), CK(0.5, th.acc2), CK(1, th.acc3) }) }, strip)
        local sheen = new("Frame", { Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, BorderSizePixel = 0 }, strip)
        corner(sheen, 8)
        local tick = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0 }, strip)
        corner(tick, 8)
        local tickIn = new("Frame", { Size = UDim2.fromOffset(6, 6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = th.acc, BorderSizePixel = 0, Visible = false }, tick)
        corner(tickIn, 3)
        local nm = new("TextLabel", { BackgroundTransparency = 1, Text = name, TextSize = 12, Font = F.bold, TextXAlignment = XL, TextColor3 = th.text,
            Position = UDim2.fromOffset(10, 41), Size = UDim2.new(1, -20, 0, 14), BorderSizePixel = 0 }, card)
        local nt = new("TextLabel", { BackgroundTransparency = 1, Text = th.note or "", TextSize = 10, Font = F.reg, TextXAlignment = XL, TextColor3 = th.dim,
            Position = UDim2.fromOffset(10, 54), Size = UDim2.new(1, -20, 0, 12), BorderSizePixel = 0, TextTruncate = Enum.TextTruncate.AtEnd }, card)
        cards[name] = { th = th, st = cst, tick = tick, tickIn = tickIn }
        card.MouseEnter:Connect(function() if C("theme") ~= name then tw(cst, TI.fast, { Color = th.acc }) end end)
        card.MouseLeave:Connect(function() if C("theme") ~= name then tw(cst, TI.fast, { Color = th.line }) end end)
        card.InputBegan:Connect(function(inp)
            if isPress(inp) then
                UIX.inkOrigin = { x = inp.Position.X, y = inp.Position.Y, t = os.clock() }
                UIX.ripple(card, inp.Position, "acc")
            end
        end)
        card.Activated:Connect(function()
            if cfg.theme ~= name then ctl:Set(name) end
        end)
    end
    paintAll(true)
    UIX.indexCtl(self, "Menu theme", holder)
    return ctl
end
end
do

local new, corner, stroke, WHITE = UIX.new, UIX.corner, UIX.stroke, UIX.WHITE
local shell = UIX.shell
local mrand, msqrt, mcos, msin, mmax, mmin, mpi = math.random, math.sqrt, math.cos, math.sin, math.max, math.min, math.pi

local TL = { hit = 0.26, wA = 0.62, wB = 0.8, fadeA = 0.82 }
UIX.INK_TL = TL
local BLOOM_U0 = 0.248

local inkClip = new("Frame", { Name = "inkClip", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20, ClipsDescendants = true, Active = false }, shell)
local inkOver = new("Frame", { Name = "inkOver", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 21, Active = false }, shell)
UIX.inkClip, UIX.inkOver = inkClip, inkOver

local function prog(u, a, b) return clamp((u - a) / (b - a), 0, 1) end
local function outQ(p) local v = 1 - p; return 1 - v * v * v * v end
local function outC(p) local v = 1 - p; return 1 - v * v * v end
local function outS(p) return msin(p * mpi / 2) end
local function inQ(p) return p * p end
local function rr(a, b) return a + (b - a) * mrand() end
local EASE = { outQ, outC, outS }

function UIX.inkNew(o)
    local W, H, ox, oy, pal = o.W, o.H, o.ox, o.oy, o.pal
    local R = msqrt(mmax(ox, W - ox) ^ 2 + mmax(oy, H - oy) ^ 2) * 1.03
    local hit = TL.hit
    local drop = o.drop ~= false
    local u0 = drop and 0 or BLOOM_U0
    local r0 = drop and 7 or 3
    local b0 = drop and 0.045 or 0.004
    local upd, objs = {}, {}
    local RW = 3.2
    local rims = { pal.acc, pal.acc2, pal.acc3 or pal.acc }
    local function disc(parent, col, z, tr)
        local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(ox, oy), Size = UDim2.fromOffset(0, 0), BackgroundColor3 = col,
            BackgroundTransparency = tr or 0, BorderSizePixel = 0, ZIndex = z, Active = false, Visible = false }, parent)
        corner(f, UDim.new(1, 0))
        objs[#objs + 1] = f
        return f
    end
    local function hide(...)
        for _, f in ipairs({ ... }) do if f.Visible then f.Visible = false end end
    end

    local function addLobe(cx, cy, r0, r, a, b, ex, rimCol)
        local fill = disc(inkClip, pal.bg, 3, 0)
        local rim = disc(inkClip, rimCol, 2, 0.12)
        fill.Position = UDim2.fromOffset(cx, cy)
        rim.Position = UDim2.fromOffset(cx, cy)
        upd[#upd + 1] = function(u, ft)
            if u < a then hide(fill, rim); return end
            local rad = r0 + (r - r0) * ex(prog(u, a, b))
            fill.Visible = true; rim.Visible = true
            fill.Size = UDim2.fromOffset(rad * 2, rad * 2)
            rim.Size = UDim2.fromOffset(rad * 2 + RW * 2, rad * 2 + RW * 2)
            fill.BackgroundTransparency = ft
            rim.BackgroundTransparency = 0.12 + 0.88 * ft
        end
    end

    local function rodPair(ang, rimCol)
        local ca, sa = mcos(ang), msin(ang)
        local rot = ang * 180 / mpi
        local function rod(col, z)
            local f = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(ox, oy), Size = UDim2.fromOffset(0, 10), BackgroundColor3 = col,
                BorderSizePixel = 0, ZIndex = z, Active = false, Visible = false, Rotation = rot }, inkClip)
            corner(f, UDim.new(1, 0))
            objs[#objs + 1] = f
            return f
        end
        local fill, rim = rod(pal.bg, 3), rod(rimCol, 2)
        rim.Position = UDim2.fromOffset(ox - ca * RW, oy - sa * RW)
        return fill, rim, ca, sa
    end

    local ph = { rr(0, mpi * 2), rr(0, mpi * 2), rr(0, mpi * 2), rr(0, mpi * 2), rr(0, mpi * 2) }
    local N = 30
    local function addSpoke(ang, Rm, a, b, rimCol)
        local fill, rim, ca, sa = rodPair(ang, rimCol)
        upd[#upd + 1] = function(u, ft)
            if u < a then hide(fill, rim); return end
            local p = prog(u, a, b)
            local r = r0 + (Rm - r0) * (1 - (1 - p) ^ 2.4)
            local w = clamp(mpi * 2 * r / N * 1.32, 9, 200)
            fill.Visible = true; rim.Visible = true
            fill.Size = UDim2.fromOffset(r + w * 0.5, w)
            rim.Size = UDim2.fromOffset(r + w * 0.5 + RW * 2, w + RW * 2)
            fill.BackgroundTransparency = ft
            rim.BackgroundTransparency = 0.12 + 0.88 * ft
        end
    end
    local function addFinger(ang, Lm, w, a, b, rimCol)
        local fill, rim, ca, sa = rodPair(ang, rimCol)
        local bf, br = disc(inkClip, pal.bg, 3, 0), disc(inkClip, rimCol, 2, 0.12)
        upd[#upd + 1] = function(u, ft)
            if u < a then hide(fill, rim, bf, br); return end
            local p = prog(u, a, b)
            local L = r0 + (Lm - r0) * outQ(p)
            local ww = w * (1 - 0.25 * p)
            local bd = ww * 1.9
            fill.Visible = true; rim.Visible = true; bf.Visible = true; br.Visible = true
            fill.Size = UDim2.fromOffset(L + ww * 0.5, ww)
            rim.Size = UDim2.fromOffset(L + ww * 0.5 + RW * 2, ww + RW * 2)
            bf.Size = UDim2.fromOffset(bd, bd)
            br.Size = UDim2.fromOffset(bd + RW * 2, bd + RW * 2)
            bf.Position = UDim2.fromOffset(ox + ca * L, oy + sa * L)
            br.Position = bf.Position
            fill.BackgroundTransparency = ft
            bf.BackgroundTransparency = ft
            rim.BackgroundTransparency = 0.12 + 0.88 * ft
            br.BackgroundTransparency = 0.12 + 0.88 * ft
        end
    end

    local function addDroplet(ang, dist, size, a, b, col)
        local ca, sa = mcos(ang), msin(ang)
        local f = disc(inkOver, col, 6, 0.05)
        local grav = dist * (drop and 0.5 or 0.1)
        upd[#upd + 1] = function(u)
            local p = prog(u, a, b)
            if u < a or p >= 1 then hide(f); return end
            local d = dist * outC(p)
            local s = size * (1 - 0.75 * p * p)
            f.Visible = true
            f.Size = UDim2.fromOffset(s, s)
            f.Position = UDim2.fromOffset(ox + ca * d, oy + sa * d + grav * p * p)
            f.BackgroundTransparency = 0.05 + 0.95 * prog(p, 0.65, 1)
        end
    end

    local tx = Assets.tex
    if tx.splat1 and tx.splat2 and tx.splat3 then
        local Hf = R / 0.4 * 1.12
        local names = { "splat1", "splat2", "splat3" }
        for i = 3, 2, -1 do local j = mrand(1, i); names[i], names[j] = names[j], names[i] end
        local LY = {
            { m = 1.0, a = hit, span = 0.5, asp = rr(0.12, 0.28) },
            { m = 0.97, a = hit + 0.02, span = 0.52, asp = -rr(0.1, 0.24) },
            { m = 0.86, a = hit + 0.008, span = 0.42, asp = rr(-0.1, 0.1) },
        }
        for i, L in ipairs(LY) do
            local nm = names[i]
            local function img(col, z, tr)
                local f = new("ImageLabel", { Name = nm, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(ox, oy), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1,
                    Image = "", ImageColor3 = col, ImageTransparency = tr, ZIndex = z, BorderSizePixel = 0, Active = false, Visible = false }, inkClip)
                Assets.watchTex(f, nm)
                objs[#objs + 1] = f
                return f
            end
            local fill, rim = img(pal.bg, 3, 0), img(rims[i], 2, 0.12)
            local rot, dr = rr(0, 360), rr(-16, 16)
            local full = Hf * L.m
            upd[#upd + 1] = function(u, ft)
                if u < L.a then hide(fill, rim); return end
                local p = prog(u, L.a, L.a + L.span)
                local q = prog(p, 0, 0.3)
                local e = 0.28 * q * q * (3 - 2 * q) + 0.72 * prog(p, 0.26, 1) ^ 1.25
                local half = full * (b0 + (1 - b0) * e)
                local hx, hy = half * (1 + L.asp * (1 - e)), half * (1 - L.asp * 0.7 * (1 - e))
                fill.Visible = true; rim.Visible = true
                fill.Size = UDim2.fromOffset(hx * 2, hy * 2)
                rim.Size = UDim2.fromOffset(hx * 2 + 15, hy * 2 + 15)
                local rt = rot + dr * p
                fill.Rotation = rt; rim.Rotation = rt
                fill.ImageTransparency = ft
                rim.ImageTransparency = 0.12 + 0.88 * ft
            end
        end
    else
        local function smooth(p) return p * p * (3 - 2 * p) end
        for j = 1, N do
            local th = (j - 1 + rr(-0.3, 0.3)) / N * mpi * 2
