local function dot3(a, c) return a[1] * c[1] + a[2] * c[2] + a[3] * c[3] end
local function add3(a, c, k) return { a[1] + c[1] * (k or 1), a[2] + c[2] * (k or 1), a[3] + c[3] * (k or 1) } end
local function mul3(a, k) return { a[1] * k, a[2] * k, a[3] * k } end
local function frame(z, xh)
    local Z = unit3(z)
    local X = unit3(add3(xh, Z, -dot3(xh, Z)))
    return { X, cross3(Z, X), Z }
end
